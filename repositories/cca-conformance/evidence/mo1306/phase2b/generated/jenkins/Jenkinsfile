pipeline {
  agent {
    label 'windows_2022'
  }
  options {
    skipDefaultCheckout()
    timeout(time: 5, unit: 'MINUTES')
  }
  stages {
    stage('MemoryOS Policy') {
      steps {
        checkout scm
        powershell(encoding: 'UTF-8', script: '''
$status = 16
try {
  & (Join-Path $env:MEMORYOS_CI_HOME 'scripts/Invoke-MemoryOSCI.ps1') -Provider 'jenkins' -Workspace $env:WORKSPACE -ConfigurationDigest 'sha256:12ddefe6af24e3364dfee0c081ad4a41061bcf8aa4804716bb6ee65aa5483afb' -DistributionDigest 'sha256:816852914f943bee7465e7d8fd0bce754f885c78777738666810dc0ec748709e'
  $status = $LASTEXITCODE
} finally {
  exit $status
}
''')
      }
    }
  }
}
