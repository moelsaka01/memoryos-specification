'''
def catalog():
 rows=[]
 for line in TEXT.strip().splitlines():
  ident,sections,decisions,cats,state,description,evidence=line.split('|')
  rows.append({'id':ident,'freezeSections':[int(x) for x in sections.split(',')],'decisions':decisions.split(','),'categories':['CF-'+x for x in cats.split(',')],'status':state,'requirement':description,'evidenceKeys':evidence.split(',')})
 assert len({r['id'] for r in rows})==len(rows)
 assert {s for r in rows for s in r['freezeSections']}==set(range(1,27))
 assert {x for r in rows for x in r['decisions']}==set([chr(65+i) for i in range(26)]+['AA','AB','AC','AD','AE','AF'])
 assert all(r['status'] in STATES for r in rows)
 return rows
