import sys
sys.dont_write_bytecode=True
import argparse,datetime,hashlib,json,zipfile
from pathlib import Path
ROOT=Path(r'C:\Users\melsa\Documents\Codex\cca-mo1306-3a-refresh')
def binding(p):
 p=Path(p).resolve();b=p.read_bytes();return {'path':p.relative_to(ROOT).as_posix(),'byteLength':len(b),'sha256':'sha256:'+hashlib.sha256(b).hexdigest()}
def obj(p):return json.loads(Path(p).read_text(encoding='utf-8-sig'))
def find_id(value,identifier):
 if isinstance(value,dict):
  if value.get('id')==identifier:return value
  for v in value.values():
   x=find_id(v,identifier)
   if x is not None:return x
 if isinstance(value,list):
  for v in value:
   x=find_id(v,identifier)
   if x is not None:return x
 return None
p=argparse.ArgumentParser();p.add_argument('--capture-directory',required=True);p.add_argument('--run-path',required=True);p.add_argument('--jobs-path',required=True);p.add_argument('--logs-path',required=True);p.add_argument('--run-id',required=True,type=int);p.add_argument('--output',required=True);a=p.parse_args()
assert a.run_id!=36357568243,'Historical run must not be reanalyzed by this tool'
out=Path(a.output).resolve();assert out.is_relative_to(ROOT/'repositories/cca-conformance/evidence/mo1306/phase3a-hosted-diagnostic');assert not out.exists()
run=find_id(obj(a.run_path),a.run_id);assert run is not None
captures={};capture_bindings=[];folder=Path(a.capture_directory)
for name in ('observation-before.json','oracle.json','observation-after.json','diagnostic-summary.json'):
 file=folder/name
 if file.is_file():
  assert file.stat().st_size<=2097152
  captures[name]=obj(file);capture_bindings.append(binding(file))
before=captures.get('observation-before.json',{});after=captures.get('observation-after.json',{});oracle=captures.get('oracle.json',{});summary=captures.get('diagnostic-summary.json',{})
for report,kind in ((before,'MemoryOSHostedFilesystemObservation'),(after,'MemoryOSHostedFilesystemObservation'),(oracle,'MemoryOSHostedFilesystemPredicateOracle')):
 if report:assert report['kind']==kind
allowed=['GITHUB_WORKSPACE','RUNNER_TEMP','RUNNER_TOOL_CACHE','RUNNER_WORKSPACE','USERPROFILE','HOME','TEMP','TMP','SystemRoot','WINDIR','PROCESSOR_ARCHITECTURE']
for report in (before,after):
 if report:assert report['environmentAllowlist']==allowed and sorted(report['environment'])==sorted(allowed)
logs=[];diagnostics=[]
with zipfile.ZipFile(a.logs_path) as archive:
 for name in archive.namelist():
  raw=archive.read(name);lines=raw.decode('utf-8-sig',errors='replace').splitlines();selected=[]
  for i,line in enumerate(lines,1):
   start=line.find('{"code":"MO1306_')
   if start>=0:
    try:diagnostic=json.loads(line[start:])
    except ValueError:continue
    if diagnostic.get('kind')=='MemoryOSCICDDiagnostic':
     selected.append({'line':i,'record':{k:diagnostic.get(k) for k in ['code','kind','stage','version']}})
  logs.append({'member':name,'byteLength':len(raw),'sha256':'sha256:'+hashlib.sha256(raw).hexdigest(),'diagnostics':selected})
  diagnostics.extend({'member':name,**x} for x in selected)
paths=[];persistent=[]
for name in sorted(set(before.get('paths',{}))|set(after.get('paths',{}))):
 b=before.get('paths',{}).get(name,{});e=after.get('paths',{}).get(name,{})
 row={'name':name,'before':b,'after':e,'sameRawPath':b.get('raw')==e.get('raw')}
 bv=b.get('volume')or{};ev=e.get('volume')or{}
 if b.get('raw')==e.get('raw') and bv.get('driveFormat') and bv.get('driveFormat')==ev.get('driveFormat') and bv['driveFormat']!='NTFS':persistent.append({'type':'non-NTFS volume observed before and after','pathClass':name,'path':b['raw'],'driveFormat':bv['driveFormat'],'causalLimit':'Two snapshots do not establish unchanged intervening state or which predicate production reached.'})
 ba={x.get('path'):x for x in b.get('ancestors',[])};ea={x.get('path'):x for x in e.get('ancestors',[])}
 for path in sorted(set(ba)&set(ea)):
  if ba[path].get('reparse') is True and ea[path].get('reparse') is True:persistent.append({'type':'reparse ancestor observed before and after','pathClass':name,'path':path,'causalLimit':'No link target is followed; no actual production failing call is captured.'})
 paths.append(row)
requests=[]
for request in oracle.get('requests',[]):
 r={k:request.get(k) for k in ['ordinal','phase','capabilityClass','targetMetadata','targetCount','operation','byteLength','sha256','helperDeadlineMs','effectiveDeadlineMs','spawnBeforeMs','spawnReturnMs','timerArmedMs','pid','exit','close','stdout','stderr','terminal','spawnError','stdinError','outcome']}
 if isinstance(r.get('close'),dict) and isinstance(r.get('spawnBeforeMs'),(int,float)):r['observedSpawnToCloseMs']=r['close']['atMs']-r['spawnBeforeMs']
 requests.append(r)
report={'kind':'MemoryOSHostedDiagnosticCausalReview','version':'1.0.0','reviewedUtc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'status':'OBSERVATIONS_BOUND','classification':'STILL_UNRESOLVED','classificationScope':'Conservative initial offline review. A parent disposition may separately establish a cause only from concrete evidence; this tool never labels a later pass as transient.','runId':a.run_id,'run':{k:run.get(k) for k in ['id','run_attempt','workflow_id','head_sha','head_branch','status','conclusion','created_at','updated_at']},'bindings':{'tool':binding(__file__),'run':binding(a.run_path),'jobs':binding(a.jobs_path),'logs':binding(a.logs_path),'captures':capture_bindings},'historicalRun':{'id':36357568243,'reexamined':False,'retainedDisposition':'HOSTED_BOOTSTRAP_UNRESOLVED'},'productionDiagnostics':diagnostics,'productionSummary':summary,'actualFirstProductionRejectingSite':None,'oracle':{'temporalScope':oracle.get('temporalScope'),'outcome':oracle.get('outcome'),'firstFailure':oracle.get('firstFailure'),'error':oracle.get('error'),'runtime':oracle.get('runtime'),'identities':oracle.get('identities'),'requests':requests,'causalLimitation':oracle.get('causalLimitation'),'limitations':oracle.get('limitations')},'environmentBefore':before.get('environment'),'environmentAfter':after.get('environment'),'pathSnapshots':paths,'persistentSnapshotObservations':persistent,'independentContainmentBefore':before.get('containmentPredicates'),'postOracleHelperPredicates':after.get('helperTargetPredicates'),'logMembersRead':logs,'decisionRules':['A new bootstrap and oracle pass does not explain the historical failed run and cannot prove a transient.','An oracle timeout is an actual later engineering timeout, not a measured production-helper timeout.','A stable invalid capability predicate may establish an independent contract/layout incompatibility only after exact frozen rule and required path class are reviewed; snapshots alone do not identify the earlier rejection site.','No product or native execution occurs during this review.'],'nativeReruns':0,'remoteMutations':0,'recommendedDefaultDisposition':'Stop if no independently supported causal classification is established; no second diagnostic run.'}
b=(json.dumps(report,sort_keys=True,separators=(',',':'))+'\n').encode();assert len(b)<=2097152
with out.open('xb')as f:f.write(b)
print(json.dumps(binding(out),sort_keys=True))
