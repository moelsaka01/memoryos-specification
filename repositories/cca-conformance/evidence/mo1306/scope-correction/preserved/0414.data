def git(*args,cwd=ROOT):return subprocess.check_output(['git','-C',str(cwd),*args],env={**os.environ,'GIT_OPTIONAL_LOCKS':'0'},timeout=60)
def g(*args,cwd=ROOT):return git(*args,cwd=cwd).decode().strip()
def refmap(text):return dict(line.split(' ',1) for line in text.strip().splitlines())

def claims(v):
 need(v['status']=='HOSTED_CERTIFICATION_BLOCKED','FALSE_COMPLETE_STATE')
 need(v['productionAuthority']==C3CB and v['methodologyAuthority']==M3,'FALSE_AUTHORITY')
 need(v['historicalCauseResolved'] is False,'HISTORICAL_CAUSE_REWRITTEN')
 need(v['nativeCertified'] is True and v['githubHostedCertified'] is False,'CERTIFICATION_SCOPE')
 need(v['labels']=={'generic':'REAL_EXECUTION_CERTIFIED','github':'NOT_CERTIFIED','gitlab':'CONTRACT_VALIDATED','jenkins':'CONTRACT_VALIDATED','azure':'CONTRACT_VALIDATED'},'LABEL_SCOPE')
 for key in ['allCertificationGatesPassed','labelsPromoted','phase3DReady','completionCommitCreated']:
  need(v[key] is False,'FALSE_COMPLETION: '+key)
 for key in ['rootCauseProven','environmentTransientProven','productDefectProven','harnessDefectProven','productChanged','acceptedGroupsRerun']:
  if key in v:need(v[key] is False,'FALSE_CAUSE_OR_SCOPE: '+key)
 need(v['expectedParent']==H and v['containingCommitIdentity']=='NO_AUTHORITATIVE_CERTIFICATION_COMMIT_CREATED','FALSE_COMMIT_BINDING')
 for key in ['commit','finalCommit','completionCommit']:
  if key in v:need(v[key] is None,'FALSE_COMPLETION_COMMIT')
def hosted_claim(v):
 need(v['status']=='BLOCKED' and v['classification']=='HOSTED_CERTIFICATION_BLOCKED' and v['candidate']==C3CB and v['methodology']==M3 and v['certificationCommit']==SCAFFOLD,'HOSTED_BLOCKED_SCOPE')
 need(len(v['attemptedCases'])==v['actualDispatchCount']==1 and v['attemptedCases'][0]['case']=='pass' and v['attemptedCases'][0]['runId']==36357568243,'HOSTED_ATTEMPT_SET')
 need(v['notExecutedCases']==['fail','cne'] and v['artifactCount']==0 and v['parityStatus']=='NOT_PERFORMED','FALSE_HOSTED_ARTIFACT_OR_PARITY')
def remote_claim(v):
 need(v['status']=='PASS' and v['defaultBranch']=='main' and v['remoteMain']==REMOTE_MAIN and v['certificationCommit']==SCAFFOLD and v['certificationRunCount']==1 and v['runIds']==[36357568243] and v['artifactCount']==0,'REMOTE_FINAL_STATE')

class Audit(w.prior.Audit):
 def target(self,name,base=ROOT):
  path=Path(name)
  if not path.is_absolute() and base==ROOT and not (ROOT/path).exists() and (MAIN/path).is_file():return super().target(path,MAIN)
  return super().target(name,base)
 def load(self,name):return json.loads(self.raw(OUT/name))
 def preservation(self,post):
  before=self.load('preservation-before.json');need(before['head']==HEAD and before['historicalFileCount']==len(before['files'])==758,'PRESERVATION_BASELINE');self.walk(before['files']);need(len({r['path'] for r in before['files']})==758,'DUPLICATE_HISTORY')
  old=refmap(before['protectedRefs']);now=refmap(g('for-each-ref','--format=%(refname) %(objectname)'));need(set(old)==set(now),'UNAUTHORIZED_REF_SET')
  allowed={'refs/remotes/origin/mo1306-certification','refs/heads/mo1306/phase3a-refresh'}
  for key in old:
   if key not in allowed:need(now[key]==old[key],'PROTECTED_REF_CHANGED: '+key)
  need(now['refs/remotes/origin/mo1306-certification'] in ([SCAFFOLD] if post else [REMOTE_OLD,SCAFFOLD]),'UNAUTHORIZED_REMOTE_REF')
  head=g('rev-parse','HEAD');need(g('branch','--show-current')==before['branch'],'WORKTREE_BRANCH_CHANGED')
  need(now['refs/heads/mo1306/phase3a-refresh']==head,'HEAD_BRANCH_MISMATCH')
  need(g('rev-parse',M3+'^')==C3CB and g('rev-parse',H+'^')==M3,'AUTHORITY_GRAPH')
  need(not git('diff','--name-only',C3CB,M3,'--','repositories/memoryos-ci','.github/actions/memoryos-policy-gate').strip(),'M3_PRODUCTION_DIFF')
  if post:
   need(g('rev-list','--parents','-n','1','HEAD').split()==[head,H] and g('log','-1','--format=%s')==SUBJECT,'FINAL_COMMIT_GRAPH')
   need(not g('status','--porcelain=v1','--untracked-files=all'),'FINAL_WORKTREE_NOT_CLEAN')
   paths=g('diff','--name-only',H,head).splitlines();need(paths and all(p.startswith(('repositories/cca-conformance/tools/mo1306-phase3a-certification/','repositories/cca-conformance/evidence/mo1306/phase3a-certification/')) for p in paths),'FINAL_NOT_EVIDENCE_ONLY')
   for r in before['files']:need(git('show',head+':'+r['path'])==self.ref(r),'COMMITTED_HISTORY_CHANGED')
  else:
   need(head==HEAD,'PRECOMMIT_HEAD_CHANGED');idx=Path(g('rev-parse','--git-path','index'));idx=idx if idx.is_absolute() else ROOT/idx;need(sha(idx.read_bytes())==before['realIndexSha256'],'PRECOMMIT_INDEX_CHANGED');need(not g('diff','--name-only') and not g('diff','--cached','--name-only'),'TRACKED_CHANGES')
  gate=self.load('m3-verification.json');need(g('rev-parse','HEAD',cwd=MAIN)==M3 and not g('status','--porcelain=v1','--untracked-files=all',cwd=MAIN),'MAIN_CHANGED');idx=Path(g('rev-parse','--git-path','index',cwd=MAIN));idx=idx if idx.is_absolute() else MAIN/idx;need(sha(idx.read_bytes())==gate['mainReadOnly']['indexSha256'],'MAIN_INDEX_CHANGED')
  for namespace in ['phase3ar','phase3ar-resolution','phase3a-final','phase3a-publication-diagnostic','phase3a-environment-capture']:
   index=json.loads(self.raw(ROOT/'repositories/cca-conformance/evidence/mo1306'/namespace/'evidence-index.json'));self.walk(index.get('files',index.get('artifacts',[])))
  return {'historicalFiles':758,'mainHead':M3,'head':head,'postcommit':post,'protectedRefExceptions':sorted(allowed)}
 def harness(self):
  value=self.load('harness-binding.json');self.walk(value);need(value['status']=='PASS' and value['harnessRevision']==H and value['parent']==M3 and value['allProductExecutionHarnessBytesMatch'] is True,'HARNESS_BINDING')
  need(len(value['committedToolBindings'])==18,'HARNESS_TOOL_SET')
  for r in value['committedToolBindings']:need(git('show',H+':'+r['path'])==self.ref(r),'H_TOOL_BLOB_MISMATCH')
  need(not git('diff','--name-only',M3,H,'--','repositories/memoryos-ci','.github/actions/memoryos-policy-gate').strip(),'H_PRODUCTION_DIFF')
  return H
 def frozen_native(self):
  actual=native.verify();saved=self.load('native-validation.json');need(actual==saved,'NATIVE_VALIDATION_DRIFT');self.walk(saved)
  schema_path=ROOT/'repositories/cca-conformance/schema/mo1306-receipt-1.0.0.json';schema=json.loads(self.raw(schema_path));need(len(schema['required'])==15,'FROZEN_SCHEMA_FIELD_COUNT')
  need(git('show',M3+':'+schema_path.relative_to(ROOT).as_posix())==self.raw(schema_path),'FROZEN_SCHEMA_CHANGED')
