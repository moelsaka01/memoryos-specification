 with target.open('xb') as f:f.write(enc(result))
 print(json.dumps({'status':'PASS','classification':'UNRESOLVED','artifact':row(target),'logMembers':11,'installationEntries':95,'maxPath':159,'requestBytes':[8555,7623],'productExecutions':0}))
