130547: async function upload_artifact_uploadArtifact(artifactName, filesToUpload, rootDirectory, options) {
130548:     const uploadResponse = await artifact.uploadArtifact(artifactName, filesToUpload, rootDirectory, options);
130549:     info(`Artifact ${artifactName} has been successfully uploaded! Final size is ${uploadResponse.size} bytes. Artifact ID is ${uploadResponse.id}`);
130550:     setOutput('artifact-id', uploadResponse.id);
130551:     setOutput('artifact-digest', uploadResponse.digest);
130552:     const repository = github_context.repo;
130553:     const artifactURL = `${github_context.serverUrl}/${repository.owner}/${repository.repo}/actions/runs/${github_context.runId}/artifacts/${uploadResponse.id}`;
130554:     info(`Artifact download URL: ${artifactURL}`);
130555:     setOutput('artifact-url', artifactURL);
130556: }
