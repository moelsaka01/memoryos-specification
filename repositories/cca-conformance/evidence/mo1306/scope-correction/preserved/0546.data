130565: async function deleteArtifactIfExists(artifactName) {
130566:     try {
130567:         await artifact.deleteArtifact(artifactName);
130568:     }
130569:     catch (error) {
130570:         if (error instanceof ArtifactNotFoundError) {
130571:             core_debug(`Skipping deletion of '${artifactName}', it does not exist`);
130572:             return;
130573:         }
130574:         // Best effort, we don't want to fail the action if this fails
130575:         core_debug(`Unable to delete artifact: ${error.message}`);
130576:     }
130577: }
130578: async function run() {
130579:     const inputs = getInputs();
130580:     const searchResult = await findFilesToUpload(inputs.searchPath, inputs.includeHiddenFiles);
130581:     if (searchResult.filesToUpload.length === 0) {
130582:         // No files were found, different use cases warrant different types of behavior if nothing is found
130583:         switch (inputs.ifNoFilesFound) {
130584:             case NoFileOptions.warn: {
130585:                 warning(`No files were found with the provided path: ${inputs.searchPath}. No artifacts will be uploaded.`);
130586:                 break;
130587:             }
130588:             case NoFileOptions.error: {
130589:                 setFailed(`No files were found with the provided path: ${inputs.searchPath}. No artifacts will be uploaded.`);
130590:                 break;
130591:             }
130592:             case NoFileOptions.ignore: {
130593:                 info(`No files were found with the provided path: ${inputs.searchPath}. No artifacts will be uploaded.`);
130594:                 break;
130595:             }
130596:         }
130597:     }
130598:     else {
130599:         const s = searchResult.filesToUpload.length === 1 ? '' : 's';
130600:         info(`With the provided path, there will be ${searchResult.filesToUpload.length} file${s} uploaded`);
130601:         core_debug(`Root artifact directory is ${searchResult.rootDirectory}`);
130602:         // Validate that only a single file is uploaded when archive is false
130603:         if (!inputs.archive && searchResult.filesToUpload.length > 1) {
130604:             setFailed(`When 'archive' is set to false, only a single file can be uploaded. Found ${searchResult.filesToUpload.length} files to upload.`);
130605:             return;
130606:         }
130607:         if (inputs.overwrite) {
130608:             await deleteArtifactIfExists(inputs.artifactName);
130609:         }
130610:         const options = {};
130611:         if (inputs.retentionDays) {
130612:             options.retentionDays = inputs.retentionDays;
130613:         }
130614:         if (typeof inputs.compressionLevel !== 'undefined') {
130615:             options.compressionLevel = inputs.compressionLevel;
130616:         }
130617:         if (!inputs.archive) {
130618:             options.skipArchive = true;
130619:         }
130620:         await upload_artifact_uploadArtifact(inputs.artifactName, searchResult.filesToUpload, searchResult.rootDirectory, options);
130621:     }
130622: }
