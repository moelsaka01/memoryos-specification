130501: /**
130502:  * Helper to get all the inputs for the action
130503:  */
130504: function getInputs() {
130505:     const name = getInput(Inputs.Name);
130506:     const path = getInput(Inputs.Path, { required: true });
130507:     const overwrite = getBooleanInput(Inputs.Overwrite);
130508:     const includeHiddenFiles = getBooleanInput(Inputs.IncludeHiddenFiles);
130509:     const archive = getBooleanInput(Inputs.Archive);
130510:     const ifNoFilesFound = getInput(Inputs.IfNoFilesFound);
130511:     const noFileBehavior = NoFileOptions[ifNoFilesFound];
130512:     if (!noFileBehavior) {
130513:         setFailed(`Unrecognized ${Inputs.IfNoFilesFound} input. Provided: ${ifNoFilesFound}. Available options: ${Object.keys(NoFileOptions)}`);
130514:     }
130515:     const inputs = {
130516:         artifactName: name,
130517:         searchPath: path,
130518:         ifNoFilesFound: noFileBehavior,
130519:         overwrite: overwrite,
130520:         includeHiddenFiles: includeHiddenFiles,
130521:         archive: archive
130522:     };
130523:     const retentionDaysStr = getInput(Inputs.RetentionDays);
130524:     if (retentionDaysStr) {
130525:         inputs.retentionDays = parseInt(retentionDaysStr);
130526:         if (isNaN(inputs.retentionDays)) {
130527:             setFailed('Invalid retention-days');
130528:         }
130529:     }
130530:     const compressionLevelStr = getInput(Inputs.CompressionLevel);
130531:     if (compressionLevelStr) {
130532:         inputs.compressionLevel = parseInt(compressionLevelStr);
130533:         if (isNaN(inputs.compressionLevel)) {
130534:             setFailed('Invalid compression-level');
130535:         }
130536:         if (inputs.compressionLevel < 0 || inputs.compressionLevel > 9) {
130537:             setFailed('Invalid compression-level. Valid values are 0-9');
130538:         }
130539:     }
130540:     return inputs;
130541: }
