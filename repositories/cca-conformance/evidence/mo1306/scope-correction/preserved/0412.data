 assert sorted(r['id'] for r in rows)==GROUPS
 return {'kind':'MemoryOSPhase3ACertificationRetainedEvidenceReuse','status':'PASS','methodologyRevision':M3,'productionAuthority':C3CB,'finalWitnessValidation':row(OUT/'witness-validation.json'),'retainedGroupCount':8,'rerunCount':0,'groups':sorted(rows,key=lambda x:x['id']),'sharedBindings':{k:v for k,v in bind.items() if k!='sourceBindings'},'sourceBindings':bind['sourceBindings'],'installedMembers':pre['installedMembers'],'archive':native['archive'],'distributionDigest':native['distributionDigest'],'sdkClosureFileCount':25,'productionDependencies':0,'environment':{'os':bind['os'],'architecture':bind['architecture'],'variables':{k:os.environ[k] for k in ('SystemRoot','WINDIR')},'basis':'Current OS/architecture/explicit environment equal original preflight and three recorded helper spawn environments; pinned Node bytes unchanged. Original controlled system executables are bound by fixed path/platform assumptions, not an invented historical OS-binary hash.'},'originalNativeReceipt':row(OLD/'native-summary.json'),'originalFailurePreserved':{'status':'NATIVE_CERTIFICATION_BLOCKED','classification':'ARTIFACT_ERROR','exitCode':17,'publication':'NONE','cause':'UNRESOLVED'},'offlineOriginalValidation':review,'checkedFileCount':len(a.checked),'independentValidator':row(HERE.parent/'mo1306-phase3a-final/validate.py'),'tool':row(Path(__file__))}
