{"providers":[{"commands":[{"byteLength":1629,"path":"repositories/cca-conformance/evidence/mo1306/phase3b-r2/commands/artifact-generate-generic-1.json","sha256":"sha256:d33de4c0e71660131e5f70cc5f59cd3d1efcf6cd69db531c0bffff4bf10e9396"},{"byteLength":1629,"path":"repositories/cca-conformance/evidence/mo1306/phase3b-r2/commands/artifact-generate-generic-2.json","sha256":"sha256:7b94ed23bc2219911a97319fc0d5bdf52e3bb0151b62d712fd8dd5408a1ff7b6"}],"contents":{"memoryos-ci-generation.json":"{\"configurationSha256\":\"sha256:12ddefe6af24e3364dfee0c081ad4a41061bcf8aa4804716bb6ee65aa5483afb\",\"deploymentSha256\":\"sha256:b2534b79063f224084aa6c28a1ce62a2a5c5edc6bf9d1a28f28a930270a961e6\",\"files\":[{\"byteLength\":342,\"path\":\"memoryos-ci.json\",\"sha256\":\"sha256:12ddefe6af24e3364dfee0c081ad4a41061bcf8aa4804716bb6ee65aa5483afb\"}],\"generator\":{\"id\":\"memoryos.cicd.generator\",\"sha256\":\"sha256:9b2dfb65c48e6587cddbb14769214d66e9ec7c2d617b3cc18239704b39174167\",\"version\":\"1.0.0\"},\"kind\":\"MemoryOSCICDGeneration\",\"provider\":\"generic\",\"version\":\"1.0.0\"}\n","memoryos-ci.json":"{\"context\":{\"candidateMip\":\"candidate.mip\"},\"kind\":\"MemoryOSCICDConfiguration\",\"operation\":\"evaluatePolicy\",\"output\":{\"directory\":\".memoryos-ci/out\"},\"policy\":{\"expectedSemanticDigest\":\"sha256:bc0cb0880beac6408c3a7890c028b2d0cd1544e55b5e79864c564e23c4955157\",\"path\":\"policy.json\"},\"providerExtensions\":{},\"timeoutMs\":60000,\"version\":\"1.0.0\"}\n"},"deployment":{"distributionDigest":"sha256:311927a980bd397ab70b95da77d546e4b212968d05973ecf998817764431d773","kind":"MemoryOSCICDDeployment","options":{},"provider":"generic","version":"1.0.0"},"deterministicFreshRoots":2,"files":[{"byteLength":546,"path":"memoryos-ci-generation.json","sha256":"sha256:b9e8f8d4e5948d3c3373678477b14c14ea478749baba280c95b0465218bc7165"},{"byteLength":342,"path":"memoryos-ci.json","sha256":"sha256:12ddefe6af24e3364dfee0c081ad4a41061bcf8aa4804716bb6ee65aa5483afb"}],"provider":"generic"},{"commands":[{"byteLength":1626,"path":"repositories/cca-conformance/evidence/mo1306/phase3b-r2/commands/artifact-generate-github-1.json","sha256":"sha256:2511794462107d22ad882c5a081e2a82d6de71ea8ca30eb8421e7766fbb73ef5"},{"byteLength":1626,"path":"repositories/cca-conformance/evidence/mo1306/phase3b-r2/commands/artifact-generate-github-2.json","sha256":"sha256:2f2ff20fbfc7d31d57e4e8e0041b7a4c05e4ac12fd03fbce457003dda859b18e"}],"contents":{".github/workflows/memoryos-ci.yml":"name: 'MemoryOS Provider-Neutral CI'\n'on':\n  workflow_dispatch: {}\npermissions:\n  contents: 'read'\njobs:\n  memoryos_ci:\n    name: 'MemoryOS CI'\n    runs-on: 'windows-2022'\n    timeout-minutes: 10\n    steps:\n      - id: 'tools'\n        uses: 'actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1'\n        with:\n          repository: 'moelsaka01/cca-workspace'\n          ref: '9e1bbff99c23cdbc4c80f11e87eadb89a36e8f44'\n          path: '_memoryos/tool'\n          persist-credentials: false\n          submodules: false\n          lfs: false\n      - id: 'data'\n        uses: 'actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1'\n        with:\n          ref: ${{ github.sha }}\n          path: '_memoryos/data'\n          persist-credentials: false\n          submodules: false\n          lfs: false\n      - id: 'bootstrap'\n        shell: 'powershell'\n        run: |\n          $ErrorActionPreference = 'Stop'\n          $env:MEMORYOS_CI_HOME = [IO.Path]::Combine($env:GITHUB_WORKSPACE, '_memoryos\\tool\\repositories\\memoryos-ci')\n          $env:MEMORYOS_CI_CONFIG = [IO.Path]::Combine($env:GITHUB_WORKSPACE, '_memoryos\\tool\\repositories\\cca-conformance\\fixtures\\mo1306\\evaluate-policy-pass\\memoryos-ci.json')\n          & ([IO.Path]::Combine($env:MEMORYOS_CI_HOME, 'scripts\\Initialize-GitHubCI.ps1')) -WorkspaceRoot $env:GITHUB_WORKSPACE -ConfigurationDigest 'sha256:12ddefe6af24e3364dfee0c081ad4a41061bcf8aa4804716bb6ee65aa5483afb' -DistributionDigest 'sha256:311927a980bd397ab70b95da77d546e4b212968d05973ecf998817764431d773'\n          exit $LASTEXITCODE\n      - id: 'evaluate'\n        shell: 'powershell'\n        run: |\n          $ErrorActionPreference = 'Stop'\n          $env:MEMORYOS_CI_HOME = [IO.Path]::Combine($env:GITHUB_WORKSPACE, '_memoryos\\tool\\repositories\\memoryos-ci')\n          $env:MEMORYOS_CI_CONFIG = [IO.Path]::Combine($env:GITHUB_WORKSPACE, '_memoryos\\tool\\repositories\\cca-conformance\\fixtures\\mo1306\\evaluate-policy-pass\\memoryos-ci.json')\n          & ([IO.Path]::Combine($env:MEMORYOS_CI_HOME, 'scripts\\Invoke-GitHubCI.ps1')) -Mode 'Evaluate' -WorkspaceRoot $env:GITHUB_WORKSPACE -ConfigurationDigest 'sha256:12ddefe6af24e3364dfee0c081ad4a41061bcf8aa4804716bb6ee65aa5483afb' -DistributionDigest 'sha256:311927a980bd397ab70b95da77d546e4b212968d05973ecf998817764431d773'\n          exit $LASTEXITCODE\n      - id: 'upload'\n        if: always() && steps.evaluate.outputs.complete == 'true'\n        uses: 'actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a'\n        with:\n          name: 'memoryos-ci-${{ github.run_id }}-${{ github.run_attempt }}'\n          path: |\n            _memoryos/data/.memoryos-ci/out/${{ steps.evaluate.outputs.run-id }}/evaluation-identity.json\n            _memoryos/data/.memoryos-ci/out/${{ steps.evaluate.outputs.run-id }}/memoryos-ci-artifacts.json\n            _memoryos/data/.memoryos-ci/out/${{ steps.evaluate.outputs.run-id }}/memoryos-ci-complete.json\n            _memoryos/data/.memoryos-ci/out/${{ steps.evaluate.outputs.run-id }}/memoryos-ci-evidence.json\n            _memoryos/data/.memoryos-ci/out/${{ steps.evaluate.outputs.run-id }}/memoryos-ci-result.json\n            _memoryos/data/.memoryos-ci/out/${{ steps.evaluate.outputs.run-id }}/policy-outcome.json\n          if-no-files-found: 'error'\n          include-hidden-files: true\n          retention-days: 7\n      - id: 'gate'\n        if: always()\n        shell: 'powershell'\n        env:\n          COMPLETE: ${{ steps.evaluate.outputs.complete }}\n          EXIT_CODE: ${{ steps.evaluate.outputs.exit-code }}\n          RUN_ID: ${{ steps.evaluate.outputs.run-id }}\n          EVALUATE_OUTCOME: ${{ steps.evaluate.outcome }}\n          UPLOAD_OUTCOME: ${{ steps.upload.outcome }}\n        run: |\n          $ErrorActionPreference = 'Stop'\n          $env:MEMORYOS_CI_HOME = [IO.Path]::Combine($env:GITHUB_WORKSPACE, '_memoryos\\tool\\repositories\\memoryos-ci')\n          $env:MEMORYOS_CI_CONFIG = [IO.Path]::Combine($env:GITHUB_WORKSPACE, '_memoryos\\tool\\repositories\\cca-conformance\\fixtures\\mo1306\\evaluate-policy-pass\\memoryos-ci.json')\n          & ([IO.Path]::Combine($env:MEMORYOS_CI_HOME, 'scripts\\Invoke-GitHubCI.ps1')) -Mode 'Gate' -WorkspaceRoot $env:GITHUB_WORKSPACE -ConfigurationDigest 'sha256:12ddefe6af24e3364dfee0c081ad4a41061bcf8aa4804716bb6ee65aa5483afb' -DistributionDigest 'sha256:311927a980bd397ab70b95da77d546e4b212968d05973ecf998817764431d773'\n          exit $LASTEXITCODE\n","memoryos-ci-generation.json":"{\"configurationSha256\":\"sha256:12ddefe6af24e3364dfee0c081ad4a41061bcf8aa4804716bb6ee65aa5483afb\",\"deploymentSha256\":\"sha256:9ffc49090c772c9f7ad7a4f5b85a24790e448221c2add9b5aadc53fb6b3e5708\",\"files\":[{\"byteLength\":4409,\"path\":\".github/workflows/memoryos-ci.yml\",\"sha256\":\"sha256:0904fe85fa55a141d1c3dbdbaa757a524611e9b2e1e4d59de1d050b268427348\"},{\"byteLength\":342,\"path\":\"memoryos-ci.json\",\"sha256\":\"sha256:12ddefe6af24e3364dfee0c081ad4a41061bcf8aa4804716bb6ee65aa5483afb\"}],\"generator\":{\"id\":\"memoryos.cicd.generator\",\"sha256\":\"sha256:9b2dfb65c48e6587cddbb14769214d66e9ec7c2d617b3cc18239704b39174167\",\"version\":\"1.0.0\"},\"kind\":\"MemoryOSCICDGeneration\",\"provider\":\"github\",\"version\":\"1.0.0\"}\n","memoryos-ci.json":"{\"context\":{\"candidateMip\":\"candidate.mip\"},\"kind\":\"MemoryOSCICDConfiguration\",\"operation\":\"evaluatePolicy\",\"output\":{\"directory\":\".memoryos-ci/out\"},\"policy\":{\"expectedSemanticDigest\":\"sha256:bc0cb0880beac6408c3a7890c028b2d0cd1544e55b5e79864c564e23c4955157\",\"path\":\"policy.json\"},\"providerExtensions\":{},\"timeoutMs\":60000,\"version\":\"1.0.0\"}\n"},"deployment":{"distributionDigest":"sha256:311927a980bd397ab70b95da77d546e4b212968d05973ecf998817764431d773","kind":"MemoryOSCICDDeployment","options":{"configPath":"repositories/cca-conformance/fixtures/mo1306/evaluate-policy-pass/memoryos-ci.json","repository":"moelsaka01/cca-workspace","toolRevision":"9e1bbff99c23cdbc4c80f11e87eadb89a36e8f44"},"provider":"github","version":"1.0.0"},"deterministicFreshRoots":2,"files":[{"byteLength":4409,"path":".github/workflows/memoryos-ci.yml","sha256":"sha256:0904fe85fa55a141d1c3dbdbaa757a524611e9b2e1e4d59de1d050b268427348"},{"byteLength":691,"path":"memoryos-ci-generation.json","sha256":"sha256:46b805d673103bade619fd4ab19f4dd7765301c5d719df72c3743d1abb871ee8"},{"byteLength":342,"path":"memoryos-ci.json","sha256":"sha256:12ddefe6af24e3364dfee0c081ad4a41061bcf8aa4804716bb6ee65aa5483afb"}],"provider":"github"}],"scope":"Fresh installed generic/GitHub generation only; no hosted execution.","status":"PASS"}
