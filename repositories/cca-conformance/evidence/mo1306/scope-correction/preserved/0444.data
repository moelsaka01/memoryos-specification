  "status": "COMPLETE",
  "disposition": "REACHABLE_NOT_ATTACKER_CONTROLLED",
  "dispositionDefinition": "The affected implementation is included and is conditionally code-reachable in the exact frozen upload invocation. Its XML response input cannot be selected or populated with arbitrary entity syntax by a repository contributor under the frozen trusted-tool/data and hosted-service trust boundaries. Malicious XML control requires a trusted hosted endpoint/service or authenticated transport/runner trust failure. This is not a claim that the dependency is patched or that parser resource limits fully mitigate it.",
  "releaseReadyCompatible": true,
  "actionUpdateRequired": false,
  "riskAcceptanceMade": false,
  "candidate": "9e1bbff99c23cdbc4c80f11e87eadb89a36e8f44",
  "actionPin": "043fb46d1a93c77aae656e7c1c64a875d1fc6a0a",
  "reviewedAt": "2026-09-26T20:17:28.504750+00:00",
  "authority": {
    "maintainerUrl": "https://github.com/NaturalIntelligence/fast-xml-parser/security/advisories/GHSA-8gc5-j5rx-235r",
    "maintainerAffectedRange": ">=4.0.0-beta.3, <= 5.5.5",
    "maintainerPatchedVersions": [
      "4.5.5",
      "5.5.6"
    ],
    "githubGlobalNormalizedRanges": [
      ">= 4.0.0-beta.3, < 4.5.5",
      ">= 5.0.0, < 5.5.6"
    ],
    "rangeNote": "Maintainer broad range overlaps the 4.5.5 backport; global split ranges resolve that ambiguity. 5.4.1 is affected under either statement.",
    "fixCommit": "bd26122c838e6a55e7d7ac49b4ccc01a49999a01",
    "fixedReleaseCommit": "870043e75e78545192bc70950c6286d36c7cdf23",
    "workaround": "htmlEntities:false",
    "mechanism": "DOCTYPE replacement counts expansions; standard-entity replacements and HTML/numeric replacements omit expansion accounting. Large attacker-selected XML can cause excess CPU/memory despite explicit limits.",
    "impact": "Availability/denial of service, potential memory exhaustion; no resource-exhaustion test was performed.",
    "preconditions": [
      "Control XML supplied to parser",
      "Enabled entity-processing path",
      "Enough references to create resource pressure"
    ],
    "sourceCorrection": "For exact bundled 5.4.1, general num_dec/num_hex are in htmlEntities, not lastEntities as maintainer narrative suggests. lastEntities still processes standard named entities and fixed numeric spellings such as &#60; without counting. Generic &#65; with htmlEntities:false remains literal and is not counted as 1001 decoded expansions."
  },
