summary={'kind':'MemoryOSMO1306Phase3CRSecurityAudit','version':'1.0.0','baseline':'9e1bbff99c23cdbc4c80f11e87eadb89a36e8f44','status':'PASS','scope':'Independent provider-neutral security/generic offline audit; candidate byte identities and scope-limited historical replay, not final installed or hosted certification','productionDefects':0,'areas':areas,'counts':{'freshIndependentCases':101,'targetedLogicCases':109,'existingContractTests':152,'existingNetworkTests':37,'correctionAContractTests':14,'reusedLifecycleTraces':3,'lifecycleNegativeWitnesses':12,'publicVerifyCommands':1,'bundleTamperNegatives':14,'stableSDKErrorCodes':84},'retainedOperationalRefusals':3,'attemptDispositions':[{'attempt':'security-first-attempt.json','status':'FAILED_OPERATIONAL_PROBE','detail':'Positive missing-leaf helper reached frozen2s deadline. Initial direct exec root launch profile; no unsafe input accepted.'},{'attempt':'security-second-attempt.json','status':'FAILED_OPERATIONAL_PROBE','detail':'Same helper deadline after removing redundant runtime hashing; preserved without weakening product timeout.'},{'attempt':'security-execution.json','status':'PARTIAL_SUCCESS_WITH_OPERATIONAL_REFUSAL','detail':'Detached sanctioned root profile passed101cases including native PASS/FAIL/CNE, then metadata publication returned ARTIFACT_WRITE17. Five final files and no completion marker retained. Timeout consistent with separate1904ms helper diagnostic but exact cause not independently observed.'},{'attempt':'security-finish-first.json','status':'HARNESS_SERIALIZATION_FAILURE','detail':'Intentionally negative Date.now perturbation succeeded; engineering receipt serializer J rejects negative numbers. Preserved exact harness/output; represent clock value as string in final receipt.'}],'limitations':['No OS-wide network denial or kernel process-isolation claim','No hosted-provider execution or certification','Final installed Windows resource/cleanup certification remains external 3A-R','PowerShell pa