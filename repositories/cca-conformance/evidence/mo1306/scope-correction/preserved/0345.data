{"authority":"701d48ee2012675966360dda775ab13013c09ab9","byteLength":7671,"kind":"MemoryOSDiagnosticSourceSite","lines":[{"number":89,"text":"      const helperDeadline=performance.now()+2000;"},{"number":90,"text":"      const effectiveDeadline=Math.min(deadline,helperDeadline);"},{"number":91,"text":"      const timeoutCode=deadline<=helperDeadline?'OVERALL_TIMEOUT':'FILESYSTEM_BOUNDARY';"},{"number":92,"text":"      if(performance.now()>=effectiveDeadline)reject(timeoutCode);"},{"number":97,"text":"      timer=setTimeout(()=>stop(timeoutCode),Math.max(0,effectiveDeadline-performance.now()));"},{"number":107,"text":"          if(performance.now()>=effectiveDeadline)reject(timeoutCode);"},{"number":111,"text":"          if(performance.now()>=effectiveDeadline)reject(timeoutCode);"}],"path":"repositories/memoryos-ci/src/filesystem.mjs","scope":"Source mapping for observed later oracle helper deadline only; not a proven production rejection site.","sha256":"sha256:f7c9d28ba2761c6987b7a0be40bdfaa73278996b9974267562900c817e185dc9"}
