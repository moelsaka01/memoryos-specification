import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {spawn} from 'node:child_process';
import {performance} from 'node:perf_hooks';
import {J} from '../../../memoryos-ci/src/serialization.mjs';
import {configuration,relativeFile,digest,limits} from '../../../memoryos-ci/src/contracts.mjs';
import {absolutePath,contained,nodePathCheck,readChecked,checkPaths,childEnvironment,packageRoot} from '../../../memoryos-ci/src/filesystem.mjs';
import {verifyNode,verifyDistribution} from '../../../memoryos-ci/src/integrity.mjs';
import {verifyBundle} from '../../../memoryos-ci/src/verification.mjs';
import {catalog,projections,CIError,classification,diagnosticWriter} from '../../../memoryos-ci/src/errors.mjs';
import {workerArguments} from '../../../memoryos-ci/src/supervisor.mjs';
const ROOT=path.resolve(fileURLToPath(new URL('../../../../',import.meta.url)));
const OUT=path.join(ROOT,'repositories/cca-conformance/evidence/mo1306/phase3cr');
const WORK=path.join(OUT,'security-work');
const FIX=path.join(ROOT,'repositories/cca-conformance/fixtures/mo1306');
const env={SystemRoot:process.env.SystemRoot,WINDIR:process.env.WINDIR};
const baseline='9e1bbff99c23cdbc4c80f11e87eadb89a36e8f44';
const cases=[];const started=performance.now();
fs.mkdirSync(OUT,{recursive:true});fs.mkdirSync(WORK);
const manifest=verifyDistribution(); const runtimeIdentity={version:process.version,sha256:digest(fs.readFileSync(process.execPath))};
function artifact(full){const bytes=fs.readFileSync(full);return {path:path.relative(ROOT,full).replaceAll('\\','/'),byteLength:bytes.length,sha256:digest(bytes)};}
function checkpoint(){fs.writeFileSync(path.join(OUT,'security-execution.json'),J({kind:'MO1306Phase3CRSecurityAudit',version:'1.0.0',baseline,status:cases.some(c=>c.status==='FAIL')?'FAIL':'IN_PROGRESS',harness:artifact(fileURLToPath(import.meta.url)),runtime:runtimeIdentity,distribution:artifact(path.join(packageRoot,'distribution-manifest.json')),cases,elapsedMs:Math.round(performance.now()-started)}));}
async function check(id,action){const start=performance.now();try{const detail=await action();cases.push({id,status:'PASS',elapsedMs:Math.round(performance.now()-start),...(detail?{detail}:{})});}catch(e){cases.push({id,status:'FAIL',elapsedMs:Math.round(performance.now()-start),error:String(e.stack||e)});checkpoint();throw e;}checkpoint();process.stdout.write(id+' PASS\n');}
function rejects(fn,code){assert.throws(fn,e=>e instanceof CIError && (!code||e.code==='MO1306_'+code));}
function command(args,extra={}){return new Promise((resolve,reject)=>{const argv=['--max-old-space-size=128',...args],child=spawn(process.execPath,argv,{cwd:ROOT,env:{...env,...extra},shell:false,detached:true,windowsHide:true,stdio:['ignore','pipe','pipe']});let out='',err='';const timer=setTimeout(()=>{child.kill();reject(new Error('BOUNDED_COMMAND_TIMEOUT'));},60000);child.stdout.on('data',b=>out+=b);child.stderr.on('data',b=>err+=b);child.on('error',reject);child.on('close',code=>{clearTimeout(timer);resolve({command:[process.execPath,...argv],exitCode:code,stdout:out,stderr:err});});});}
const raw=fs.readFileSync(path.join(FIX,'evaluate-policy-pass/memoryos-ci.json'));
const config=configuration(raw);
await check('config-defaults-and-serialization',()=>{assert.equal(config.timeoutMs,60000);assert.deepEqual(config.providerExtensions,{});assert.equal(J(config),J(configuration(Buffer.from(J(config)))));assert.equal(J({b:1,a:[2,1]}),'{"a":[2,1],"b":1}\n');});
const badConfig={unknown:c=>c.extra='x',wrongVersion:c=>c.version='9',inline:c=>c.context.inline={},both:c=>c.policySet=c.policy,neither:c=>delete c.policy,operation:c=>c.operation='eval',timeoutLow:c=>c.timeoutMs=999,timeoutHigh:c=>c.timeoutMs=60001,output:c=>c.output.directory='../out',extensions:c=>c.providerExtensions.secret='x',collision:c=>c.context.candidateMip='POLICY.JSON',URL:c=>c.context.candidateMip='https://invalid/input'};
for(const [id,mutate]of Object.entries(badConfig))await check('configuration-reject-'+id,()=>{const c=structuredClone(config);mutate(c);rejects(()=>configuration(Buffer.from(J(c))));});
const relativeBad=['','../x','a/../x','./x','a//b','/root','C:/x','C:x','\\x','\\\\server\\share','\\\\?\\C:\\x','\\\\.\\pipe\\x','a:b','a::$DATA','CON','PRN.txt','AUX','NUL','COM1.txt','LPT9','con.foo','foo.',' foo','foo ','a\\b','.memoryos-ci/out/a','a;echo','a$()','a|b','a&b','a\nb','a\rb','a\u0000b','a\u001bb','a\u007fb','${secret}','$(secret)','${{ secrets.X }}','a*','a?','a"','a\x60','a'.repeat(101)];
for(const [i,v]of relativeBad.entries())await check('relative-boundary-'+i,()=>rejects(()=>relativeFile(v),'FILESYSTEM_BOUNDARY'));
const absoluteBad=['C:relative','\\root','/root','\\\\server\\share','\\\\?\\C:\\x','\\\\.\\C:\\x','C:\\x:y','C:\\x::$DATA','C:\\x\\..\\y','C:\\x\\.\\y','C:\\NUL.txt','C:\\LPT1','C:\\x.','C:\\ x','C:\\x ','C:\\x;echo','C:\\x$()','C:\\x\nnext','C:\\x|echo','C:\\x&echo','C:\\x\\\\y'];
for(const [i,v]of absoluteBad.entries())await check('absolute-boundary-'+i,()=>rejects(()=>absolutePath(v),'FILESYSTEM_BOUNDARY'));
await check('containment-valid-spaces',()=>assert.equal(contained(WORK,'a b.json'),path.join(WORK,'a b.json')));
await check('regular-file-bounds-and-hardlink',()=>{const p=path.join(WORK,'input'),l=path.join(WORK,'alias');fs.writeFileSync(p,'abcd');assert.equal(readChecked(p,4).toString(),'abcd');rejects(()=>readChecked(p,3),'INPUT_LIMIT');fs.linkSync(p,l);rejects(()=>readChecked(p,4),'FILESYSTEM_BOUNDARY');fs.unlinkSync(l);});
await check('junction-and-reparse-helper',async()=>{const d=path.join(WORK,'real'),l=path.join(WORK,'junction');fs.mkdirSync(d);fs.symlinkSync(d,l,'junction');try{rejects(()=>nodePathCheck(l),'FILESYSTEM_BOUNDARY');await assert.rejects(checkPaths([{path:l,allowMissingLeaf:false}],{deadline:performance.now()+10000}),e=>e.code==='MO1306_FILESYSTEM_BOUNDARY');}finally{fs.unlinkSync(l);}return {type:'NTFS junction / ReparsePoint',nodeAndPowerShellRejected:true};});
await check('missing-leaf-and-directory-type',async()=>{const good=path.join(WORK,'missing'),bad=path.join(WORK,'absent','leaf');await checkPaths([{path:good,allowMissingLeaf:true}],{deadline:performance.now()+10000});await assert.rejects(checkPaths([{path:bad,allowMissingLeaf:true}],{deadline:performance.now()+10000}),e=>e.code==='MO1306_FILESYSTEM_BOUNDARY');rejects(()=>readChecked(WORK,4096),'FILESYSTEM_BOUNDARY');});
await check('file-symlink-or-host-privilege-disposition',()=>{const l=path.join(WORK,'filelink');try{fs.symlinkSync(path.join(WORK,'input'),l,'file');}catch(e){if(e.code==='EPERM')return {status:'HOST_PRIVILEGE_UNAVAILABLE',reparseCoverage:'native junction rejected separately'};throw e;}try{rejects(()=>readChecked(l,4),'FILESYSTEM_BOUNDARY');}finally{fs.unlinkSync(l);}return {status:'EXECUTED_REJECTED'};});
await check('trusted-node-executable',()=>verifyNode());
for(const variable of ['NODE_OPTIONS','NODE_PATH','NODE_INSPECT_RESUME_ON_START','NODE_REPL_EXTERNAL_MODULE'])await check('runtime-environment-reject-'+variable,()=>{process.env[variable]='AUDIT-SYNTHETIC-SENTINEL';try{rejects(()=>verifyNode(),'RUNTIME_INTEGRITY');}finally{delete process.env[variable];}});
for(const flag of ['--require=sentinel','--import=sentinel','--loader=sentinel','--inspect','--inspect-brk','--eval=sentinel','--allow-child-process'])await check('runtime-argv-reject-'+flag.split('=')[0],()=>{process.execArgv.push(flag);try{rejects(()=>verifyNode(),'RUNTIME_INTEGRITY');}finally{process.execArgv.pop();}return {scope:'in-process verifyNode argv validation; no preload/loader/debugger executed'};});
await check('child-environment-actual-allowlist',async()=>{for(const key of ['PATH','PATHEXT','HTTP_PROXY','HTTPS_PROXY','ALL_PROXY','NO_PROXY','GITHUB_TOKEN','CI_JOB_TOKEN','AZURE_TOKEN','AWS_SECRET_ACCESS_KEY','COMSPEC','PSModulePath','USERPROFILE','TEMP'])process.env[key]='AUDIT-SYNTHETIC-SENTINEL';const actual=childEnvironment();assert.deepEqual(Object.keys(actual).sort(),['SystemRoot','WINDIR']);const result=await command(['-e','process.stdout.write(JSON.stringify(Object.keys(process.env).sort()))'],{});assert.equal(result.exitCode,0);assert.deepEqual(JSON.parse(result.stdout),['SystemRoot','WINDIR']);return {environmentKeys:JSON.parse(result.stdout)};});
await check('worker-direct-argv-and-limits',()=>{const a=workerArguments();assert.deepEqual(a,['--permission','--allow-fs-read='+packageRoot,'--max-old-space-size=256','--max-semi-space-size=16',path.join(packageRoot,'src/worker.mjs')]);assert.equal(limits.fixed.processCount,3);assert.equal(limits.fixed.semanticQueue,0);assert.equal(limits.fixed.semanticMaxMs,60000);});
await check('closed-28-errors-and-exits',()=>{assert.equal(Object.keys(catalog.errors).length,28);const semantic={PASS:0,FAIL:6,COULD_NOT_EVALUATE:7};for(const [k,v]of Object.entries(semantic))assert.equal(projections[k].exitCode,v);for(const [code,row]of Object.entries(catalog.errors)){assert.equal(projections[classification(new CIError(code))].exitCode,row[1]);assert.ok(row[1]>=10&&row[1]<=17);}return {machineErrors:28,semanticExits:semantic,operationalExits:[...new Set(Object.values(catalog.errors).map(r=>r[1]))].sort()};});
await check('fixed-diagnostics-truncation-no-output-injection',()=>{const records=[],write=diagnosticWriter(s=>records.push(s));for(let i=0;i<100;i++)write(new Error('AUDIT-SYNTHETIC-SENTINEL\n::error::injected'));assert.equal(records.length,32);assert.equal(JSON.parse(records.at(-1)).code,'MO1306_DIAGNOSTICS_TRUNCATED');assert.ok(records.every(s=>Buffer.byteLength(s)<=1024));assert.ok(Buffer.byteLength(records.join(''))<=16384);assert.ok(!records.join('').includes('SENTINEL'));});
const native=[];
for(const [name,fixture,expected,mutation,poison]of [
 ['pass','evaluate-policy-pass',0,null,null],['fail','evaluate-policy-fail',6,null,null],['cne','evaluate-policy-cne',7,null,null],
 ['metadata','evaluate-policy-pass',0,null,{GITHUB_ACTOR:'AUDIT-SYNTHETIC-SENTINEL',GITHUB_SHA:'a'.repeat(40),HTTP_PROXY:'AUDIT-SYNTHETIC-SENTINEL',HTTPS_PROXY:'AUDIT-SYNTHETIC-SENTINEL',GITHUB_TOKEN:'AUDIT-SYNTHETIC-SENTINEL',PATHEXT:'AUDIT-SYNTHETIC-SENTINEL',LANG:'zz_TEST'}],
 ['configuration','evaluate-policy-pass',10,(c,w)=>c.unknown=true,null],
 ['input','evaluate-policy-pass',11,(c,w)=>fs.unlinkSync(path.join(w,'candidate.mip')),null],
 ['integrity','evaluate-policy-pass',15,(c,w)=>c.policy.expectedSemanticDigest='sha256:'+'0'.repeat(64),null]
])await check('native-generic-'+name,async()=>{const w=path.join(WORK,name);fs.mkdirSync(w);for(const f of ['policy.json','candidate.mip','memoryos-ci.json'])fs.copyFileSync(path.join(FIX,fixture,f),path.join(w,f));const c=JSON.parse(fs.readFileSync(path.join(w,'memoryos-ci.json')));mutation?.(c,w);fs.writeFileSync(path.join(w,'memoryos-ci.json'),J(c));const r=await command([path.join(packageRoot,'bin/memoryos-ci.mjs'),'run','--workspace',w,'--config',path.join(w,'memoryos-ci.json')],poison||{});assert.equal(r.exitCode,expected,r.stderr);const summary=JSON.parse(r.stdout);assert.equal(summary.exitCode,expected);assert.equal(summary.publication,'COMPLETE');const bundle=path.join(w,'.memoryos-ci/out',summary.runId);const checked=await verifyBundle(bundle,manifest,{deadline:performance.now()+20000});if(expected===0||expected===6||expected===7){for(const f of ['evaluation-identity.json','policy-outcome.json'])assert.ok(fs.readFileSync(path.join(bundle,f)).equals(fs.readFileSync(path.join(FIX,fixture,f))),f+' differs from independent golden');}else assert.equal(checked.result.semantic,null);assert.ok(![r.stdout,r.stderr,...fs.readdirSync(bundle).map(f=>fs.readFileSync(path.join(bundle,f),'utf8'))].join('').includes('AUDIT-SYNTHETIC-SENTINEL'));const dest=path.join(OUT,'security-bundles',name,summary.runId);fs.mkdirSync(path.dirname(dest),{recursive:true});fs.cpSync(bundle,dest,{recursive:true,errorOnExist:true});native.push({name,...r,summary,bundle:path.relative(ROOT,dest).replaceAll('\\','/'),artifacts:fs.readdirSync(dest).map(f=>artifact(path.join(dest,f)))});fs.writeFileSync(path.join(OUT,'security-native.json'),J({baseline,scope:'Fresh native Windows public CLI generic execution, exact C3AB source distribution; no hosted or installed archive certification claim',cases:native}));return {exitCode:r.exitCode,classification:summary.classification,bundle:native.at(-1).bundle};});
const valid=path.join(ROOT,native[0].bundle);
await check('native-public-verify',async()=>{const r=await command([path.join(packageRoot,'bin/memoryos-ci.mjs'),'verify','--bundle',valid]);assert.equal(r.exitCode,0,r.stderr);assert.equal(r.stdout,'');assert.equal(r.stderr,'');return r;});
await check('normative-invariant-operational-isolation',()=>{const second=path.join(ROOT,native.find(r=>r.name==='metadata').bundle);for(const f of ['evaluation-identity.json','policy-outcome.json'])assert.ok(fs.readFileSync(path.join(valid,f)).equals(fs.readFileSync(path.join(second,f))));const a=JSON.parse(fs.readFileSync(path.join(valid,'memoryos-ci-result.json'))),b=JSON.parse(fs.readFileSync(path.join(second,'memoryos-ci-result.json')));assert.notEqual(a.runId,b.runId);assert.equal(a.inputDigest,b.inputDigest);assert.deepEqual(a.semantic,b.semantic);return {differentOperationalRunIds:true,normativeExactBytesEqual:true};});
function repair(dir){const manifestPath=path.join(dir,'memoryos-ci-artifacts.json'),m=JSON.parse(fs.readFileSync(manifestPath));for(const row of m.files){const bytes=fs.readFileSync(path.join(dir,row.path));row.byteLength=bytes.length;row.sha256=digest(bytes);}fs.writeFileSync(manifestPath,J(m));const markerPath=path.join(dir,'memoryos-ci-complete.json'),marker=JSON.parse(fs.readFileSync(markerPath));marker.manifestSha256=digest(fs.readFileSync(manifestPath));fs.writeFileSync(markerPath,J(marker));}
const tamper=[['result-exit','memoryos-ci-result.json',v=>v.process.exitCode=6],['run-cross-link','memoryos-ci-evidence.json',v=>v.runId='00000000-0000-4000-8000-000000000000'],['projection-cross-link','memoryos-ci-evidence.json',v=>v.projectionSha256='sha256:'+'0'.repeat(64)],['distribution-cross-link','memoryos-ci-evidence.json',v=>v.distributionSha256='sha256:'+'0'.repeat(64)],['adapter-cross-link','memoryos-ci-evidence.json',v=>v.adapter.sha256='sha256:'+'0'.repeat(64)],['runtime-cross-link','memoryos-ci-evidence.json',v=>v.runtime.nodeSha256='sha256:'+'0'.repeat(64)],['inputs-cross-link','memoryos-ci-evidence.json',v=>v.inputs[0].sha256='sha256:'+'0'.repeat(64)],['unknown-field','memoryos-ci-evidence.json',v=>v.unknown=true],['normative-identity','evaluation-identity.json',v=>v.unknown=true],['normative-outcome','policy-outcome.json',v=>v.unknown=true]];
for(const [name,file,mutate]of tamper)await check('tamper-reject-'+name,async()=>{const dir=path.join(WORK,'t-'+name,path.basename(valid));fs.mkdirSync(path.dirname(dir));fs.cpSync(valid,dir,{recursive:true});const v=JSON.parse(fs.readFileSync(path.join(dir,file)));mutate(v);fs.writeFileSync(path.join(dir,file),J(v));repair(dir);await assert.rejects(verifyBundle(dir,manifest,{deadline:performance.now()+20000}),e=>['MO1306_BUNDLE_INTEGRITY','MO1306_SEMANTIC_INTEGRITY'].includes(e.code));});
for(const mode of ['extra','missing-marker','missing-outcome','manifest-path'])await check('artifact-allowlist-reject-'+mode,async()=>{const dir=path.join(WORK,'t-'+mode,path.basename(valid));fs.mkdirSync(path.dirname(dir));fs.cpSync(valid,dir,{recursive:true});if(mode==='extra')fs.writeFileSync(path.join(dir,'secret.txt'),'synthetic');if(mode==='missing-marker')fs.unlinkSync(path.join(dir,'memoryos-ci-complete.json'));if(mode==='missing-outcome')fs.unlinkSync(path.join(dir,'policy-outcome.json'));if(mode==='manifest-path'){const p=path.join(dir,'memoryos-ci-artifacts.json'),v=JSON.parse(fs.readFileSync(p));v.files[0].path='../escape';fs.writeFileSync(p,J(v));}await assert.rejects(verifyBundle(dir,manifest,{deadline:performance.now()+20000}),e=>e.code==='MO1306_BUNDLE_INTEGRITY');});
const saved=JSON.parse(fs.readFileSync(path.join(OUT,'security-execution.json')));saved.status='PASS';saved.completedCases=cases.length;saved.scopeLimitations=['No OS-wide network isolation claim','Network APIs checked separately without opening a connection','Fresh native correctness runs do not replace 3A-R installed-package or hosted certification','Preload and debugger poisoning tested at integrity validator and launcher review, never executed','File-symlink privilege disposition explicit; native junction covers ReparsePoint denial'];saved.dependencies=manifest.manifest.files.map(row=>({path:'repositories/memoryos-ci/'+row.path,byteLength:row.byteLength,sha256:row.sha256}));fs.writeFileSync(path.join(OUT,'security-execution.json'),J(saved));process.stdout.write('SECURITY AUDIT PASS '+cases.length+' cases\n');
