(xmlData);\n+      console.log(JSON.stringify(result, null, 4));\n+    }).toThrowError(/Entity expansion limit exceeded: 30 > 20/);\n+  });\n });\n\\ No newline at end of file"},{"sha":"4724d48cb1ce77f0a77825b65ab280aa2cc7d001","filename":"src/fxp.d.ts","status":"modified","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/NaturalIntelligence/fast-xml-parser/blob/870043e75e78545192bc70950c6286d36c7cdf23/src%2Ffxp.d.ts","raw_url":"https://github.com/NaturalIntelligence/fast-xml-parser/raw/870043e75e78545192bc70950c6286d36c7cdf23/src%2Ffxp.d.ts","contents_url":"https://api.github.com/repos/NaturalIntelligence/fast-xml-parser/contents/src%2Ffxp.d.ts?ref=870043e75e78545192bc70950c6286d36c7cdf23","patch":"@@ -516,6 +516,13 @@ export type XmlBuilderOptions = {\n \n \n   oneListGroup?: boolean;\n+\n+  /**\n+ * Maximum number of nested tags\n+ * \n+ * Defaults to `100`\n+ */\n+  maxNestedTags?: number;\n };\n \n type ESchema = string | object | Array<string | object>;"},{"sha":"6bcc911e56e4b898ab41d1f3be1c5def381923f5","filename":"src/xmlparser/DocTypeReader.js","status":"modified","additions":2,"deletions":1,"changes":3,"blob_url":"https://github.com/NaturalIntelligence/fast-xml-parser/blob/870043e75e78545192bc70950c6286d36c7cdf23/src%2Fxmlparser%2FDocTypeReader.js","raw_url":"https://github.com/NaturalIntelligence/fast-xml-parser/raw/870043e75e78545192bc70950c6286d36c7cdf23/src%2Fxmlparser%2FDocTypeReader.js","contents_url":"https://api.github.com/repos/NaturalIntelligence/fast-xml-parser/contents/src%2Fxmlparser%2FDocTypeReader.js?ref=870043e75e78545192bc70950c6286d36c7cdf23","patch":"@@ -34,7 +34,8 @@ export default class DocTypeReader {\n                                     `Entity count (${entityCount + 1}) exceeds maximum allowed (${this.options.maxEntityCount})`\n                                 );\n                             }\n-                            const escaped = entityName.replace(/[.\\-+*:]/g, '\\\\.');\n+                           