for(const mode of ['extra','missing-marker','missing-outcome','manifest-path'])await check('artifact-allowlist-'+mode,async()=>{const dir=path.join(TEMP,mode,path.basename(valid));fs.mkdirSync(path.dirname(dir));fs.cpSync(valid,dir,{recursive:true});if(mode==='extra')fs.writeFileSync(path.join(dir,'secret.txt'),'synthetic');if(mode==='missing-marker')fs.unlinkSync(path.join(dir,'memoryos-ci-complete.json'));if(mode==='missing-outcome')fs.unlinkSync(path.join(dir,'policy-outcome.json'));if(mode==='manifest-path'){const p=path.join(dir,'memoryos-ci-artifacts.json'),v=JSON.parse(fs.readFileSync(p));v.files[0].path='../escape';fs.writeFileSync(p,J(v));}await assert.rejects(verifyBundle(dir,manifest),e=>e.code==='MO1306_BUNDLE_INTEGRITY');return {observed:'MO1306_BUNDLE_INTEGRITY'};});
