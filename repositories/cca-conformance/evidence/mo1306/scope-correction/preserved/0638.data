const ROOT=path.resolve(fileURLToPath(new URL('../../../../',import.meta.url))),OUT=path.join(ROOT,'repositories/cca-conformance/evidence/mo1306/phase3cr'),TEMP=path.join(OUT,'security-tamper'),PKG=path.join(ROOT,'repositories/memoryos-ci');fs.mkdirSync(TEMP);const manifest=verifyDistribution(),rows=[];const native=JSON.parse(fs.readFileSync(path.join(OUT,'security-native.json'))).cases;const valid=path.join(ROOT,native.find(x=>x.name==='pass').bundle);const source=fs.readFileSync(path.join(PKG,'src/verification.mjs'),'utf8');let helperCalls=0;
function artifact(file){const b=fs.readFileSync(file);return {path:path.relative(ROOT,file).replaceAll('\\','/'),byteLength:b.length,sha256:digest(b)};}
function save(){fs.writeFileSync(path.join(OUT,'security-finish.json'),J({baseline:'9e1bbff99c23cdbc4c80f11e87eadb89a36e8f44',status:rows.some(r=>r.status==='FAIL')?'FAIL':'IN_PROGRESS',harness:artifact(fileURLToPath(import.meta.url)),verificationSource:artifact(path.join(PKG,'src/verification.mjs')),rows,scope:'Exact-source verifier logic with only PowerShell checkPaths replaced by recorded no-op. readChecked, schema, cross-links and SDK normative verification are real. Filesystem helper separately executed in native audit; tamper rejection must be BUNDLE_INTEGRITY or SEMANTIC_INTEGRITY, never timeout.'}));}
async function check(id,fn){try{const details=await fn();rows.push({id,status:'PASS',...(details?{details}:{})});}catch(e){rows.push({id,status:'FAIL',error:String(e.stack||e)});save();throw e;}save();process.stdout.write(id+' PASS\n');}
async function synthetic(exports,id){const names=Object.keys(exports),m=new vm.SyntheticModule(names,function(){for(const n of names)this.setExport(n,exports[n]);},{identifier:id});await m.link(()=>{});await m.evaluate();return m;}
const entry=pathToFileURL(path.join(PKG,'src/verification.mjs')).href;const imports=new Map();
const verifier=new vm.SourceTextModule(source,{identifier:entry,initializeImportMeta(meta){meta.url=entry;},importModuleDynamically:async specifier=>synthetic(await import(new URL(specifier,entry)),specifier)});
await verifier.link(async specifier=>{if(!imports.has(specifier)){const resolved=specifier.startsWith('node:')?specifier:new URL(specifier,entry).href;const exports=await import(resolved);imports.set(specifier,await synthetic(specifier==='./filesystem.mjs'?{...exports,checkPaths:async paths=>{helperCalls++;assert.ok(paths.every(p=>typeof p.path==='string'&&p.allowMissingLeaf===false));}}:exports,resolved));}return imports.get(specifier);});await verifier.evaluate();const verifyBundle=verifier.namespace.verifyBundle;
await check('positive-complete-bundle-verifier-logic',async()=>{const r=await verifyBundle(valid,manifest);assert.equal(r.result.classification,'PASS');assert.equal(helperCalls,1);});
function repair(dir){const mp=path.join(dir,'memoryos-ci-artifacts.json'),m=JSON.parse(fs.readFileSync(mp));for(const row of m.files){const b=fs.readFileSync(path.join(dir,row.path));row.byteLength=b.length;row.sha256=digest(b);}fs.writeFileSync(mp,J(m));const cp=path.join(dir,'memoryos-ci-complete.json'),c=JSON.parse(fs.readFileSync(cp));c.manifestSha256=digest(fs.readFileSync(mp));fs.writeFileSync(cp,J(c));}
const tamper=[['result-exit','memoryos-ci-result.json',v=>v.process.exitCode=6],['run-cross-link','memoryos-ci-evidence.json',v=>v.runId='00000000-0000-4000-8000-000000000000'],['projection-cross-link','memoryos-ci-evidence.json',v=>v.projectionSha256='sha256:'+'0'.repeat(64)],['distribution-cross-link','memoryos-ci-evidence.json',v=>v.distributionSha256='sha256:'+'0'.repeat(64)],['adapter-cross-link','memoryos-ci-evidence.json',v=>v.adapter.sha256='sha256:'+'0'.repeat(64)],['runtime-cross-link','memoryos-ci-evidence.json',v=>v.runtime.nodeSha256='sha256:'+'0'.repeat(64)],['inputs-cross-link','memoryos-ci-evidence.json',v=>v.inputs[0].sha256='sha256:'+'0'.repeat(64)],['unknown-field','memoryos-ci-evidence.json',v=>v.unknown=true],['normative-identity','evaluation-identity.json',v=>v.unknown=true],['normative-outcome','policy-outcome.json',v=>v.unknown=true]];
