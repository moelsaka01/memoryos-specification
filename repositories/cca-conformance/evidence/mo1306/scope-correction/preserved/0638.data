for(const [zone,language,now,folder]of [['UTC','C',0,'pass'],['Pacific/Honolulu','tr-TR',2000000000000,'fail'],['Asia/Dubai','de-DE',-1000000,'cne']])await check('metamorphic-'+zone.replace('/','-'),()=>{const prior={cwd:process.cwd(),TZ:process.env.TZ,LANG:process.env.LANG,LC_ALL:process.env.LC_ALL,now:Date.now};try{process.env.TZ=zone;process.env.LANG=language;process.env.LC_ALL=language;Date.now=()=>now;process.chdir(path.join(OUT,'security-work',folder));const observed=delegate(request,sdk,mip);assert.equal(observed.evaluationIdentityBase64,normative.evaluationIdentityBase64);assert.equal(observed.outcomeBase64,normative.outcomeBase64);}finally{process.chdir(prior.cwd);Date.now=prior.now;for(const key of ['TZ','LANG','LC_ALL'])prior[key]===undefined?delete process.env[key]:process.env[key]=prior[key];}return {timezone:zone,locale:language,dateNow:now,workingDirectory:folder,scope:'Direct SDK delegation over identical input bytes under perturbed ambient path/time/locale; fixed WorkerRequest excludes provider metadata'};});
