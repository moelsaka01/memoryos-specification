{"allLogMembersRead":[{"byteLength":42130,"name":"0_MemoryOS CI.txt","relevantLines":[{"line":16,"text":"2026-09-27T23:06:34.6821785Z Image: windows-2022"},{"line":17,"text":"2026-09-27T23:06:34.6822289Z Version: 20260920.314.1"},{"line":389,"text":"2026-09-27T23:07:03.6720307Z {\"code\":\"MO1306_FILESYSTEM_BOUNDARY\",\"kind\":\"MemoryOSCICDDiagnostic\",\"message\":\"The requested operation could not complete.\",\"stage\":\"ACQUISITION\",\"version\":\"1.0.0\"}"},{"line":390,"text":"2026-09-27T23:07:03.7156103Z ##[error]Process completed with exit code 1."},{"line":405,"text":"2026-09-27T23:07:03.9534144Z ##[error]Process completed with exit code 1."}],"sha256":"sha256:cf5a213f0a812990e26264d37ed8b29155930c0682b3aafdc77c0fbb52e6ec98"},{"byteLength":626,"name":"MemoryOS CI/system.txt","relevantLines":[],"sha256":"sha256:7843e96c2fa7dfa8138088a1c16af39cc6c7345ed6a7e69cf8960498b60c26a4"},{"byteLength":2138,"name":"MemoryOS CI/1_Set up job.txt","relevantLines":[{"line":16,"text":"2026-09-27T23:06:34.6821781Z Image: windows-2022"},{"line":17,"text":"2026-09-27T23:06:34.6822286Z Version: 20260920.314.1"}],"sha256":"sha256:a938c80d77028e5b2a20c1c76a17f3b051cab29d5682ced2b623a6629216a10e"},{"byteLength":15101,"name":"MemoryOS CI/2_Run actions_checkout@3d3c42e5aac5ba805825da76410c181273ba90b1.txt","relevantLines":[],"sha256":"sha256:9bd4cacc97f60c7124e5c5a992eff82586f35cffaa7763370709539f55d70f27"},{"byteLength":15222,"name":"MemoryOS CI/3_Run actions_checkout@3d3c42e5aac5ba805825da76410c181273ba90b1.txt","relevantLines":[],"sha256":"sha256:ab6cdddff99c9b40bbf588cd048620ad29a773acd08ff16845d627aef471e0d8"},{"byteLength":2905,"name":"MemoryOS CI/4_Run $ErrorActionPreference = 'Stop'.txt","relevantLines":[],"sha256":"sha256:d4a7970a7bfd2e8d50d2479a7571b804dbb0eea8cf97c00cf507a2d478a49c22"},{"byteLength":1347,"name":"MemoryOS CI/5_Run $ErrorActionPreference = 'Stop'.txt","relevantLines":[{"line":9,"text":"2026-09-27T23:07:03.6720266Z {\"code\":\"MO1306_FILESYSTEM_BOUNDARY\",\"kind\":\"MemoryOSCICDDiagnostic\",\"message\":\"The requested operation could not complete.\",\"stage\":\"ACQUISITION\",\"version\":\"1.0.0\"}"},{"line":10,"text":"2026-09-27T23:07:03.7156073Z ##[error]Process completed with exit code 1."}],"sha256":"sha256:4c65c5e800bf49ca569a927aa8c18f5e05149241f3e6cc149556f9f7e2a5152f"},{"byteLength":1437,"name":"MemoryOS CI/8_Run $ErrorActionPreference = 'Stop'.txt","relevantLines":[{"line":15,"text":"2026-09-27T23:07:03.9534117Z ##[error]Process completed with exit code 1."}],"sha256":"sha256:71d0f4ecf958eca0893e6e030c1db8769f44ae8d4f419b78f712aa38941b667c"},{"byteLength":1971,"name":"MemoryOS CI/15_Post Run actions_checkout@3d3c42e5aac5ba805825da76410c181273ba90b1.txt","relevantLines":[],"sha256":"sha256:c7d5231575a40680af2b2c797d01c2a69d9524cbe65f01a2fb405d501d08d630"},{"byteLength":1971,"name":"MemoryOS CI/16_Post Run actions_checkout@3d3c42e5aac5ba805825da76410c181273ba90b1.txt","relevantLines":[],"sha256":"sha256:45b41db8d8cd78f3372889f6ed3a1e2fead61008f076e8f194b4abf592c1557a"},{"byteLength":62,"name":"MemoryOS CI/17_Complete job.txt","relevantLines":[],"sha256":"sha256:fe94c5b63d54fcd89715116bc524b8fc7d8c48dacc9bb4ebef7e37c1bb6a1f83"}],"callChain":[{"behavior":"Assert workspace/package/config/manifest and fresh runtime paths, verify Node archive/executable/version, then invoke fixed Node bootstrap. The catch at 106-108 emits RUNTIME_INTEGRITY, not the observed code. Reaching Node is a source-control-flow inference, not a directly captured identity measurement.","order":1,"site":"Initialize-GitHubCI.ps1:22-103"},{"behavior":"transportInstallation calls verifyInstallation; verifyNode calls nodePathCheck(process.execPath) at integrity.mjs:15. This is the first source-order site capable of the observed FILESYSTEM_BOUNDARY.","order":2,"site":"scripts/github-transport.mjs:22 -> src/github-transport.mjs:34 -> integrity.mjs:91"},{"behavior":"verifyDistribution maps every thrown error, including CIError filesystem rejections, to RUNTIME_INTEGRITY. An internal distribution scan failure cannot directly explain this diagnostic.","order":3,"site":"integrity.mjs:92,86-88"},{"behavior":"Check Node, package and manifest members. There are 95 paths split 48/47. Generic rejection can arise in path syntax, fixed helper/executable path checks, child creation or output, path response, or the frozen 2000 ms helper deadline. No actual helper ordinal, response or elapsed interval is retained.","order":4,"site":"integrity.mjs:93 -> filesystem.mjs:76-117"},{"behavior":"If installation checks pass, validate the config absolute path, one config helper request, and readChecked config. Its path/reparse/file kind/link checks can emit the same code. The config digest mismatch instead maps CONFIG_INTEGRITY.","order":5,"site":"src/github-transport.mjs:36-38"}],"classification":"UNRESOLVED","correctionJustified":false,"environmentEvidence":{"checkoutTemporaryHomeOnly":"Checkout logs print temporary HOME under D:\\a\\_temp. These step-specific overrides are not a bootstrap HOME/TEMP environment dump.","childEnvironment":"Source returns only validated SystemRoot and WINDIR and removes known libuv-injected parent names. Do not infer ambient HOME/TEMP caused the failure.","derivedValues":["GITHUB_WORKSPACE from checkout working directories and fixed workflow expressions","MEMORYOS_CI_HOME and MEMORYOS_CI_CONFIG from fixed workflow expressions"],"directValues":"Tool/data checkout directories and hosted C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.EXE shell are printed in retained logs.","unobservedAtFailure":["RUNNER_TEMP actual environment value","RUNNER_TOOL_CACHE","RUNNER_WORKSPACE","HOME","USERPROFILE","TEMP","TMP","SystemRoot/WINDIR values passed to any helper"]},"exactFirstFailingOperation":null,"exactRejectedPath":null,"excludedDirectOrigins":[{"reason":"PowerShell bootstrap catch emits MO1306_RUNTIME_INTEGRITY with INTEGRITY stage.","site":"Initialize-GitHubCI.ps1:106-108"},{"reason":"The complete distribution verification catch maps errors to RUNTIME_INTEGRITY.","site":"integrity.mjs:86-88"},{"reason":"Pinned distribution mismatch maps RUNTIME_INTEGRITY.","site":"src/github-transport.mjs:35"},{"reason":"Normalized config mismatch maps CONFIG_INTEGRITY.","site":"src/github-transport.mjs:38 digest mismatch"},{"reason":"Evaluation step was skipped. No semantic worker or product bundle was produced.","site":"Evaluation and publication"}],"firstObservableFailure":"Canonical Node diagnostic emitted while the bootstrap call invokes scripts/github-transport.mjs. The public diagnostic intentionally omits source stack, operands, raw exception, helper response, ordinal and timing.","frozenRootModel":{"authority":"docs/mo1306-contract-freeze-1.md sections 11,13,16.5","containment":"Canonical Windows relative containment is required for workspace-relative input/output. Config is not required to be inside candidate workspace.","crossDrive":"The frozen rules do not require candidate, trusted roots and SystemRoot to share a drive. Ordinary local NTFS and per-path reparse constraints still apply.","fullPathCodeUnits":240,"helperDeadlineMs":2000,"helperRequestBytes":16384,"helperResponseBytes":1024,"hostedSeparation":"Tool at _memoryos/tool and data at _memoryos/data are prescribed sibling roots (lines 978-987). Config belongs to tool checkout.","reparse":"Every existing workspace/config/package/runtime/input/temporary/output component must reject reparse points; helper tests literal .NET attributes.","temporary":"Product temporary files are only inside workspace .memoryos-ci/out/<run-id>/.pending. Trusted bootstrap Node runtime under _memoryos/runtime precedes evaluation and is distinct from product temporary publication files.","trustedConfiguration":"Separate explicit trusted read capability that may be outside workspace (lines 498-503).","trustedInstallation":"Package and Node are explicit trusted integrity-checked capabilities. Configuration and installation roots may not be inside the untrusted writable output tree (lines 522-523).","workspace":"Existing local NTFS directory, input root and parent of fixed output root."},"kind":"MemoryOSPhase3AHostedFilesystemContractAudit","localReconstruction":"Pure textual path and request-size reconstruction is in the bound workflow audit. No product, helper or local filesystem simulation was executed by this audit; no hosted certification inference follows.","observedFailure":{"attempt":1,"catalogProjection":{"exitCode":11,"projection":{"class":"ADAPTER_ERROR","jobStatus":"FAILURE"}},"errorCatalogRow":["INPUT_ERROR",11,"ACQUISITION"],"exitDistinction":"The frozen catalog maps the diagnostic to common exit 11; GitHub reports the PowerShell step exit 1. No native exit-code trace exists to establish shell propagation. This discrepancy does not identify the first filesystem rejection.","hostedArtifactCount":0,"jobId":108728221298,"machineCode":"MO1306_FILESYSTEM_BOUNDARY","policyEvaluation":"NOT_STARTED","reportedJobStepExit":1,"runId":36357568243,"stage":"ACQUISITION","step":5,"workflowId":368631903},"observedUtc":"2026-09-28T07:40:40.521297+00:00","ownership":{"certificationScaffoldDefect":"NOT_ESTABLISHED","certificationWorkflowDefect":"NOT_ESTABLISHED","frozenContractConflict":"NOT_ESTABLISHED","githubTransient":"NOT_ESTABLISHED","hostedEnvironmentIncompatibility":"NOT_ESTABLISHED","productionDefect":"NOT_ESTABLISHED"},"pathModel":{"actualDriveFormat":null,"actualFilesystemRelationships":"No canonical realpath/drive-format/attributes were captured. Bootstrap Assert-GitHubPath success is inferred for its checked paths because the Node diagnostic was reached.","actualReparseAttributes":null,"actualResolvedPaths":null,"driveObserved":"D: for tool/data checkout; C: in the hosted PowerShell path.","expectedRelationships":"Sibling tool and data; config/package under tool; fresh Node runtime sibling; product output would be below candidate data.","normalization":"Textually ordinary drive-qualified paths, with path lengths and request bounds validated by the separate pure Python workflow audit. This cannot prove filesystem state.","rootProvenance":"Tool/data checkout working-directory lines directly show D: paths. The shared workspace and other roots are derived by exact C3CB script/workflow composition; actual final realpaths were not printed. See bound workflow-path-audit.json for precise per-value provenance.","roots":{"candidateData":"D:\\a\\memoryos-specification\\memoryos-specification\\_memoryos\\data","configuration":"D:\\a\\memoryos-specification\\memoryos-specification\\_memoryos\\tool\\repositories\\cca-conformance\\fixtures\\mo1306\\evaluate-policy-pass\\memoryos-ci.json","githubWorkspace":"D:\\a\\memoryos-specification\\memoryos-specification","node":"D:\\a\\memoryos-specification\\memoryos-specification\\_memoryos\\runtime\\node.exe","nodeArchive":"D:\\a\\memoryos-specification\\memoryos-specification\\_memoryos\\runtime\\node-v24.21.0-win-x64.zip","package":"D:\\a\\memoryos-specification\\memoryos-specification\\_memoryos\\tool\\repositories\\memoryos-ci","runtime":"D:\\a\\memoryos-specification\\memoryos-specification\\_memoryos\\runtime","trustedTool":"D:\\a\\memoryos-specification\\memoryos-specification\\_memoryos\\tool"}},"preflight":{"byteLength":6182,"path":"repositories/cca-conformance/evidence/mo1306/phase3a-hosted-resolution/remote-preflight.json","sha256":"sha256:bf9ea50c3c19a0fc4c6ac00845db8939b65076805665c9f44f81717bbd4d403a"},"productionAuthority":"701d48ee2012675966360dda775ab13013c09ab9","rawWindowsOrNodeError":null,"recommendation":"Stop under user section 33 with MO-1306 PHASE 3A HOSTED BOOTSTRAP UNRESOLVED. Preserve the failed run and native certification; do not retry or weaken rules. The missing causal observations prevent an evidence-based owner classification.","remainingUnobservedBranches":["Node absolute-path normalization, ancestor symbolic-link/type check or realpath equality at verifyNode.","A later path check of the trusted helper file or fixed SystemRoot PowerShell executable.","Helper child spawn error, stderr, oversized/noncanonical/unparseable response, nonzero exit or safe:false.","Frozen helper execution deadline rejected at timer delivery or close-time elapsed checks.","Inside the PowerShell helper: DriveInfo format other than NTFS, metadata exception, reparse bit, ancestor kind or full-path normalization. These all collapse to safe:false and exit 1.","The subsequent config path/helper/readChecked branch, including a nonregular or multiply-linked config file."],"retainedLogArchive":{"byteLength":20701,"path":"repositories/cca-conformance/evidence/mo1306/phase3a-certification/github/campaign-20260927T230612Z/runs/36357568243/logs.zip","sha256":"sha256:06ad4ddbbbc892dffecff8566c09402869adecf9cc850499eb34e802ed7945ad"},"runnerImageDocumentation":{"access":"Read-only official pinned image documentation via web tool","filesystemTermsFound":[],"limitation":"The README does not document actual D: DriveFormat, reparse state or this runner instance. No ReFS/Dev Drive/NTFS claim is inferred from the image label or drive letter.","reportedImageVersion":"20260920.314.1","reportedOsBuild":"10.0.20348 Build 5622","url":"https://github.com/actions/runner-images/blob/win22/20260920.314/images/windows/Windows2022-Readme.md"},"scope":{"helperExecutions":0,"hostedDispatches":0,"mode":"Read-only exact source and retained evidence audit","nativeExecutions":0,"oldEvidenceChanges":0,"productExecutions":0,"productionChanges":0},"sources":[{"byteLength":105372,"excerpts":[{"endLine":546,"startLine":498,"text":"The absolute `--workspace` is one existing, local NTFS directory selected by\nthe trusted caller; it is canonicalized once and is the input root and parent\nof the fixed output root. The config file is a separate explicit trusted read\ncapability; only that file, not its directory contents, may be acquired outside\nthe workspace. The package and Node paths are trusted, integrity-checked\ninstallation capabilities, never selected by input/config/provider metadata.\nThe worker's current directory is the trusted package root; parent acquisition\ndoes not depend on the caller's current directory.\n\n`RelativeFile` uses forward slash separated nonempty segments, <=240 ASCII\ncharacters total. Each segment is 1\u2013100 characters from letters, digits,\nspace, `_`, `-`, `.`; no leading/trailing space, trailing dot, `.`/`..` segment,\nreserved DOS device basename (including extension), case-folded collision,\nempty/repeated separator, wildcard or output-root reference. Inputs must be\ndistinct paths; Policy/Set cannot alias either MIP. Identical baseline/candidate\ncontent is allowed in distinct files. Absolute paths in config are forbidden.\n\nLaunch absolute paths must be drive-qualified local paths with ordinary\nsegments; every resolved full path is <=240 UTF-16 code units. Root directories\nmay contain spaces and Unicode, but not controls,\nquotes or shell/expression delimiters. Reject drive-relative `C:foo`, rooted\n`\\foo`, UNC, extended/device namespaces (`\\\\?\\`, `\\\\.\\`), volume-device\npaths, ADS (`:` except the drive colon), `..`, trailing-dot/space and reserved\ndevice names. Resolve containment on full canonical paths with Windows case\nrules, never string-prefix-only checks. Config/installation roots cannot lie\ninside the untrusted workspace's writable output tree.\n\nReject symlinks, junctions and **all** reparse points on every existing component\nof workspace, config, package, runtime, input, temporary and output paths.\nRequire regular input files, link count one, bounded size, and stable identity,\nlength and write metadata before/after read; detect swaps and fail. Check\noutput ancestors again before each publication operation. Node `lstat` alone\nis insufficient to claim detection of every Windows reparse type. The package\ntherefore contains a fixed `scripts/check-paths.ps1` helper which only reads\nWindows `FileAttributes.ReparsePoint` and component/type information using\nliteral .NET paths. The core invokes the absolute Windows PowerShell executable\nwith direct argv, `-NoProfile -NonInteractive -EncodedCommand <fixed-code>`,\nwhere fixed-code is the verified helper's UTF-8 text encoded as UTF-16LE then\nbase64, with no input substitution. This runs fixed trusted code without changing\nmachine execution policy; it is not an arbitrary script API. Private stdin is\none request `{kind:\"MemoryOSCICDPathCheckRequest\",version:\"1.0.0\",\npaths:[{path:AbsolutePath,allowMissingLeaf:boolean}]}`, 1\u201364 entries; the helper\nchecks every ancestor and permits a missing final leaf only when the caller\nexplicitly marked a future output leaf. Inputs use false. The caller\nstill enforces input existence/type with Node. Never embed path text in\nPowerShell code. Closed helper response: `{kind:\"MemoryOSCICDPathCheck\",\nversion:\"1.0.0\",safe:boolean}`; helper failure/unknown attributes fail closed.\nIts <=16384-byte request, <=1024-byte response and <=2000 ms execution fit\nthe overall deadline. No user-provided scripts or bypass policy flags."},{"endLine":563,"startLine":550,"text":"for the invocation. An attacker with concurrent host write/debug privileges is\noutside the boundary. This is not a kernel sandbox or an atomic no-follow\nguarantee against privileged concurrent namespace replacement. Snapshot bytes\nand fail-closed rechecks are mandatory even with that precondition.\n\nCreate run directories exclusively, with no reuse. Temporary files are only\nunder `.memoryos-ci/out/<RunId>/.pending/`; use fixed basenames and exclusive\nopens. Never use shared OS temp, repository `.git`, user home or unrelated\npaths. Remove only this invocation's known temporary files/directories after\nrechecking containment and attributes. Keep incomplete attempt files when\nfailure diagnosis requires them; no completion marker means not published.\nDo not recursively delete arbitrary directory trees or clean previous runs.\nOn forced host interruption, later invocations ignore stale incomplete runs;\nthe operator may explicitly clean them outside evaluation. Input files and"},{"endLine":636,"startLine":628,"text":"Construct a fresh child environment containing only validated Windows\n`SystemRoot` and `WINDIR`; no PATH, TEMP, HOME, NODE_OPTIONS, NODE_PATH,\npreload flags, proxy, token, provider metadata or inherited `execArgv`.\nUse anonymous pipes, bounded writes/read buffers and explicit EOF; no public\nport. The fixed Windows filesystem helper uses the same environment and is\nnever concurrent with the semantic child. **Correction A:** the whole attributable\nWindows tree has at most three role-bound processes: the pinned Node supervisor,\none direct active workload child (the fixed PowerShell filesystem helper OR the\npinned Node semantic worker), and at most one Windows System32/conhost.exe"},{"endLine":989,"startLine":974,"text":"Step IDs are respectively `tools`, `data`, `bootstrap`, `evaluate`, `upload`,\n`gate`. The tool repository must be the workflow repository or an existing\npublic repository accessible without an extra secret; cross-private-repository\ncredentials are outside v1.\n\n1. Pinned checkout of `deployment.options.repository` at `toolRevision` into\n   `_memoryos/tool`, credentials not persisted, submodules/LFS disabled.\n2. Pinned checkout of the current workflow repository at `${{ github.sha }}`\n   into `_memoryos/data`, same protections; treat it solely as data.\n3. Fixed bootstrap downloads only the pinned Node ZIP, verifies hash/length\n   and extraction entries, verifies Node and the trusted package manifest,\n   and locates `repositories/memoryos-ci` and the pinned config under tool.\n4. Evaluate with literal `github`, workspace `_memoryos/data` and trusted\n   bootstrap variables. Capture exit and verify the complete bundle. Emit only\n   allowlisted `GITHUB_OUTPUT` values `complete=true|false`, `exit-code=<integer>`\n   and `run-id=<RunId>`; no input/metadata expression enters shell text."}],"path":"docs/mo1306-contract-freeze-1.md","revision":"701d48ee2012675966360dda775ab13013c09ab9","sha256":"sha256:8414e4d21432c9613798e4d6ad46349104f615a3f65eb3ab743d58b43d9ea85c"},{"byteLength":7107,"excerpts":[{"endLine":22,"startLine":11,"text":"export function verifyNode({launch=true}={}) {\n  if(process.versions.node!=='24.21.0'||process.platform!=='win32'||process.arch!=='x64')failure();\n  if(launch && (process.execArgv.length!==1 || process.execArgv[0]!=='--max-old-space-size=128'))failure();\n  if(process.env.NODE_OPTIONS || process.env.NODE_PATH || process.env.NODE_INSPECT_RESUME_ON_START || process.env.NODE_REPL_EXTERNAL_MODULE)failure();\n  const full=nodePathCheck(process.execPath),before=fs.lstatSync(full,{bigint:true});\n  if(!before.isFile()||before.nlink!==1n||before.size!==93580104n)failure();\n  const fd=fs.openSync(full,'r'),buffer=Buffer.alloc(65536),hash=createHash('sha256');let count;\n  try {\n    if(!sameFile(before,fs.fstatSync(fd,{bigint:true})))failure();\n    while((count=fs.readSync(fd,buffer,0,buffer.length,null))>0)hash.update(buffer.subarray(0,count));\n    if('sha256:'+hash.digest('hex')!==nodeDigest||!sameFile(before,fs.fstatSync(fd,{bigint:true}))||!sameFile(before,fs.lstatSync(full,{bigint:true})))failure();\n  } finally {fs.closeSync(fd);}"},{"endLine":95,"startLine":86,"text":"export function verifyDistribution(root=packageRoot,provider='generic') {\n  try { return readDistribution(root,provider); }\n  catch { failure(); } // Every trusted installation defect maps to integrity exit 15.\n}\nexport async function verifyInstallation(options,provider='generic') {\n  verifyNode();\n  const verified=verifyDistribution(packageRoot,provider);\n  await checkPaths([{path:process.execPath,allowMissingLeaf:false},{path:packageRoot,allowMissingLeaf:false},...verified.manifest.files.map(row=>({path:path.join(packageRoot,row.path),allowMissingLeaf:false}))],options);\n  return verified;\n}"}],"path":"repositories/memoryos-ci/src/integrity.mjs","revision":"701d48ee2012675966360dda775ab13013c09ab9","sha256":"sha256:6321e4d7fb699648e4ece9d42ccfeb2664087286fdb02cf30e429a2a525f8b88"},{"byteLength":7671,"excerpts":[{"endLine":42,"startLine":13,"text":"export function absolutePath(value, code='FILESYSTEM_BOUNDARY') {\n  if (typeof value !== 'string' || value.length > 240 || !/^[A-Za-z]:[\\\\/]/.test(value) || /[:\\x00-\\x1f\\x7f\"'\\x60$;|&<>{}\\[\\]()!*?]/.test(value.slice(2))) reject(code);\n  const ordinary = value.replaceAll('/','\\\\');\n  const root = path.parse(ordinary).root;\n  const parts = ordinary.slice(root.length).split('\\\\');\n  if (ordinary !== root && parts.some(p => !p || p === '.' || p === '..' || /^[ ]|[ .]$/.test(p) || reserved.test(p))) reject(code);\n  const resolved = path.resolve(ordinary);\n  if (resolved.toLowerCase() !== ordinary.toLowerCase()) reject(code);\n  return resolved;\n}\nexport function contained(root, relative) {\n  relativeFile(relative);\n  const full = absolutePath(path.resolve(root,relative));\n  const child = path.relative(root,full);\n  if (!child || child.startsWith('..') || path.isAbsolute(child)) reject('FILESYSTEM_BOUNDARY');\n  return full;\n}\nexport function childEnvironment() {\n  const systemRoot = absolutePath(process.env.SystemRoot ?? '', 'RUNTIME_INTEGRITY');\n  const windir = absolutePath(process.env.WINDIR ?? '', 'RUNTIME_INTEGRITY');\n  if (systemRoot.toLowerCase() !== windir.toLowerCase()) reject('RUNTIME_INTEGRITY');\n  // libuv injects these fixed Windows variables from its parent if omitted.\n  // Delete by fixed name without reading or enumerating ambient values.\n  for (const name of ['HOMEDRIVE','HOMEPATH','LOGONSERVER','PATH','SYSTEMDRIVE','TEMP','USERDOMAIN','USERNAME','USERPROFILE']) {\n    // Windows can inherit multiple differently cased entries for the same name.\n    // One deletion can expose the next entry. Inspect presence only, never values.\n    for (let attempts=0; attempts<8 && Object.hasOwn(process.env,name); attempts++) delete process.env[name];\n    if (Object.hasOwn(process.env,name)) reject('RUNTIME_INTEGRITY');\n  }\n  return {SystemRoot:systemRoot,WINDIR:windir};"},{"endLine":73,"startLine":45,"text":"export function nodePathCheck(value, allowMissingLeaf=false) {\n  const full = absolutePath(value);\n  const parsed = path.parse(full); const parts = full.slice(parsed.root.length).split(path.sep).filter(Boolean);\n  let current = parsed.root;\n  for (const [i,part] of parts.entries()) {\n    current = path.join(current,part);\n    let stat;\n    try { stat = fs.lstatSync(current); }\n    catch(e) { if (e.code === 'ENOENT' && allowMissingLeaf && i === parts.length-1) return full; throw e; }\n    if (stat.isSymbolicLink() || (i < parts.length-1 && !stat.isDirectory())) reject('FILESYSTEM_BOUNDARY');\n  }\n  if (fs.realpathSync(full).toLowerCase() !== full.toLowerCase()) reject('FILESYSTEM_BOUNDARY');\n  return full;\n}\nexport function readChecked(value, maximum, {readCode='INPUT_READ',limitCode='INPUT_LIMIT',changeCode='INPUT_CHANGED'}={}) {\n  const full = absolutePath(value);\n  let before,fd;\n  try {\n    nodePathCheck(full); before = fs.lstatSync(full,{bigint:true});\n    if (!before.isFile() || before.nlink !== 1n) reject('FILESYSTEM_BOUNDARY');\n    if (before.size > BigInt(maximum)) reject(limitCode);\n    fd = fs.openSync(full,'r');\n    if (!sameFile(before,fs.fstatSync(fd,{bigint:true}))) reject(changeCode);\n    const bytes = Buffer.alloc(Number(before.size)+1); let length=0,count;\n    while (length < bytes.length && (count=fs.readSync(fd,bytes,length,bytes.length-length,length)) > 0) length+=count;\n    if (length !== Number(before.size) || !sameFile(before,fs.fstatSync(fd,{bigint:true})) || !sameFile(before,fs.lstatSync(full,{bigint:true}))) reject(changeCode);\n    return bytes.subarray(0,length);\n  } catch(error) { if (error instanceof CIError) throw error; reject(readCode); }\n  finally { if (fd !== undefined) fs.closeSync(fd); }"},{"endLine":117,"startLine":76,"text":"export async function checkPaths(paths, {deadline=Infinity,signal}={}) {\n  for (const entry of paths) absolutePath(entry.path);\n  for (let start=0;start<paths.length;start+=48) {\n    if (signal?.aborted) reject('CANCELLED');\n    const remaining = deadline-performance.now();\n    if (remaining <= 0) reject('OVERALL_TIMEOUT');\n    const request = J({kind:'MemoryOSCICDPathCheckRequest',version:'1.0.0',paths:paths.slice(start,start+48)});\n    if (Buffer.byteLength(request)>16384) reject('FILESYSTEM_BOUNDARY');\n    const env=childEnvironment();\n    const helper=readChecked(path.join(packageRoot,'scripts/check-paths.ps1'),32768,{readCode:'RUNTIME_INTEGRITY'});\n    const exe=nodePathCheck(path.join(env.SystemRoot,'System32/WindowsPowerShell/v1.0/powershell.exe'));\n    await new Promise((resolve,rejectPromise) => {\n      let output=Buffer.alloc(0), terminal=null, timer, reap;\n      const helperDeadline=performance.now()+2000;\n      const effectiveDeadline=Math.min(deadline,helperDeadline);\n      const timeoutCode=deadline<=helperDeadline?'OVERALL_TIMEOUT':'FILESYSTEM_BOUNDARY';\n      if(performance.now()>=effectiveDeadline)reject(timeoutCode);\n      const child=spawn(exe,['-NoProfile','-NonInteractive','-EncodedCommand',helper.toString('utf8') && Buffer.from(helper.toString('utf8'),'utf16le').toString('base64')],{env,cwd:packageRoot,shell:false,windowsHide:true,stdio:['pipe','pipe','pipe']});\n      const stop=code=>{ if(terminal)return;terminal=new CIError(code);child.stdin.destroy();child.kill();reap=setTimeout(()=>rejectPromise(new CIError('CLEANUP_FAILED')),2000); };\n      const cancel=()=>stop('CANCELLED');\n      signal?.addEventListener('abort',cancel,{once:true});\n      timer=setTimeout(()=>stop(timeoutCode),Math.max(0,effectiveDeadline-performance.now()));\n      child.on('error',()=>stop('FILESYSTEM_BOUNDARY'));\n      child.stdout.on('data',data=>{if(terminal)return;if(output.length+data.length>1024)stop('FILESYSTEM_BOUNDARY');else output=Buffer.concat([output,data]);});\n      child.stderr.on('data',()=>stop('FILESYSTEM_BOUNDARY'));\n      child.stdin.on('error',()=>{});\n      child.on('close',code=>{\n        clearTimeout(timer);clearTimeout(reap);signal?.removeEventListener('abort',cancel);\n        if(terminal)return rejectPromise(terminal);\n        try {\n          // Timer delivery can lag real close delivery. Cleanup is never success grace.\n          if(performance.now()>=effectiveDeadline)reject(timeoutCode);\n          const response=parseJSON(output,1024,'FILESYSTEM_BOUNDARY');\n          if(code!==0 || J(response)!==output.toString('utf8') || Object.keys(response).sort().join(',')!=='kind,safe,version' || response.kind!=='MemoryOSCICDPathCheck' || response.version!=='1.0.0' || response.safe!==true)reject('FILESYSTEM_BOUNDARY');\n          if(signal?.aborted)reject('CANCELLED');\n          if(performance.now()>=effectiveDeadline)reject(timeoutCode);\n          resolve();\n        } catch(e) { rejectPromise(e); }\n      });\n      child.stdin.end(request);\n    });\n  }"}],"path":"repositories/memoryos-ci/src/filesystem.mjs","revision":"701d48ee2012675966360dda775ab13013c09ab9","sha256":"sha256:f7c9d28ba2761c6987b7a0be40bdfaa73278996b9974267562900c817e185dc9"},{"byteLength":4106,"excerpts":[{"endLine":39,"startLine":32,"text":"export async function transportInstallation(configurationDigest,distributionDigest,options={}) {\n  if(!/^sha256:[a-f0-9]{64}$/.test(configurationDigest)||!/^sha256:[a-f0-9]{64}$/.test(distributionDigest))reject('CONFIG_INTEGRITY');\n  const installation=await verifyInstallation(options,'github');\n  if(installation.identities.distributionDigest!==distributionDigest)reject('RUNTIME_INTEGRITY');\n  const config=absolutePath(process.env.MEMORYOS_CI_CONFIG??'');\n  await checkPaths([{path:config,allowMissingLeaf:false}],options);\n  if(digest(J(configuration(readChecked(config,16384))))!==configurationDigest)reject('CONFIG