import datetime,hashlib,json,subprocess,sys
from pathlib import Path
R=Path(__file__).resolve().parents[4];T=Path(__file__).resolve().parent;E=R/'repositories/cca-conformance/evidence/mo1306/phase3a-certification'
C3CB='701d48ee2012675966360dda775ab13013c09ab9';M3='85a0f85c1ebd013c545ccf2b3efe58a760e6cf37';H='f6e181ae330c8f884f5b9737f71f546eb2494201';OLD='f236c4a2f94d8cd8e763aaa4bd6c52d703429692';REMOTE_MAIN='5955af062152a84c10de17860ba0bcabe8b3555f';SCAFFOLD='451599e7b95a537ebc2daac627b061fd88791dea'
def read(p):return json.loads(p.read_bytes())
def row(p):
 b=p.read_bytes();return {'path':p.relative_to(R).as_posix(),'byteLength':len(b),'sha256':'sha256:'+hashlib.sha256(b).hexdigest()}
def put(p,v):
 with p.open('x',encoding='utf-8',newline='\n') as f:f.write(json.dumps(v,sort_keys=True,separators=(',',':'))+'\n')
def git(*a):return subprocess.check_output(['git',*a],cwd=R).decode().strip()
assert sys.argv[1:]==['--close-blocked'];assert git('rev-parse','HEAD')==OLD
assert read(E/'native-final-gate.json')['status']=='PASS'
blocked=read(E/'github/hosted-blocked-summary.json');remote=read(E/'github/final-state-blocked.json');assert blocked['status'] in ['BLOCKED','HOSTED_CERTIFICATION_BLOCKED'] and remote['status']=='PASS'
campaign=E/'github/campaign-20260927T230612Z';c=read(campaign/'campaign-summary.json');run=read(campaign/'runs/36357568243/run.json');job=read(campaign/'runs/36357568243/jobs.json')['jobs'][0]
assert c['status']=='BLOCKED' and c['restoration']['status']=='PASS' and c['restoration']['defaultBranch']=='main' and run['conclusion']=='failure'
assert read(E/'github/hosted-receipt-disposition.json')['status'] in ['BLOCKED','HOSTED_CERTIFICATION_BLOCKED','PASS','RECORDED']
assert not git('diff','--name-only') and not git('diff','--cached','--name-only')
assert not (R/'.cache/mo1306-phase3a-certification/final-commit.json').exists()
for r in read(E/'preservation-before.json')['files']:assert row(R/r['path'])==r
p=subprocess.run([sys.executable,'-B','tools/verify_workspace.py','--root',str(R)],cwd=R,capture_output=True,timeout=120);assert p.returncode==0,p.stderr.decode()
diff=subprocess.run(['git','diff','--check'],cwd=R,capture_output=True);assert diff.returncode==0
finished=datetime.datetime.now(datetime.timezone.utc);started=datetime.datetime.fromisoformat(read(E/'task-context.json')['startedUtc']);duration=(finished-started).total_seconds()
workspace={'kind':'MemoryOSPhase3ABlockedWorkspaceVerification','status':'PASS','observedUtc':finished.isoformat(),'head':OLD,'branch':git('branch','--show-current'),'workspaceExitCode':p.returncode,'workspaceStdout':p.stdout.decode(),'workspaceStderr':p.stderr.decode(),'diffCheckExitCode':diff.returncode,'diffCheckScope':'Tracked working tree and index. Untracked evidence is preserved, not committed.','trackedChanges':False,'stagedChanges':False,'porcelain':git('status','--porcelain=v1','--untracked-files=normal'),'historicalFilesPreserved':758,'authoritativeCertificationCommitCreated':False,'postcommitChecks':'NOT_APPLICABLE_NO_CERTIFICATION_COMMIT'}
put(E/'workspace-blocked.json',workspace)
