text=(ROOT/'.github/workflows/memoryos-policy-gate.yml').read_text();assert 'MemoryOS Policy Gate' in text
assert all(p['path']!='.github/workflows/memoryos-ci.yml' for p in rows)
a['put']('mo1302-preservation.json',{'status':'PASS','baseline':a['C3AB'],'releasedTag':'memoryos-1.3-mo1302','releasedCommit':a['git']('rev-parse','memoryos-1.3-mo1302^{}'),'workflowAndContractFiles':rows,'requiredCheck':'memoryos-policy-gate / MemoryOS Policy Gate','releasedActionFiles':43,'selectedRegressionTests':4,'scope':'Exact released action directory plus four released workflow files and gate contract unchanged. No execution of historical Ubuntu jobs; new neutral workflow has distinct check identity.'})
