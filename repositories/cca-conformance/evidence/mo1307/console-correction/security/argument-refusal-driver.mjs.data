  row.stdout=put(row.name+'/observer.stdout.data',r.stdout??Buffer.alloc(0));row.stderr=put(row.name+'/observer.stderr.data',r.stderr??Buffer.alloc(0));row.exit=r.status;row.signal=r.signal;row.launchError=r.error?.code??null;
  if(fs.existsSync(path.join(dir,'proof.json'))){row.proof=record(path.join(dir,'proof.json'));row.observation=JSON.parse(fs.readFileSync(path.join(dir,'proof.json')));}
  assert.ifError(r.error);assert.equal(r.signal,null);assert.equal(r.status,0);assert.equal(row.observation?.result,'PASS');assert.equal(row.observation.heldHelperHandle,true);assert.equal(row.observation.helperSignalAtHandleRelease,0);
 });
 for(const simulation of simulations)await run(simulation.name,'EXTRACTED_FUNCTION_NATIVE_DOUBLE',async row=>{
  write(row.name+'/scenario.json',simulation);
  const dir=path.join(E,row.name),proofPath=path.join(dir,'proof.json');
  const args=['-NoLogo','-NoProfile','-NonInteractive','-ExecutionPolicy','Bypass','-File',doubleFile,'-ScenarioPath',path.join(dir,'scenario.json'),'-ExtractedPath',extractedFile,'-ProofPath',proofPath];
  row.engineeringInvocation={executable:launch.executable,args,notProductLaunch:true};
  const r=spawnSync(launch.executable,args,{cwd:root,env:{...launch.options.env},windowsHide:true,shell:false,encoding:null,timeout:15000,maxBuffer:65536});
  row.exit=r.status;row.signal=r.signal;row.launchError=r.error?.code??null;row.stdout=put(row.name+'/stdout.data',r.stdout??Buffer.alloc(0));row.stderr=put(row.name+'/stderr.data',r.stderr??Buffer.alloc(0));
  assert.ifError(r.error);assert.equal(r.signal,null);assert.equal(r.status,simulation.accepted?0:22);
  assert.equal(r.stdout.length,0,'Simulated startup stdout must be silent');assert.equal(r.stderr.length,0,'Simulated startup stderr must be silent');
  const proof=JSON.parse(fs.readFileSync(proofPath));row.proof=record(proofPath);row.observation=proof;
  assert.equal(proof.accepted,simulation.accepted);assert.equal(proof.detached,simulation.detached);assert.equal(proof.productionFunctionUnmodified,true);assert.equal(proof.nativeProcessOperationsPerformed,false);
  if(!simulation.accepted)assert.equal(proof.failure,'MO1307_INTERNAL');
  const calls=proof.events;
  const opens=calls.filter(x=>x.name==='OpenProcess'),closes=calls.filter(x=>x.name==='CloseHandle'),frees=calls.filter(x=>x.name==='FreeConsole');
  assert.equal(closes.length,simulation.opened?1:0,'Every acquired simulated handle closes exactly once');
  assert.ok(opens.length<=1);assert.ok(frees.length<=1);
  for(const x of opens){assert.equal(x.arguments[0],0x101000);assert.equal(x.arguments[1],false);assert.equal(x.arguments[2],42420);}
  for(const x of calls.filter(x=>['GetProcessId','QueryFullProcessImageNameW','WaitForSingleObject','CloseHandle'].includes(x.name)))assert.equal(x.arguments[0],424242,'All identity/wait/disposition use one retained object');
  if(simulation.name==='no-console')assert.deepEqual(calls.map(x=>x.name),['GetConsoleProcessList']);
  if(simulation.name==='valid-optional-host'){
   assert.equal(frees.length,1);assert.equal(calls.filter(x=>x.name==='GetProcessId').length,2);assert.equal(calls.filter(x=>x.name==='GetConsoleWindow').length,2);assert.equal(calls.filter(x=>x.name==='GetWindowThreadProcessId').length,2);
   const live=calls.findIndex(x=>x.name==='WaitForSingleObject'&&x.arguments[1]===0),detach=calls.findIndex(x=>x.name==='FreeConsole'),settled=calls.findIndex(x=>x.name==='WaitForSingleObject'&&x.arguments[1]===1000);
   assert.ok(live>=0&&live<detach&&detach<settled);assert.equal(calls.filter(x=>x.name==='GetConsoleProcessList').length,3);
  }
  if(!simulation.detached&&simulation.name!=='detach-failure')assert.equal(frees.length,0,'Unproved association never detaches');
