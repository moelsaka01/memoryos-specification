 {name:'valid-optional-host',accepted:true,detached:true,opened:true},
 ...['initial-list-error','extra-client','unrelated-sole-client','missing-window','missing-owner','owner-is-helper','access-denied'].map(name=>({name,accepted:false,detached:false,opened:false})),
 ...['opened-pid-replaced','image-query-denied','wrong-image','same-basename-wrong-directory','window-replaced','owner-replaced','client-added-before-detach','sole-client-replaced','rechecked-pid-replaced','held-object-already-exited','liveness-wait-failure','detach-failure'].map(name=>({name,accepted:false,detached:false,opened:true})),
 ...['natural-exit-timeout','natural-exit-wait-failure','client-attaches-after-final-check','final-console-present','final-absence-wrong-error'].map(name=>({name,accepted:false,detached:true,opened:true}))
];
const order=['normal-native-startup','actual-optional-host','owned-parent-interruption',...simulations.map(x=>x.name)];
write('manifest.json',{kind:'MO1307ConsoleCorrectionSecurityManifest',candidate,createdAt:new Date().toISOString(),order,simulations,
 nativeCases:['normal-native-startup','actual-optional-host','owned-parent-interruption'],simulatedCases:simulations.map(x=>x.name),
 sourceBindings:before,toolBindings:['console-security.mjs','console-native-double.ps1','console-parent.mjs','console-parent-observer.py','console-host-observer.py'].map(name=>record(path.join(T,name))),
 extractedFunction:record(extractedFile),actualFunctionTextUnmodified:true,productionCodeInjection:false,
 limits:{helperDeadlineMs:L.helperDeadlineMs,helperAggregateDeadlineMs:L.helperAggregateDeadlineMs,cliDeadlineMs:L.cliDeadlineMs,apiDeadlineMs:L.apiDeadlineMs,cleanupAllowanceMs:L.cleanupAllowanceMs,nativeConsoleNaturalExitWaitMs:1000},
 policy:{once:true,retry:false,stopOnFirstUnexpectedFailure:true,normalRealStartupFirst:true,noBroadKill:true,noPidBasedHelperKill:true,noCertification:true},
 scope:{PIDReplacement:'Deterministic substituted native return values cover rejected discovery/open/revalidation races; no live PID-reuse experiment or universal OS-race proof.',silent22:'Fault processes must produce zero stdout and stderr and exit22 using the exact extracted rejection function plus matching startup disposition.',termination:'Forceful console termination is absent. Natural-exit timeout/wait failure are covered.',deadline:'Constants unchanged; normal native transport uses actual supervisor clocks and frozen helper budget. Fault doubles do not simulate elapsed OS time or certify native failure deadlines.'}});
let failure=null;
async function run(name,kind,action){
 const row={name,kind,result:'FAIL',startedAt:new Date().toISOString()},at=performance.now();
 try{await action(row);assert.deepEqual(sourceBindings(),before,'Production bytes changed during security validation');row.result='PASS';}
 catch(error){row.failure=err(error);throw error;}
 finally{row.elapsedMs=performance.now()-at;rows.push(row);write(name+'/receipt.json',row);}
}
const scratch=path.join(root,'.cache/mo1307-console-correction-security');
const request=()=>({kind:'MemoryOSReadinessHelperRequest',version:'2.0.0',session:randomBytes(32).toString('hex'),sequence:3,operation:'READ_SET',roots:[{id:'input',path:path.join(scratch,'input')}],files:[{id:'small',maxBytes:2097152,path:'small.bin',root:'input'}]});
try{
 assert.equal(fs.existsSync(python),true,'Fixed Python runtime must exist');assert.equal(hash(fs.readFileSync(python)),'sha256:4278cf2a296f31737cae77cafeeb3dc71683094cf3b8fd6f3f02c968687e771c');write('engineering-runtime.json',{python:record(python),node:record(process.execPath),pythonBytecodeDisabled:true});
 assert.equal(process.platform,'win32');assert.equal(process.arch,'x64');assert.equal(process.version,'v24.21.0');
 assert.equal(hash(fs.readFileSync(process.execPath)),'sha256:ba4e6d110e8c1592a1ecd390f6b05f3da124b13871a5be62b341a07a853c6c32');
 const git=spawnSync('C:/Program Files/Git/cmd/git.exe',['-c','safe.directory='+root.replaceAll('\\','/').replace(/\/$/,''),'rev-parse','HEAD'],{cwd:root,windowsHide:true,encoding:'utf8'});
 assert.ifError(git.error);assert.equal(git.status,0,git.stderr);assert.equal(git.stdout.trim(),candidate);
 const candidateTree='d9e5d6e407adb59157ee811c90918c9b065b14e1';
 const gitChecked=(...args)=>{const r=spawnSync('C:/Program Files/Git/cmd/git.exe',['-c','safe.directory='+root.replaceAll('\\','/').replace(/\/$/,''),...args],{cwd:root,windowsHide:true,encoding:'utf8'});assert.ifError(r.error);assert.equal(r.status,0,r.stderr);return r.stdout.trim();};
 assert.equal(gitChecked('rev-parse',candidate+':repositories/memoryos-readiness'),candidateTree);
 gitChecked('diff','--quiet',candidate,'--','repositories/memoryos-readiness');
 assert.equal(hash(fs.readFileSync(helperPath)),'sha256:658db95495072c003a849941af5d92c0761b6aa0f6f08b4911f5022a80da2688');
 assert.equal(hash(fs.readFileSync(path.join(packageRoot,'src/helper-transport.mjs'))),'sha256:2de2ddb25a072ac6f2bf2873a6bdc9f172e41f342f5ba16127c7291906a7cd68');
 write('candidate-binding.json',{candidate,packageTree:candidateTree,workingPackageDiffFromCandidate:false,helper:record(helperPath),transport:record(path.join(packageRoot,'src/helper-transport.mjs')),members:before});
 assert.equal(launch.options.detached,true);assert.equal(launch.options.windowsHide,true);assert.equal(launch.options.shell,false);assert.deepEqual([...launch.options.stdio],['pipe','pipe','pipe']);
 assert.deepEqual({...launch.options.env},{SystemRoot:'C:\\Windows',WINDIR:'C:\\Windows'});
 for(const [name,value]of Object.entries({helperDeadlineMs:5000,helperAggregateDeadlineMs:20000,cliDeadlineMs:30000,apiDeadlineMs:10000,cleanupAllowanceMs:2000}))assert.equal(L[name],value,name);
 assert.doesNotMatch(nativeSource,/@\(\s*'(?:TerminateProcess|CreateToolhelp32Snapshot|Process32FirstW|Process32NextW)'/);
 assert.doesNotMatch(extracted,/\$script:native::(?:TerminateProcess|CreateToolhelp32Snapshot|Process32FirstW|Process32NextW)\s*\(/);
 assert.match(extracted,/OpenProcess\(0x101000,\s*\$false,\s*\$owner\)/);
 assert.match(extracted,/WaitForSingleObject\(\$consoleHandle,\s*1000\)/);
 assert.match(helperText,/Initialize-Native\s*\r?\n\}\s*catch\s*\{\s*exit 22\s*\}/);
 assert.equal(fs.existsSync(scratch),false,'Fresh validation scratch required');fs.mkdirSync(path.join(scratch,'input'),{recursive:true});fs.writeFileSync(path.join(scratch,'input/small.bin'),'{}\n',{flag:'wx'});
 await run('normal-native-startup','REAL_FIXED_PRODUCTION_HELPER',async row=>{
  const req=request(),frame=encodeHelperRequest(req);row.request=put(row.name+'/request.bin',frame);row.launch=launch;
  const sup=createSupervisor({kind:'cli'}),events=[],capture={stdout:[],stderr:[],stdoutBytes:0,stderrBytes:0};let childCount=0,result,problem=null,code=null;
  const transport=createHelperTransportForTesting(sup,(executable,args,options)=>{
   assert.equal(executable,launch.executable);assert.deepEqual(args,[...launch.args]);assert.deepEqual(options,{...launch.options,env:{...launch.options.env},stdio:[...launch.options.stdio]});
   childCount++;const child=spawn(executable,args,options);row.pid=child.pid;
   for(const [label,stream]of [['stdin',child.stdin],['stdout',child.stdout],['stderr',child.stderr]])stream.once('close',()=>events.push({event:'close',stream:label,at:performance.now()}));
   child.stdout.on('data',bytes=>{capture.stdoutBytes+=bytes.length;if(capture.stdoutBytes<=L.helperResponseBytes)capture.stdout.push(Buffer.from(bytes));});
   child.stderr.on('data',bytes=>{capture.stderrBytes+=bytes.length;if(capture.stderrBytes<=L.stderrBytes)capture.stderr.push(Buffer.from(bytes));});
   child.once('close',(exit,signal)=>{code=exit;events.push({event:'process-close',exit,signal,at:performance.now()});});
   return child;
  });
  const at=performance.now();
  try{result=await transport.exchange(frame);}catch(error){problem=error;}
  finally{
   try{await sup.dispose();}catch(error){problem??=error;}
   row.elapsedProductMs=performance.now()-at;row.snapshot=sup.snapshot();row.events=events;row.exitCode=code;
   row.stdout=put(row.name+'/stdout.data',Buffer.concat(capture.stdout));row.stderr=put(row.name+'/stderr.data',Buffer.concat(capture.stderr));row.stdoutTotalBytes=capture.stdoutBytes;row.stderrTotalBytes=capture.stderrBytes;
   row.captureTruncated=capture.stdoutBytes>L.helperResponseBytes||capture.stderrBytes>L.stderrBytes;
  }
  if(problem)throw problem;
  assert.equal(childCount,1);assert.equal(code,0);assert.equal(result.exitConfirmed,true);assert.equal(capture.stderrBytes,0);assert.equal(row.captureTruncated,false);
  const decoded=decodeHelperResponse(result.responseBytes,req);row.response={status:decoded.status,version:decoded.version,sequence:decoded.sequence,operation:decoded.operation,fileCount:decoded.files.length};
  assert.equal(decoded.status,'OK');assert.deepEqual(Buffer.from(decoded.files[0].bytes.join(''),'base64'),Buffer.from('{}\n'));
  assert.equal(row.snapshot.helpers,1);assert.equal(row.snapshot.workers,0);assert.equal(row.snapshot.activeRole,null);assert.equal(row.snapshot.cleanupConfirmed,true);assert.equal(row.snapshot.terminalCode,null);
  assert.ok(row.snapshot.helperUsedMs<5000);assert.ok(row.elapsedProductMs<5000);assert.deepEqual(events.filter(x=>x.event==='close').map(x=>x.stream).sort(),['stderr','stdin','stdout']);
  row.sourceUnmodified=true;row.spawnForwardedUnchanged=true;row.hostProof='Validated production frame proves the helper completed its production console-quiescence gate; no independent observer claims host identity.';
 });
 await run('actual-optional-host','REAL_UNMODIFIED_HELPER_EXPLICIT_NEW_CONSOLE',async row=>{
