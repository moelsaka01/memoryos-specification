fs.mkdirSync(E,{recursive:true});
const hash=bytes=>'sha256:'+createHash('sha256').update(bytes).digest('hex');
const record=file=>{const bytes=fs.readFileSync(file);return{path:path.relative(root,file).replaceAll('\\','/'),byteLength:bytes.length,sha256:hash(bytes)};};
const put=(name,bytes)=>{const file=path.join(E,name);fs.mkdirSync(path.dirname(file),{recursive:true});fs.writeFileSync(file,bytes,{flag:'wx'});return record(file);};
const write=(name,value)=>put(name,Buffer.from(JSON.stringify(value,null,2)+'\n'));
const err=e=>({name:e.name,code:e.code??null,message:e.message,stack:e.stack});
const sourceFiles=JSON.parse(fs.readFileSync(path.join(packageRoot,'package.json'))).files;
const sourceBindings=()=>sourceFiles.map(name=>record(path.join(packageRoot,name)));
const before=sourceBindings(),rows=[];
const launch=helperLaunchSpecification(),L=DEFINITIONS.limits;
const helperPath=path.join(packageRoot,'helpers/windows-inspect.ps1'),helperText=fs.readFileSync(helperPath,'utf8');
const functionStart=helperText.indexOf('function Confirm-ConsoleQuiescence {');
const functionEnd=helperText.indexOf('function Open-Native(',functionStart);
const rejectStart=helperText.indexOf('function Reject-Protocol('),rejectEnd=helperText.indexOf('function Assert-Keys(',rejectStart);
assert.ok(functionStart>=0&&functionEnd>functionStart&&rejectStart>=0&&rejectEnd>rejectStart);
const extracted=helperText.slice(rejectStart,rejectEnd)+helperText.slice(functionStart,functionEnd);
const extractedFile=path.join(E,'extracted-console-function.ps1');
put('extracted-console-function.ps1',Buffer.from(extracted));
const nativeSource=helperText.slice(helperText.indexOf('function Initialize-Native {'),functionStart);
const doubleFile=path.join(T,'console-native-double.ps1'),parentFile=path.join(T,'console-parent.mjs'),parentObserver=path.join(T,'console-parent-observer.py'),hostObserver=path.join(T,'console-host-observer.py');
const python='C:/Users/melsa/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/python.exe';
const simulations=[
