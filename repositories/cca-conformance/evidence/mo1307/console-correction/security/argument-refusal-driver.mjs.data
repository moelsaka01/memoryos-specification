  assert.equal(row.observation.creationFlags,16);assert.equal(row.observation.helperTerminationByObserver,false);assert.equal(row.observation.hostTerminationByObserver,false);assert.equal(row.observation.processWaitCompleted,true);assert.equal(row.observation.stdoutEof,true);assert.equal(row.observation.stderrEof,true);assert.equal(row.observation.stdinClosed,true);
