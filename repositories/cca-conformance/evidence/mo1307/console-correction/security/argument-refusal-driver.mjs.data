 console.log(JSON.stringify({result,candidate,completed:rows.filter(x=>x.result==='PASS').length,firstFailure:rows.find(x=>x.result==='FAIL')?.name??(failure?'PREFLIGHT':null),receipt:path.join(E,'receipt.json')}));
