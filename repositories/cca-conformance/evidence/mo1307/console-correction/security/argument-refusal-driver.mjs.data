  const r=spawnSync(python,args,{cwd:root,env:{...launch.options.env},windowsHide:true,shell:false,encoding:null,timeout:15000,maxBuffer:65536});
  row.observerStdout=put(row.name+'/observer.stdout.data',r.stdout??Buffer.alloc(0));row.observerStderr=put(row.name+'/observer.stderr.data',r.stderr??Buffer.alloc(0));row.exit=r.status;row.signal=r.signal;row.launchError=r.error?.code??null;
  if(fs.existsSync(path.join(dir,'proof.json'))){row.proof=record(path.join(dir,'proof.json'));row.observation=JSON.parse(fs.readFileSync(path.join(dir,'proof.json')));}
  if(fs.existsSync(path.join(dir,'stdout.data')))row.stdout=record(path.join(dir,'stdout.data'));
  if(fs.existsSync(path.join(dir,'stderr.data')))row.stderr=record(path.join(dir,'stderr.data'));
