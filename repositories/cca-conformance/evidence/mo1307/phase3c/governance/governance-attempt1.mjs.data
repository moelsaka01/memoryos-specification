// Independent Phase 3C governance corpus. Engineering only; never production authority.
import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {spawnSync} from 'node:child_process';
import {fileURLToPath} from 'node:url';
import {assessInWorker} from '../../../memoryos-readiness/src/integration.mjs';
import {evaluateReadiness,verifyReadiness} from '../../../memoryos-readiness/src/index.mjs';
import {errorExit,serializeError} from '../../../memoryos-readiness/src/errors.mjs';
const root=path.resolve(fileURLToPath(new URL('../../../../',import.meta.url)));
assert.equal(root.toLowerCase(),'c:\\users\\melsa\\documents\\codex\\cca-mo1307-3c');
const dest=path.join(root,'repositories/cca-conformance/evidence/mo1307/phase3c/governance');
fs.mkdirSync(dest,{recursive:true});
const read=p=>fs.readFileSync(path.join(root,p));
const hash=b=>'sha256:'+createHash('sha256').update(b).digest('hex');
const normalize=v=>Array.isArray(v)?v.map(normalize):v!==null&&typeof v==='object'?Object.fromEntries(Object.keys(v).sort().map(k=>[k,normalize(v[k])])):v;
const J=v=>Buffer.from(JSON.stringify(normalize(v))+'\n');
const parse=b=>JSON.parse(Buffer.from(b).toString('utf8'));
const clone=structuredClone;
const zero='sha256:'+'0'.repeat(64);
const records=[];
const started=new Date().toISOString();
function save(name,v){fs.writeFileSync(path.join(dest,name),JSON.stringify(v,null,2)+'\n',{flag:'wx'});}
function bundle(name){
 const base='repositories/cca-conformance/fixtures/mo1307/bundles/'+name;
 const pins=parse(read(base+'/pins.json')),manifestBytes=read(base+'/manifest.json');
 const input={configurationBytes:read(base+'/configuration.json'),candidateBytes:read(base+'/candidate.json'),manifestBytes,authorityBytes:read(base+'/authority.json'),files:parse(manifestBytes).entries.map(e=>({id:e.id,bytes:read(base+'/'+e.path)})),expectedCandidateDigest:pins.expectedCandidateDigest,trustedAuthorityDigest:pins.trustedAuthorityDigest};
 return {name,input,expected:read(base+'/expected-result.json'),pins};
}
function env(input,gate){const a=parse(input.authorityBytes);const grant=a.assessment.grants.find(g=>a.assessment.slots.find(s=>s.gateId===gate).grantIds.includes(g.id));return {id:grant.envelopeId,value:parse(input.files.find(f=>f.id===grant.envelopeId).bytes)};}
function put(input,id,v){input.files.find(f=>f.id===id).bytes=J(v);}
function edit(input,gate,mutate){const e=env(input,gate);mutate(e.value.claim,e.value);put(input,e.id,e.value);}
function rebind(input,{trust=true,claims=true}={}){
 const a=parse(input.authorityBytes),m=parse(input.manifestBytes);
 for(const e of m.entries){const f=input.files.find(f=>f.id===e.id);e.byteLength=f.bytes.length;e.sha256=hash(f.bytes);if(e.type==='ENVELOPE'&&claims){const v=parse(f.bytes);e.candidateBinding=v.claim.originCandidate;e.dependencyIds=v.claim.dependencies.map(d=>d.componentId);for(const g of a.assessment.grants.filter(g=>g.envelopeId===e.id)){g.envelopeSha256=e.sha256;g.claimDigest=hash(J(v.claim));g.sourceIds=clone(v.sources);g.dependencyIds=clone(e.dependencyIds);}}}
 input.manifestBytes=J(m);a.manifestSha256=hash(input.manifestBytes);input.authorityBytes=J(a);if(trust)input.trustedAuthorityDigest=hash(input.authorityBytes);return input;
}
const e=(code,stage)=>({accept:false,code:'MO1307_'+code,stage,exit:({INTEGRITY:13,EVIDENCE_AUTHORITY:16,QUALIFICATION_MISMATCH:23,HISTORY_MISMATCH:24,INPUT:12,DECISION_MISMATCH:27,RESULT_MISMATCH:26,CANDIDATE_MISMATCH:14,RESOURCE_LIMIT:28})[code]});
const ok=state=>({accept:true,state});
function resultOf(value){const r=parse(value.resultBytes);return {accept:true,state:r.assessment.readiness,exit:{READY:0,READY_WITH_QUALIFICATIONS:2,NOT_READY:3,COULD_NOT_EVALUATE:4}[r.assessment.readiness],bytes:value.resultBytes.length,readinessDigest:value.readinessDigest,proofBindingDigest:value.proofBindingDigest,decision:value.decision??null,blockers:r.assessment.blockers.length,cne:r.assessment.cneReasons.length,qualifications:r.assessment.qualifications.length,history:r.assessment.history.length};}
async function run(id,layer,expected,input,{verify=false,api=false,inspect=null,note=''}={}){
 let value,actual;
 try{value=api?(verify?await verifyReadiness(input):await evaluateReadiness(input)):assessInWorker(input,verify);actual=resultOf(value);if(inspect)inspect(parse(value.resultBytes),value);}
 catch(err){actual={accept:false,code:err.code??err.name,stage:err.stage??null,exit:err.code?errorExit(err):null,reference:err.reference??null,diagnostic:err.code?serializeError(err).toString():String(err.message)};}
 const pass=Object.entries(expected).every(([k,v])=>actual[k]===v);
 const rec={id,layer,surface:api?'PUBLIC_BYTE_API':'INTEGRATED_FIXED_WORKER_FUNCTION',note,expected:{...expected,publication:'NONE_BYTE_SURFACE'},actual:{...actual,publication:'NONE_BYTE_SURFACE'},result:pass?'PASS':'MISMATCH'};records.push(rec);
 if(!pass)console.log(JSON.stringify(rec));
 return value;
}
const cases=[];
function negative(id,base,gate,mutate,expected,layer='SEMANTIC_WITH_EXPLICIT_SYNTHETIC_TRUST',options={}){cases.push({id,run:async()=>{const b=bundle(base);edit(b.input,gate,mutate);if(options.rebind!==false)rebind(b.input,{trust:options.trust!==false});await run(id,layer,expected,b.input,{note:options.note??'Fresh test-only operator pin permits cross-field checks; no real certificate is issued.'});}});}
const mo=bundle('mo1306-qualified');
await run('MO1306-EXACT-PRESERVATION','ORIGINAL_PINNED_INTEGRATED',ok('READY_WITH_QUALIFICATIONS'),mo.input,{inspect:(r,v)=>{assert.deepEqual(Buffer.from(v.resultBytes),mo.expected);assert.equal(r.assessment.qualifications.length,10);assert.equal(r.assessment.history.length,12);assert.equal(r.assessment.gates.length,22);assert.equal(r.assessment.providers.find(p=>p.provider==='github').execution,'HOSTED_EXECUTION_NOT_CERTIFIED');assert.ok(r.assessment.providers.filter(p=>['azure','gitlab','jenkins'].includes(p.provider)).every(p=>p.execution==='NOT_LIVE_PROVIDER_CERTIFIED'));save('mo1306-preserved-result.json',r);}});
const historyMutations=[['fail-pass',h=>{h.find(x=>x.originalOutcome==='FAIL').originalOutcome='PASS';}],['blocked-removal',h=>{h.splice(h.findIndex(x=>x.originalOutcome==='BLOCKED'),1);}],['outcome-deletion',h=>{delete h[0].originalOutcome;}],['disposition-change',h=>{h[0].originalDisposition='RESOLVED';}],['source-change',h=>{h[0].sourceIds=['released.inventory'];}],['fabricated-resolution',h=>{h.find(x=>x.disposition==='PRESERVED_WITH_QUALIFICATION').disposition='SUPERSEDED';}],['unresolved-omission',h=>{h.splice(h.findIndex(x=>x.disposition==='PRESERVED_WITH_QUALIFICATION'),1);}],['duplicate-conflict',h=>{h.splice(1,0,{...clone(h[0]),originalDisposition:'CONTRADICTORY'});}]];
for(const [id,fn]of historyMutations)negative('HISTORY-PINNED-'+id,'mo1306-qualified','history',c=>fn(c.detail.records),e('INTEGRITY','INTEGRITY'),'RAW_INTEGRITY_UNCHANGED_TRUST',{rebind:false});
negative('HISTORY-CANDIDATE','mo1306-qualified','history',c=>{c.originCandidate=zero;},e('EVIDENCE_AUTHORITY','CONFIGURATION'),'UNCHANGED_OPERATOR_TRUST',{trust:false});
negative('HISTORY-SCOPE-INVENTORY-OMISSION','mo1306-qualified','history',c=>{c.detail.records.splice(c.detail.records.findIndex(h=>h.disposition==='SUPERSEDED'),1);},e('HISTORY_MISMATCH','EVALUATION'));
negative('HISTORY-FABRICATED-RESOLUTION-SEMANTIC','mo1306-qualified','history',c=>{c.detail.records.find(h=>h.disposition==='PRESERVED_WITH_QUALIFICATION').disposition='SUPERSEDED';},e('QUALIFICATION_MISMATCH','EVALUATION'));
negative('HISTORY-DANGLING-SOURCE','mo1306-qualified','history',c=>{c.detail.records[0].sourceIds=['ungranted.history'];},e('HISTORY_MISMATCH','EVALUATION'));
negative('HISTORY-DANGLING-AUTHORITY','mo1306-qualified','history',c=>{c.detail.records[0].authoritySourceIds=['ungranted.authority'];},e('HISTORY_MISMATCH','EVALUATION'));
negative('HISTORY-PASS-NOT-AN-OUTCOME','mo1306-qualified','history',c=>{c.detail.records[0].originalOutcome='PASS';},e('HISTORY_MISMATCH','EVALUATION'),'CLOSED_SCHEMA');
negative('HISTORY-DUPLICATE-SEMANTIC','mo1306-qualified','history',c=>{c.detail.records.splice(1,0,{...clone(c.detail.records[0]),originalDisposition:'CONTRADICTORY'});},e('HISTORY_MISMATCH','EVALUATION'),'SORTED_UNIQUE_REPRESENTATION');
const qmut=[['omission',c=>{c.qualifications=c.qualifications.filter(q=>q.reasonCode!=='HOSTED_NOT_CERTIFIED');}],['impact-downgrade',c=>{c.qualifications.find(q=>q.reasonCode==='HOSTED_NOT_CERTIFIED').impact='INFORMATIONAL';}],['informational-substitution',c=>{const q=c.qualifications.find(q=>q.reasonCode==='HOSTED_NOT_CERTIFIED');Object.assign(q,{reasonCode:'ENVIRONMENT_LIMITATION',disclosureCode:'ENVIRONMENT_LIMITATION',impact:'INFORMATIONAL',provider:null});}],['wrong-gate',c=>{c.qualifications.find(q=>q.reasonCode==='HOSTED_NOT_CERTIFIED').gateIds=['windows'];}],['wrong-provider',c=>{c.qualifications.find(q=>q.reasonCode==='HOSTED_NOT_CERTIFIED').provider='generic';}],['wrong-scope',c=>{c.qualifications.find(q=>q.reasonCode==='HOSTED_NOT_CERTIFIED').scopeId='other.scope';}],['disclosure-removal',c=>{delete c.qualifications.find(q=>q.reasonCode==='HOSTED_NOT_CERTIFIED').disclosureCode;}],['duplicate-conflict',c=>{c.qualifications.splice(1,0,{...clone(c.qualifications[0]),scopeId:'other.scope'});}]];
for(const [id,fn]of qmut)negative('QUALIFICATION-'+id,'mo1306-qualified','provider.github',fn,e('QUALIFICATION_MISMATCH','EVALUATION'),['impact-downgrade','wrong-gate','wrong-provider','disclosure-removal'].includes(id)?'CLOSED_SCHEMA':'SEMANTIC_OR_SORTED_UNIQUE');
negative('QUALIFICATION-WRONG-GRANTED-EVIDENCE','mo1306-qualified','provider.github',c=>{c.qualifications=[];},e('EVIDENCE_AUTHORITY','CONFIGURATION'),'UNCHANGED_OPERATOR_TRUST',{trust:false});
for(const provider of ['github','gitlab','jenkins','azure']){
 negative('PROVIDER-PINNED-PROMOTION-'+provider,'mo1306-qualified','provider.'+provider,c=>{c.detail.execution=provider==='github'?'HOSTED_EXECUTION_CERTIFIED':'LIVE_PROVIDER_CERTIFIED';c.detail.sourceExecutionLabel=c.detail.execution;c.detail.support='SUPPORTED';if(provider==='github')c.detail.hostedCases={pass:true,fail:true,cne:true,parity:true};c.qualifications=[];},e('INTEGRITY','INTEGRITY'),'RAW_INTEGRITY_UNCHANGED_TRUST',{rebind:false});
 negative('PROVIDER-CONTRADICTORY-PROMOTION-'+provider,'mo1306-qualified','provider.'+provider,c=>{c.detail.execution=provider==='github'?'HOSTED_EXECUTION_CERTIFIED':'LIVE_PROVIDER_CERTIFIED';c.detail.sourceExecutionLabel=c.detail.execution;c.detail.support='SUPPORTED';if(provider==='github')c.detail.hostedCases={pass:true,fail:true,cne:true,parity:true};},e('QUALIFICATION_MISMATCH','EVALUATION'));
}
negative('PROVIDER-PARTIAL-HOSTED','mo1306-qualified','provider.github',c=>{c.detail.execution='HOSTED_EXECUTION_CERTIFIED';c.detail.sourceExecutionLabel=c.detail.execution;c.detail.support='SUPPORTED';c.detail.hostedCases={pass:true,fail:true,cne:true,parity:false};},e('QUALIFICATION_MISMATCH','EVALUATION'));
negative('PROVIDER-TRUTHY-HOSTED','ready','provider.github',c=>{c.detail.hostedCases.pass='true';},e('INPUT','EVALUATION'),'CLOSED_SCHEMA');
negative('PROVIDER-UNKNOWN-HIGH-STRING','ready','provider.github',c=>{c.detail.validation='ZZZ_SUPER_CERTIFIED';},e('INPUT','EVALUATION'),'CLOSED_SCHEMA');
negative('MO1306-BOUNDED-DISCLOSURE-REMOVAL','mo1306-qualified','supply',c=>{c.qualifications=[];},e('QUALIFICATION_MISMATCH','EVALUATION'));
// Three axes are independently lowered under fresh reviewed test authority.
for(const axis of ['implementation','validation','execution','support'])cases.push({id:'PROVIDER-AXIS-'+axis,run:async()=>{const b=bundle('ready');edit(b.input,'provider.generic',c=>{c.detail[axis]=({implementation:'NOT_IMPLEMENTED',validation:'NOT_VALIDATED',execution:'NOT_CERTIFIED',support:'UNSUPPORTED'})[axis];if(axis==='execution')c.detail.sourceExecutionLabel='NOT_CERTIFIED';});rebind(b.input);await run('PROVIDER-AXIS-'+axis,'EXPLICIT_SYNTHETIC_AUTHORITY',ok('NOT_READY'),b.input,{inspect:r=>assert.ok(r.assessment.blockers.some(x=>x.gateId==='provider.generic'))});}});
// Every frozen qualification code gets original fixture acceptance plus a wrong impact negative.
const qualBases=[['mo1306-qualified','provider.github','HOSTED_NOT_CERTIFIED'],['mo1306-qualified','provider.azure','PROVIDER_NOT_LIVE_CERTIFIED'],['rest-qualified','rest.contract','SAME_HOST_REMOTE_ONLY'],['mo1306-qualified','supply','BOUNDED_ADVISORY_REVIEW'],['mo1306-qualified','history','HISTORICAL_UNRESOLVED_PRESERVED'],['informational-ready','resources','ENVIRONMENT_LIMITATION']];
for(const [base,gate,code]of qualBases)cases.push({id:'CODE-'+code,run:async()=>{const b=bundle(base);const all=b.input.files.map(f=>{try{return {f,v:parse(f.bytes)};}catch{return null;}}).filter(x=>x?.v.claim?.qualifications?.some(q=>q.reasonCode===code));assert.ok(all.length);for(const {f,v}of all){for(const q of v.claim.qualifications.filter(q=>q.reasonCode===code))q.impact=q.impact==='INFORMATIONAL'?'RELEASE_IMPACTING':'INFORMATIONAL';put(b.input,f.id,v);}rebind(b.input);await run('CODE-'+code,'CLOSED_SCHEMA',e('QUALIFICATION_MISMATCH','EVALUATION'),b.input);}});
cases.push({id:'CODE-PLATFORM_NOT_REQUIRED',run:async()=>{const b=bundle('informational-ready');for(const f of b.input.files){let v;try{v=parse(f.bytes);}catch{continue;}if(!v.claim)continue;let changed=false;for(const q of v.claim.qualifications){if(q.reasonCode==='ENVIRONMENT_LIMITATION'){q.reasonCode=q.disclosureCode='PLATFORM_NOT_REQUIRED';changed=true;}}if(changed)put(b.input,f.id,v);}rebind(b.input);await run('CODE-PLATFORM-INFORMATIONAL','EXPLICIT_SYNTHETIC_AUTHORITY',ok('READY'),b.input);for(const f of b.input.files){let v;try{v=parse(f.bytes);}catch{continue;}if(!v.claim)continue;for(const q of v.claim.qualifications)q.impact='RELEASE_IMPACTING';put(b.input,f.id,v);}rebind(b.input);await run('CODE-PLATFORM-WRONG-IMPACT','CLOSED_SCHEMA',e('QUALIFICATION_MISMATCH','EVALUATION'),b.input);}});
// Independent coverage partition mutation avoids copying expected core aggregate results.
for(const bits of [0,1,2,3,4,5,6,7])cases.push({id:'PRECEDENCE-'+bits,run:async()=>{const b=bundle(bits&4?'qualified':'ready');edit(b.input,'security',c=>{const all=[...c.passed];c.failed=bits&1?all.splice(0,2):[];c.unevaluable=bits&2?all.splice(0,2):[];c.passed=all;c.verdict=c.failed.length?'FAIL':c.unevaluable.length?'UNEVALUABLE':'PASS';});rebind(b.input);const state=bits&1?'NOT_READY':bits&2?'COULD_NOT_EVALUATE':bits&4?'READY_WITH_QUALIFICATIONS':'READY';await run('PRECEDENCE-'+bits,'COMPLETE_INTEGRATED_AGGREGATION',ok(state),b.input,{inspect:r=>{assert.equal(r.assessment.blockers.length,bits&1?2:0);assert.equal(r.assessment.cneReasons.length,bits&2?2:0);if(bits&4)assert.ok(r.assessment.qualifications.length>1);}});}});
// Tag claims are synthetic supplied observations. No Git subprocess or mutation.
for(const [id,base,mutate,checks]of [
 ['wrong-name','post-tag-ready',c=>{c.detail.name='wrong.tag';},['TAG_NAME']],
 ['unexpected-present','ready',c=>{c.detail={name:c.detail.name,presence:'PRESENT',object:'1'.repeat(40),annotated:true,peeledTarget:'2'.repeat(40)};},['TAG_PRESENCE']],
 ['missing-post-tag','post-tag-ready',c=>{c.detail={name:c.detail.name,presence:'ABSENT',object:null,annotated:null,peeledTarget:null};},['TAG_PRESENCE']],
 ['lightweight','post-tag-ready',c=>{c.detail.annotated=false;},['TAG_ANNOTATION']],
 ['peeled-target','post-tag-ready',c=>{c.detail.peeledTarget='0'.repeat(40);},['TAG_TARGET']],
 ['all-known-errors','post-tag-ready',c=>{c.detail.name='wrong.tag';c.detail.annotated=false;c.detail.peeledTarget='0'.repeat(40);},['TAG_NAME','TAG_ANNOTATION','TAG_TARGET']]])cases.push({id:'TAG-'+id,run:async()=>{const b=bundle(base);edit(b.input,'tag',mutate);rebind(b.input);await run('TAG-'+id,'AUTHORIZED_SYNTHETIC_OBSERVATION',ok('NOT_READY'),b.input,{inspect:r=>assert.deepEqual(r.assessment.blockers.filter(b=>b.gateId==='tag').map(b=>b.checkCode).sort(),checks.sort())});}});
negative('TAG-CANDIDATE-MISMATCH','ready','tag',c=>{c.originCandidate=zero;},e('CANDIDATE_MISMATCH','AUTHORITY'));
negative('TAG-AUTHORITY-MISMATCH','post-tag-ready','tag',c=>{c.detail.name='wrong.tag';},e('EVIDENCE_AUTHORITY','CONFIGURATION'),'UNCHANGED_OPERATOR_TRUST',{trust:false});
function decision(result,decision='APPROVE'){return {kind:'MemoryOSReadinessHumanDecision',version:'1.0.0',candidateDigest:result.assessment.candidateDigest,readinessDigest:result.readinessDigest,proofBindingDigest:result.proofBindingDigest,decision,reason:'Independent Phase 3C synthetic governance record',actor:'Administrator / root / release owner',timestamp:'9999-12-31T23:59:59Z',authenticity:'NOT_VERIFIED_BY_MEMORYOS',attestation:zero};}
for(const state of ['ready','qualified','not-ready','could-not-evaluate'])for(const d of ['APPROVE','REJECT','DEFER'])cases.push({id:'DECISION-'+state+'-'+d,run:async()=>{const b=bundle(state),r=parse(b.expected);const input={...b.input,resultBytes:b.expected,decisionBytes:J(decision(r,d))};await run('DECISION-'+state+'-'+d,'FULL_RECOMPUTATION_THEN_DECISION',ok(r.assessment.readiness),input,{verify:true,inspect:(rr,v)=>{assert.deepEqual(Buffer.from(v.resultBytes),b.expected);assert.equal(v.decision.authenticity,'NOT_VERIFIED_BY_MEMORYOS');assert.equal(v.decision.consistency,d==='APPROVE'&&['not-ready','could-not-evaluate'].includes(state)?'CONTRARY_TO_READINESS':'CONSISTENT');}});}});
for(const [id,mutate]of [['candidate',d=>{d.candidateDigest=zero;}],['readiness-digest',d=>{d.readinessDigest=zero;}],['proof-digest',d=>{d.proofBindingDigest=zero;}],['unknown-decision',d=>{d.decision='APPROVED';}],['authenticated-spoof',d=>{d.authenticity='AUTHENTICATED';}],['invalid-date',d=>{d.timestamp='2026-02-30T12:00:00Z';}],['leap-second',d=>{d.timestamp='2026-09-29T00:00:60Z';}],['timezone',d=>{d.timestamp='2026-09-29T00:00:00+00:00';}],['approval-input',d=>{d.readiness='READY';}]])cases.push({id:'DECISION-NEGATIVE-'+id,run:async()=>{const b=bundle('not-ready'),d=decision(parse(b.expected));mutate(d);await run('DECISION-NEGATIVE-'+id,'DECISION_SCHEMA_OR_BINDING',e('DECISION_MISMATCH','VERIFICATION'),{...b.input,resultBytes:b.expected,decisionBytes:J(d)},{verify:true});}});
// Result suppression attacks recompute both result self-hashes; independent inputs remain fixed.
for(const [id,mutate]of [['qualifications',r=>{r.assessment.qualifications=[];}],['history',r=>{r.assessment.history=[];}],['provider-certification',r=>{const p=r.assessment.providers.find(p=>p.provider==='github');p.execution='HOSTED_EXECUTION_CERTIFIED';p.sourceExecutionLabel=p.execution;p.support='SUPPORTED';p.hostedCases={pass:true,fail:true,cne:true,parity:true};}],['required-human-action',r=>{r.assessment.requiredHumanActions=[];}],['release-ready',r=>{r.assessment.readiness='READY';}]])cases.push({id:'RESULT-FORGERY-'+id,run:async()=>{const b=bundle('mo1306-qualified'),r=parse(b.expected);mutate(r);r.readinessDigest=hash(J({kind:'MemoryOSReadinessIdentity',version:'1.0.0',assessment:r.assessment}));r.proofBindingDigest=hash(J({kind:'MemoryOSReadinessProofBinding',version:'1.0.0',readinessDigest:r.readinessDigest,audit:r.audit}));await run('RESULT-FORGERY-'+id,'SELF_CONSISTENT_RESULT_INDEPENDENT_RECOMPUTATION',e('RESULT_MISMATCH','VERIFICATION'),{...b.input,resultBytes:J(r),decisionBytes:null},{verify:true});}});
// Freeze finite corpus before executing mutations.
save('corpus-plan.json',{kind:'MO1307Phase3CGovernancePlan',started,baseline:'976d4a04d75dadc02e30215dd5a8ddeaa2352df8',count:cases.length,cases:cases.map(c=>c.id),boundaries:['No production writes','No CLI/runtime certification duplication','Synthetic repins explicitly trust test authority only','No filesystem publication by byte-only surfaces']});
for(const c of cases)await c.run();
// Representative public byte boundaries; use actual fixed workers, no native campaign.
for(const name of ['mo1306-qualified','not-ready','could-not-evaluate']){const b=bundle(name);const value=await run('PUBLIC-API-'+name,'PUBLIC_BYTE_API_ORIGINAL_PIN',ok(b.pins.expectedReadiness),b.input,{api:true,inspect:(r,v)=>assert.deepEqual(Buffer.from(v.resultBytes),b.expected)});if(value)await run('PUBLIC-VERIFY-APPROVE-'+name,'PUBLIC_BYTE_API_GOVERNANCE',ok(b.pins.expectedReadiness),{...b.input,resultBytes:value.resultBytes,decisionBytes:J(decision(parse(value.resultBytes)))},{api:true,verify:true,inspect:(r,v)=>{assert.equal(v.decision.authenticity,'NOT_VERIFIED_BY_MEMORYOS');assert.equal(v.decision.consistency,name==='mo1306-qualified'?'CONSISTENT':'CONTRARY_TO_READINESS');}});}
const summary={kind:'MO1307Phase3CGovernanceCorpus',version:'1.0.0',started,finished:new Date().toISOString(),baseline:'976d4a04d75dadc02e30215dd5a8ddeaa2352df8',runtime:{version:process.version,sha256:hash(fs.readFileSync(process.execPath))},surfaceScope:'Integrated source and byte API only. Byte surfaces have no publication authority; no native execution claim.',count:records.length,passed:records.filter(r=>r.result==='PASS').length,mismatches:records.filter(r=>r.result!=='PASS').length,records};
save('corpus-attempt1.json',summary);console.log(JSON.stringify({count:summary.count,passed:summary.passed,mismatches:summary.mismatches}));if(summary.mismatches)process.exitCode=1;