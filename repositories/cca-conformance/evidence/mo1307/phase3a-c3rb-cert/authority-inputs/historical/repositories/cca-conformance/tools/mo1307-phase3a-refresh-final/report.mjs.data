// Append-only blocked closure reporting. No product import, launch, retry or investigation.
import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import {fileURLToPath} from 'node:url';
import {root,E,relativeE,HEAD,C3R,startedAt,hardStopAt,json,record,write,walk,hash} from './common.mjs';

const reportPath='docs/mo1307-phase3a-refresh-final.md';
const receiptName='certification-receipt.json';
const required=['baseline.json','authority-review.json','accepted-inputs.json','observation-method.json','execution-ledger-plan.json','generation-stopped.json','failure-classification.json','per-helper-timing.json','clock-state.json','resources.json','scope-status.json','integrity-after.json','final-validation.json','historical-generation-binding.json','3B-R-binding.json','3C-R-binding.json','api-parity.json','qualification-preservation.json','network.json','prepared-control-status.json','checkpoints.json'];
const loaded=Object.fromEntries(required.map(n=>[n,json(path.join(E,n))]));
const baseline=loaded['baseline.json'],authority=loaded['authority-review.json'],stop=loaded['generation-stopped.json'];
const integrity=loaded['integrity-after.json'],validation=loaded['final-validation.json'];
const commandProof=id=>validation.commands?.find(c=>c.id===id);
const gitStatusPath=path.join(E,'final-git-status.txt');
const resourceRows=loaded['resources.json'].invocations??[];
const maxResource=k=>Math.max(0,...resourceRows.map(r=>r[k]).filter(Number.isFinite));
const dryRun=process.argv.slice(2).includes('--dry-run');
const contextArgs=process.argv.slice(2).filter(a=>a!=='--dry-run');
assert.ok(contextArgs.length<=1,'Usage: report.mjs [--dry-run] [context.json]');
const optionalContext=contextArgs[0]?path.resolve(root,contextArgs[0]):path.join(E,'final-context.json');
const context=fs.existsSync(optionalContext)?json(optionalContext):{};
assert.equal(baseline.HEAD,HEAD);
assert.equal(stop.reason,'FIRST_MANDATORY_FAILURE');
assert.equal(stop.noRetry,true);
assert.equal(stop.noLaterSteps,true);
assert.ok(!fs.existsSync(path.join(E,receiptName)),'Blocked receipt already exists; never overwrite.');
assert.ok(!fs.existsSync(path.join(root,reportPath)),'Report already exists; never overwrite.');
const sealedAt=new Date().toISOString();
const letters=Array.from('ABCDEFGHIJKLMNO');
const names=['MO-1306 primary','READY','NOT_READY','COULD_NOT_EVALUATE','REST profile','Human decisions','Supplied tag observations','Helper deadline controls','Worker deadline/cancellation controls','Timeout cleanup/topology','Finalization','Affected filesystem/native subset','Environment isolation','Byte determinism','Final MO-1306 confirmation'];
const steps=letters.map((step,i)=>{
  const p=path.join(E,'steps',step+'.json');
  return fs.existsSync(p)?{step,name:names[i],...json(p),binding:record(p)}:{step,name:names[i],result:'NOT_RUN',reason:'Generation stopped at first mandatory failure; no substitution from historical evidence.'};
});
const firstFailure=steps.find(s=>s.result==='FAIL');
assert.equal(firstFailure?.step,stop.step);
assert.ok(steps.slice(letters.indexOf(stop.step)+1).every(s=>s.result==='NOT_RUN'),'A later step must not have executed after the stop.');
const allMandatoryPassed=steps.every(s=>s.result==='PASS');
assert.equal(allMandatoryPassed,false,'This reporter is deliberately restricted to blocked closure.');
const step=s=>steps.find(r=>r.step===s);
const nativeRows=steps.flatMap(s=>(s.rows??[]).filter(r=>['evaluate','verify'].includes(r.operation)).map(r=>({...r,step:s.step})));
const apiRows=steps.flatMap(s=>(s.rows??[]).flatMap(r=>r.operation?.startsWith('public-api-')?[{...r,step:s.step}]:r.evaluateMs!==undefined?[{step:s.step,name:r.name,operation:'public-api-evaluate',elapsedMs:r.evaluateMs,result:r.result,parity:r.evaluate},{step:s.step,name:r.name,operation:'public-api-verify',elapsedMs:r.verifyMs,result:r.result,parity:r.verify}]:[]));
function observationFor(r){
  const family=r.step==='F'?'decisions':r.step==='G'?'tags':'semantics';
  const name=family==='semantics'?`${r.step}-${r.name}`:r.name;
  const p=r.observation?.path??path.join(E,family,name,r.operation,'observation.json');
  assert.ok(fs.existsSync(path.resolve(root,p)),`Missing observation for ${r.step}/${r.name}/${r.operation}`);
  const v=json(p);return {step:r.step,name:r.name,operation:r.operation,parentElapsedMs:r.elapsedMs,result:r.result,exit:r.exit,binding:record(p),...v};
}
const observations=nativeRows.map(observationFor);
function timing(o){
  const sup=o.supervisors?.[0],snapshot=sup?.snapshot;
  return {step:o.step,name:o.name,operation:o.operation,exit:o.productExit,parentElapsedMs:o.parentElapsedMs,productLifecycleElapsedMs:o.productLifecycleElapsedMs,binImportElapsedMs:o.binImportElapsedMs,chargedHelperActiveMs:snapshot?.helperUsedMs,cleanupConfirmed:snapshot?.cleanupConfirmed,terminalCode:snapshot?.terminalCode,workerCount:snapshot?.workers,observation:o.binding,requests:(o.requests??[]).map(q=>({sequence:q.sequence,operation:q.operation,fileCount:q.fileCount,start:q.startTime,terminal:q.terminalTime,transportDurationMs:q.durationMs,chargedThisExchangeMs:q.chargedThisExchangeMs,priorChargedMs:q.priorChargedMs,chargedAfterMs:q.chargedAfterMs,transportMarginMs:5000-q.durationMs,responseArrived:q.responseArrived,responseAcceptedByTransport:q.responseAcceptedByTransport,responseComplete:q.responseComplete,transportClosed:q.transportClosed,exitCode:q.exitCode,exitSignal:q.exitSignal,exitAt:q.exitAt,closeAt:q.closeAt,disposition:q.disposition,error:q.error?{code:q.error.code,stage:q.error.stage}:null}))};
}
const timings=observations.map(timing);
const requests=timings.flatMap(o=>o.requests.map(q=>({...q,step:o.step,name:o.name,invocationOperation:o.operation})));
const worst=requests.reduce((a,b)=>!a||b.transportDurationMs>a.transportDurationMs?b:a,null);
const minMargin=requests.length?Math.min(...requests.map(r=>r.transportMarginMs)):null;
const counts={nativeCli:nativeRows.length,evaluate:nativeRows.filter(r=>r.operation==='evaluate').length,verify:nativeRows.filter(r=>r.operation==='verify').length,expectedNativeOutcomes:nativeRows.filter(r=>r.result==='PASS').length,failedNativeOutcomes:nativeRows.filter(r=>r.result==='FAIL').length,helpers:requests.length,workers:observations.reduce((n,o)=>n+(o.supervisors?.[0]?.snapshot?.workers??0),0),api:apiRows.length,apiEvaluate:apiRows.filter(r=>r.operation==='public-api-evaluate').length,apiVerify:apiRows.filter(r=>r.operation==='public-api-verify').length,apiExpectedOutcomes:apiRows.filter(r=>r.result==='PASS').length,primaryMo1306Evaluations:nativeRows.filter(r=>r.step==='A'&&r.operation==='evaluate').length,finalMo1306Evaluations:nativeRows.filter(r=>r.step==='O'&&r.operation==='evaluate').length,retries:0};
const primary=timings.find(t=>t.step==='A'&&t.operation==='evaluate');
const ready=timings.find(t=>t.step==='B'&&t.operation==='evaluate');
const failureObservation=observations.find(o=>o.result==='FAIL');
const failedRequest=failureObservation?.requests?.find(q=>q.disposition==='REJECTED');
const failureSnapshot=failureObservation?.supervisors?.[0]?.snapshot;
const helperEvent=failureSnapshot?.events?.find(e=>e.type==='start'&&e.role==='helper'&&e.ordinal===failedRequest?.ordinal);
const actualDeadline=helperEvent?.deadline;
const terminalAt=failureSnapshot?.terminalAt;
const failureClock={helperDeadline:actualDeadline,terminalAt,deadlineOverrunMs:Number.isFinite(terminalAt)&&Number.isFinite(actualDeadline)?terminalAt-actualDeadline:null,priorConfirmedHelperChargeMs:failureSnapshot?.helperUsedMs,failedRequestChargeMs:failedRequest?.chargedThisExchangeMs,cliDeadline:failureSnapshot?.deadline,cleanupDeadline:failureSnapshot?.cleanupDeadline,cleanupConfirmed:failureSnapshot?.cleanupConfirmed,activeRole:failureSnapshot?.activeRole,publication:failureSnapshot?.publication};
const topoPath=path.join(E,'topology-B/receipt.json');
const topology=fs.existsSync(topoPath)?json(topoPath):null;
function preservation(r){try {const now=record(r.path);return {before:r,after:now,unchanged:r.byteLength===now.byteLength&&r.sha256===now.sha256};}catch(e){return {before:r,unchanged:false,error:e.code??e.name};}}
const attributePreservation=(baseline.existing??[]).filter(r=>/(^|\/)\.gitattributes$/.test(r.path)).map(preservation);
const historicalPreservation=(baseline.historicalBindings??[]).map(preservation);
const preservedDirectBindings=[...attributePreservation,...historicalPreservation].every(r=>r.unchanged);
const fmt=n=>typeof n==='number'&&Number.isFinite(n)?n.toFixed(4):'NOT_ESTABLISHED';
const ms=n=>fmt(n)+' ms';
const textValue=v=>typeof v==='string'?v:JSON.stringify(v);
const proofState=v=>typeof v==='string'?v:(v?.result??v?.status??'RECORDED; see hash-bound evidence');
function resultFor(s,op){const r=(step(s)?.rows??[]).find(r=>r.operation===op);return r?`${r.result}; ${r.parity?.readiness??r.summary?.readiness??''}; exit ${r.exit}; parent wall ${ms(r.elapsedMs)}`:`NOT_RUN (${step(s).result})`;}
const stoppedAt=stop.at??step(stop.step).finishedAt;
const campaignMinutes=(Date.parse(stoppedAt)-Date.parse(startedAt))/60000;
const sealingMinutes=(Date.parse(sealedAt)-Date.parse(startedAt))/60000;
const later='NOT_RUN: mandatory stop at '+stop.step+'; no historical evidence substituted.';
const noCommit='NOT_CREATED: blocked generation; no success certification commit.';
const sourceBindings=walk(path.join(root,'repositories/cca-conformance/tools/mo1307-phase3a-refresh-final')).map(r=>({...r,path:'repositories/cca-conformance/tools/mo1307-phase3a-refresh-final/'+r.path}));
const proofNames=['failure-classification.json','per-helper-timing.json','clock-state.json','resources.json','scope-status.json','integrity-after.json','final-validation.json','historical-generation-binding.json','3B-R-binding.json','3C-R-binding.json','api-parity.json','qualification-preservation.json','network.json','prepared-control-status.json','checkpoints.json'];
const proofs=Object.fromEntries(proofNames.map(n=>[n,{binding:record(path.join(E,n)),value:loaded[n]}]));
const fields=[];
const field=(label,value)=>fields.push({number:fields.length+1,label,value});
field('C3RB',HEAD);
field('Package identity',`${baseline.candidate.name}@${baseline.candidate.version}; memoryos.readiness@1.0.0; ${baseline.candidate.members} installed members; archive ${baseline.candidate.archive.byteLength} bytes; ${baseline.candidate.archive.sha256}`);
field('Historical old-B2 blocker',`BLOCKED; MO-1306 ${ms(authority.history.oldB2.mo1306Ms)}; READY ${ms(authority.history.oldB2.readyMs)}; cleanupConfirmed:false; three diagnostics exhausted. Old READY internal stage remains NOT_ESTABLISHED.`);
field('Failed first 3A-R generation',`BLOCKED; MO1307_TIMEOUT / ACQUISITION / exit 29; ${ms(authority.history.firstC3RB.elapsedMs)}; original request/clock/cleanup NOT_ESTABLISHED. Public API success did not substitute for native CLI.`);
field('Localization D1',`Diagnostic only: nine requests, expected exit 2; lifecycle ${ms(authority.history.localization.D1Ms)}; request 3 ${ms(authority.history.localization.D1Request3Ms)}. No fresh timeout-cleanup proof; not certification.`);
field('Localization D2',`Diagnostic only: nine requests, expected exit 2; lifecycle ${ms(authority.history.localization.D2Ms)}; request 3 ${ms(authority.history.localization.D2Request3Ms)}. Original first-generation cause unresolved; not certification.`);
field('Generation execution count',`${counts.nativeCli} actual installed-bin CLI invocations (${counts.evaluate} evaluate, ${counts.verify} verify); ${counts.expectedNativeOutcomes} expected outcomes, ${counts.failedNativeOutcomes} failure; ${counts.helpers} helper exchanges; ${counts.workers} workers; ${counts.api} public API calls (${counts.apiEvaluate} evaluate, ${counts.apiVerify} verify). Primary MO-1306 ${counts.primaryMo1306Evaluations}; final confirmation ${counts.finalMo1306Evaluations}; retries 0.`);
field('MO-1306 primary result',resultFor('A','evaluate'));
field('MO-1306 primary exit',(step('A').rows??[]).find(r=>r.operation==='evaluate')?.exit??'NOT_RUN');
field('MO-1306 verify',resultFor('A','verify'));
for(let i=1;i<=9;i++)field(`Primary request ${i} duration`,primary?.requests.find(q=>q.sequence===i)?`${ms(primary.requests.find(q=>q.sequence===i).transportDurationMs)} transport; charged ${ms(primary.requests.find(q=>q.sequence===i).chargedThisExchangeMs)}`:'NOT_RUN');
field('Primary aggregate helper-active',ms(primary?.chargedHelperActiveMs)+' exact confirmed supervisor charge');
field('Primary CLI duration',`${ms(primary?.productLifecycleElapsedMs)} supervisor-start to bin-settled; ${ms(primary?.parentElapsedMs)} parent wall; separate 30000 ms admission clock.`);
field('READY result',resultFor('B','evaluate'));
field('READY verify',resultFor('B','verify'));
field('NOT_READY',resultFor('C','evaluate'));
field('NOT_READY verify',resultFor('C','verify'));
field('CNE',resultFor('D','evaluate'));
field('CNE verify',resultFor('D','verify'));
field('REST',resultFor('E','evaluate'));
field('REST verify',resultFor('E','verify'));
field('API parity',`${counts.apiExpectedOutcomes}/${counts.api} executed calls met expected outcome; full canonical equality for positive cases, three decision mismatches returned expected error. Failed tag vector and later stages not substituted with API.`);
field('Decisions',`${step('F').result}; ${(step('F').cases??[]).length}/7 passed; computed readiness unchanged; authenticity NOT_VERIFIED_BY_MEMORYOS; mismatches exit 27 / MO1307_DECISION_MISMATCH.`);
field('Tags',`${step('G').result}; ${(step('G').cases??[]).map(c=>c.name+' evaluate/verify/API PASS').join('; ')}. post-tag-absent evaluate TIMEOUT/29 versus expected NOT_READY/3; its verify/API and remaining lightweight/wrong-target/wrong-name vectors NOT_RUN. PRE_TAG absent reused passed B result; no Git subprocess or tag mutation.`);
for(const label of ['Timely helper','Helper timeout','Late helper refusal','Aggregate exhaustion','Worker timeout','Worker cancellation'])field(label,later);
field('Timeout cleanup proof',`${later} Incidental failing request: helper SIGTERM and stream closure recorded within 2000 ms; attributable console termination/no owned survivor not established. Product cleanupConfirmed:false and activeRole:helper preserved.`);
field('Topology',topology?`B accepted-lifecycle observation ${topology.result}: maximum ${topology.maximumProductRoles} product process roles, ${topology.maximumRawProcesses} raw processes; ${topology.maximumHelpers} helper and ${topology.maximumHelperConsoles} helper console; ${topology.helperPairs.length} retained helper/console pairs signaled; ${topology.engineeringBootstrapConsoles.length} engineering bootstrap console separately attributed. J timeout/topology gate NOT_RUN.`:later);
for(const label of ['Finalization','Filesystem','Environment'])field(label,later);
field('Network',context.network??'NO_PRODUCT_NETWORK_EXECUTION per network.json; no hosted/provider/Git execution. Exact unchanged network closure is hash-bound. No OS-wide packet capture or egress enforcement claim; M NOT_RUN.');
field('Determinism',later+' Executed CLI/API canonical-byte comparisons passed for selected positive vectors; these do not satisfy N/O.');
field('Final MO-1306 result',later);
field('Final MO-1306 verify',later);
field('Final request-3 duration','NOT_RUN: final MO-1306 confirmation withheld after mandatory failure.');
field('Worst helper duration',worst?`${ms(worst.transportDurationMs)} transport, ${worst.step}/${worst.name}/${worst.invocationOperation} request ${worst.sequence} ${worst.operation}; includes failure settlement/cleanup.`:'NOT_RUN');
field('Minimum helper deadline margin',`${ms(minMargin)} transport-relative 5000 ms margin; failed supervisor deadline overrun ${ms(failureClock.deadlineOverrunMs)}. No averaging or grace. Transport and supervisor clocks differ.`);
field('Installed integrity',`${proofState(integrity)}; before/after all 89 installed members and source recorded in integrity-after.json.`);
field('Resources',topology?`B sampled aggregate product working set ${topology.peakSampledProductWorkingSetBytes} bytes; raw ${topology.peakSampledRawWorkingSetBytes} bytes; ceiling ${topology.engineeringObservedRssCeilingBytes} bytes; maximum sampling gap ${ms(topology.maximumSampleGapMs)}. No hard OS RSS enforcement. Resources across recorded invocations: resources.json.`:'See resources.json; no hard OS RSS enforcement claim.');
field('3B-R binding',`${authority.acceptedInputs[0].commit}; ${authority.acceptedInputs[0].disposition}; read-only accepted artifact input. HTTP/2 advisory remains OPEN_PHASE3D_DISPOSITION_REQUIRED; no risk acceptance or license grant.`);
field('3C-R binding',`${authority.acceptedInputs[1].commit}; ${authority.acceptedInputs[1].disposition}; targeted security scope only, read-only.`);
field('Historical preservation',`${preservedDirectBindings?'PASS':'FAIL'} direct rehash of all ${historicalPreservation.length} historical report/receipt bindings and ${attributePreservation.length} prior .gitattributes files. Complete baseline inventory preservation of 13,151 prior file/link records: integrity-after.json (${proofState(integrity)}). All failures and diagnostics retain original labels.`);
field('Certification disposition','BLOCKED: not all 15 steps A–O passed; first mandatory failure stopped generation without retry.');
field('Production changes',`${baseline.productionChanges} at baseline; closure ${proofState(integrity)} per integrity-after.json. No product correction authorized or performed by report generation.`);
field('Evidence',relativeE+'; append-only blocked receipt binds known files, source snapshots, observations and closure records.');
field('Report',reportPath+'; current report has no embedded self-hash or future commit hash.');
field('Workspace verification',context.workspaceVerification??`${proofState(validation)}; final-validation.json (reviewed scope and exact output retained).`);
field('git diff --check',context.gitDiffCheck??textValue(commandProof('diff-check')?{result:commandProof('diff-check').result,exit:commandProof('diff-check').exit}:validation.gitDiffCheck??validation.diffCheck??'NOT_ESTABLISHED'));
field('Commit hash',noCommit);
field('Commit parent',`No certification commit. Expected parent if success had been permitted: ${HEAD}.`);
field('Final Git status',context.finalGitStatus??(fs.existsSync(gitStatusPath)?fs.readFileSync(gitStatusPath,'utf8').trim()+'; sealed pre-report snapshot, these two closure outputs follow.':'NOT_ESTABLISHED'));
field('Push','NOT_PERFORMED');
field('Tag','NOT_PERFORMED');
field('Linux/Ubuntu/WSL',context.linuxUbuntuWsl??'NOT_USED; Windows-only certification scope.');
field('VM',context.vm??'NOT_USED');
field('Provider accounts',context.providerAccounts??'NOT_USED; no hosted/provider execution.');
field('Duration',`Generation ${startedAt} to mandatory stop ${stoppedAt}: ${fmt(campaignMinutes)} minutes. Report sealed ${sealedAt}: ${fmt(sealingMinutes)} minutes from start.`);
field('90-minute checkpoint',context.checkpoints?.ninetyMinutes??(sealingMinutes<90?'NOT_REACHED before blocked closure.':'See final-validation.json; no checkpoint claim inferred.'));
field('Two-hour checkpoint',context.checkpoints?.twoHours??(sealingMinutes<120?'NOT_REACHED before blocked closure.':'See final-validation.json; no checkpoint claim inferred.'));
field('Hard-stop compliance',context.hardStopCompliance??`Product generation stopped before ${hardStopAt}: ${Date.parse(stoppedAt)<=Date.parse(hardStopAt)}; report sealing before hard stop: ${Date.parse(sealedAt)<=Date.parse(hardStopAt)}. No later product execution.`);
field('Exact Phase 3D handoff','NOT READY FOR PHASE 3D INTEGRATION. Carry forward exact C3RB/package, accepted 3BR advisory pending and scoped 3CR; preserve request-3 timeout and unclosed cleanup/control gates. Any further native run or correction requires separate authority.');
assert.equal(fields.length,74);
assert.ok(fields.every((f,i)=>f.number===i+1&&f.value!==undefined));
const evidenceBindings=walk(E).map(r=>({...r,path:relativeE+'/'+r.path}));
const receipt={kind:'MO1307Phase3AFinalCertificationBlockedReceipt',version:'1.0.0',sealedAt,result:'BLOCKED',certificationPassed:false,allMandatoryPassed,HEAD,C3R,package:baseline.candidate,runtime:baseline.runtime,limits:loaded['execution-ledger-plan.json'].limits,startedAt,stoppedAt,hardStopAt,counts,steps:steps.map(s=>({step:s.step,name:s.name,result:s.result,finishedAt:s.finishedAt??null,binding:s.binding??null,reason:s.reason??null})),failure:{stop:record(path.join(E,'generation-stopped.json')),classification:proofs['failure-classification.json'],observation:failureObservation?.binding,request:failedRequest?timing(failureObservation).requests.find(q=>q.sequence===failedRequest.sequence):null,clock:failureClock,noNewInvestigation:true},primary,ready,finalMo1306:{result:'NOT_RUN'},timings,history:authority.history,correction:authority.correction,acceptedInputs:authority.acceptedInputs,deferredAdvisory:authority.deferredAdvisory,attributePreservation,historicalPreservation,proofs,observationMethod:loaded['observation-method.json'],topology:topology?{binding:record(topoPath),result:topology.result,scope:topology.scope,peakSampledProductWorkingSetBytes:topology.peakSampledProductWorkingSetBytes,hardOsRssEnforcement:false}:null,preparedLaterControls:{result:'NOT_RUN',note:'H–N tooling retained as unexecuted drafts, not accepted evidence; no claim that syntax/line endings or campaign assertions were validated by native runs.'},requiredReportFields:fields,commit:{created:false,hash:null,parent:null,expectedParentIfSuccessful:HEAD,reason:'Blocked; no success certification commit authorized.'},actions:{push:false,tag:false,productionChanges:0,retries:0},bindingPolicy:'Only files already present at sealing are hash-bound. This receipt and generated report are excluded to avoid self-reference. A later external manifest may bind both; no future commit hash is embedded.',evidenceBindings,sourceBindings,contextBinding:fs.existsSync(optionalContext)?record(optionalContext):null,report:{path:reportPath,sha256:null,reason:'Created after receipt; no circular hash.'},generator:record(fileURLToPath(import.meta.url))};
fields[51].value+=' Maximum observed worker interval '+ms(maxResource('workerObservedIntervalMs'))+'; longest product CLI lifecycle '+ms(maxResource('productLifecycleElapsedMs'))+'; maximum confirmed helper aggregate '+ms(maxResource('helperUsedMs'))+'; maximum single Node RSS '+maxResource('maxSupervisorRssKiB')+' KiB. Single-process RSS is not aggregate RSS.';
const escape=v=>String(v).replaceAll('|','\\|').replaceAll('\r','').replaceAll('\n','<br>');
function timingTable(t){if(!t)return 'NOT_RUN.\n';return ['| Request | Operation | Transport ms | Charged ms | 5000 − transport ms | Response / exit |','| --- | --- | ---: | ---: | ---: | --- |',...t.requests.map(q=>`| ${q.sequence} | ${q.operation} | ${fmt(q.transportDurationMs)} | ${fmt(q.chargedThisExchangeMs)} | ${fmt(q.transportMarginMs)} | ${q.responseComplete?'complete':'absent/incomplete'}; ${q.exitCode??q.exitSignal??'unknown'} |`),'',`Minimum transport ${ms(Math.min(...t.requests.map(q=>q.transportDurationMs)))}; maximum ${ms(Math.max(...t.requests.map(q=>q.transportDurationMs)))}; minimum transport margin ${ms(Math.min(...t.requests.map(q=>q.transportMarginMs)))}. Confirmed aggregate helper charge: ${ms(t.chargedHelperActiveMs)}. Product lifecycle: ${ms(t.productLifecycleElapsedMs)}; parent wall: ${ms(t.parentElapsedMs)}.`].join('\n');}
const receiptBytes=Buffer.from(JSON.stringify(receipt,null,2)+'\n');
const receiptBinding={path:relativeE+'/'+receiptName,byteLength:receiptBytes.length,sha256:hash(receiptBytes)};
const lines=['# MO-1307 Phase 3A refresh — final finite generation','',`**BLOCKED.** Step ${stop.step} failed at ${failureObservation?.name??'recorded mandatory vector'} evaluate. The actual installed CLI returned MO1307_TIMEOUT / ACQUISITION / exit 29 where the tag vector required NOT_READY / exit 3. The generation stopped immediately; no retry, product correction, final MO-1306 confirmation, or success certification commit followed.`,'','This is the separately authorized final finite certification generation against exact C3RB. A–E and all seven F decision vectors passed. G passed post-tag-ready and pre-tag-present evaluate/verify/API pairs, then post-tag-absent failed. Its verify and API, remaining G vectors, and H–O were not run. Passing subsets do not constitute certification.','','## Recorded failure and clock attribution','',`The already-active trace records request ${failedRequest?.sequence} ${failedRequest?.operation}, ${failedRequest?.fileCount} files, with no response bytes. Transport settled after ${ms(failedRequest?.durationMs)}, including failure handling. The original supervisor deadline was ${fmt(actualDeadline)}; terminal time ${fmt(terminalAt)} was ${ms(failureClock.deadlineOverrunMs)} late. Confirmed prior helper charge remained ${ms(failureClock.priorConfirmedHelperChargeMs)}; the failed exchange was not charged as a confirmed quiescent helper. Aggregate and CLI deadlines were not the limiting clock. The complete classification and clock evidence are hash-bound below.`,'','Helper exit and transport closure were recorded within the 2000 ms cleanup allowance. Attributable console-host termination and absence of all owned survivors were not established. The original cleanupConfirmed:false and activeRole:helper remain unchanged. No new root-cause investigation, retry, or diagnostic execution was performed. The observed failing clock does not establish a product regression or authorize modification.','','## Fixed execution ledger','','| Step | Mandatory scope | Result |','| --- | --- | --- |',...steps.map(s=>`| ${s.step} | ${s.name} | ${s.result} |`),'','## Measurement method and limits','','The trusted Node 24.21.0 executable launched the engineering observer with genuinely empty execArgv and the sanitized environment. The observer explicitly adapted process.argv and dynamically imported the exact installed production bin, which executed its normal CLI, signals, output and exit handling. This was actual installed-bin execution under a bootstrap, not a standalone Node-to-bin launch. Resolve-only adapters retained the exact original supervisor object, forwarded the original transport answer/error, and preserved original operational errors. Spawn forwarded the exact executable, arguments and options. No production source transform, installed edit, helper copy, clock override or deadline override occurred. Buffer references were retained during live clocks; metadata decoding and hashing followed bin settlement and supervisor disposal.','','Transport exchange durations, exact confirmed supervisor charges, supervisor lifecycle duration and parent wall time are distinct. The private helper sequence also performs encoding/decoding and its own checks; transport duration is not relabeled as that private sequence clock. No averaging, grace, or historical smoke/localization substitution is used. Frozen limits remain helper 5000 ms, aggregate helper-active 20000 ms, CLI 30000 ms, worker/API 10000 ms and ordinary cleanup 2000 ms.','','## Primary MO-1306 timing','',timingTable(primary),'','## READY timing','',timingTable(ready),'','## Final MO-1306 timing','','NOT_RUN. Mandatory failure prevented the predeclared final confirmation.','','## Historical and accepted scope','','All ten MO-1306 disclosures are preserved: Generic remains REAL_EXECUTION_CERTIFIED; GitHub remains HOSTED_EXECUTION_NOT_CERTIFIED; GitLab, Jenkins and Azure remain NOT_LIVE_PROVIDER_CERTIFIED. Old-B2 failures, READ_SET diagnosis, the C3R/C3RB correction, the failed first C3RB refresh, localization D1, localization D2 and this generation remain separate. Prior failures remain failures; diagnostic passes remain diagnostic. The old READY failure stage and first-refresh timeout cause remain unresolved. The correction removed one redundant pure Assert-Root check while retaining native observations and freshness checks; accepted correction/security evidence does not replace unexecuted fresh controls.','','Accepted 3B-R remains QUALIFIED_PHASE3BR_PASS_PENDING_PHASE3D. Its Node HTTP/2 advisory remains open for Phase 3D identification/applicability/fixed-version disposition; no risk acceptance is implied and UNLICENSED/NOASSERTION grants no publication license. Accepted 3C-R retains its exact targeted security scope. No Phase 3D integration is authorized by this blocked result.','','The B process-object observation reports product and engineering roles separately, including the Node-parented engineering console and all raw processes. Its aggregate product working-set sampling is bounded observation against the 512 MiB certification ceiling, with sampling gaps retained; no hard OS RSS enforcement is claimed. H–N drafts remain unexecuted and confer no coverage.','','## Required final report fields','','| # | Field | Recorded result |','| ---: | --- | --- |',...fields.map(f=>`| ${f.number} | ${escape(f.label)} | ${escape(f.value)} |`),'','## Sealed evidence','',`Blocked certification receipt: [${receiptName}](../${relativeE}/${receiptName}) — ${receiptBinding.byteLength} bytes, ${receiptBinding.sha256}.`, '',...proofNames.map(n=>`- [${n}](../${relativeE}/${n}) — ${proofs[n].binding.sha256}`),'',`The receipt binds ${evidenceBindings.length} already-existing evidence files and ${sourceBindings.length} final tool files, exact observation records, all prior .gitattributes snapshots, historical report/receipt hashes, and accepted-input authorities. The receipt and report have no circular self-hash and no invented future commit hash. Final Git/workspace validation is the sealed pre-report snapshot. Separate post-report final-state evidence may bind these two artifacts and record subsequent closure-only checks; no future result or hash is claimed here.`, '', 'MO-1307 PHASE 3A REFRESH BLOCKED','NOT READY FOR PHASE 3D INTEGRATION',''];
const reportBytes=Buffer.from(lines.join('\n'));
assert.equal(fields.length,74);
assert.equal(primary.requests.length,9);
assert.equal(ready.requests.length,9);
assert.equal(validation.result,'PASS');
assert.equal(commandProof('workspace')?.result,'PASS');
assert.equal(commandProof('diff-check')?.result,'PASS');
assert.deepEqual(counts,{nativeCli:22,evaluate:8,verify:14,expectedNativeOutcomes:21,failedNativeOutcomes:1,helpers:122,workers:21,api:21,apiEvaluate:7,apiVerify:14,apiExpectedOutcomes:21,primaryMo1306Evaluations:1,finalMo1306Evaluations:0,retries:0});
assert.ok(!reportBytes.toString().includes('undefined'),'Undefined report field');
assert.ok(!reportBytes.toString().includes('NaN'),'Nonfinite report value');
assert.ok(reportBytes.toString().endsWith('MO-1307 PHASE 3A REFRESH BLOCKED\nNOT READY FOR PHASE 3D INTEGRATION\n'));
const reportBinding={path:reportPath,byteLength:reportBytes.length,sha256:hash(reportBytes)};
if(!dryRun){
  assert.deepEqual(write(receiptName,receipt),receiptBinding);
  fs.mkdirSync(path.dirname(path.join(root,reportPath)),{recursive:true});
  fs.writeFileSync(path.join(root,reportPath),reportBytes,{flag:'wx'});
  assert.deepEqual(record(reportPath),reportBinding);
}
process.stdout.write(JSON.stringify({result:'BLOCKED',dryRun,artifactsWritten:!dryRun,receipt:receiptBinding,report:reportBinding,requiredFields:fields.length,counts,workspace:commandProof('workspace').result,diffCheck:commandProof('diff-check').result,resourceSummary:fields[51].value})+'\n');
