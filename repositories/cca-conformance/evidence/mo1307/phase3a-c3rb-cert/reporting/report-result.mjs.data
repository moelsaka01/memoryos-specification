// Reporting only: consumes sealed, completed records and never imports or invokes product code.
import fs from 'node:fs';
import path from 'node:path';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
const root='C:/m7a',rel='repositories/cca-conformance/evidence/mo1307/phase3a-c3rb-cert',E=path.join(root,rel);
const read=p=>JSON.parse(fs.readFileSync(path.join(E,p),'utf8'));
const sha=b=>'sha256:'+createHash('sha256').update(b).digest('hex');
const record=p=>{const b=fs.readFileSync(p);return {path:path.relative(root,p).replaceAll('\\','/'),byteLength:b.length,sha256:sha(b)};};
const write=(name,obj)=>fs.writeFileSync(path.join(E,name),JSON.stringify(obj,null,2)+'\n',{flag:'wx'});
const receipt=read('certification-receipt.json'),seal=read('campaign-seal.json'),resources=read('resource-and-cleanup-observations.json');
const H=read('runtime-H/receipt.json'),HE=read('runtime-H/external-proof.json'),I=read('runtime-I/receipt.json'),B=read('topology-B/receipt.json');
