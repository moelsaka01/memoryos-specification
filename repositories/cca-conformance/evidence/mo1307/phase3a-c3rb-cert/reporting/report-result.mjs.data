const outcomes=native.reduce((o,r)=>{o[r.exit]=(o[r.exit]??0)+1;return o;},{});
const t=HE.timeoutCleanupTiming,caseH=H.cases.find(c=>c.name==='helper-timeout');
const summary={kind:'MO1307Phase3AFailedCampaignReportingSupplement',version:'1.0.0',result:'FAILED/INCOMPLETE',reportingOnly:true,newProductExecutions:0,diagnosticCampaign:false,candidate:receipt.candidate,worktree:root,branch:receipt.branch,receipt:record(path.join(E,'certification-receipt.json')),seal:record(path.join(E,'campaign-seal.json')),inventory:record(path.join(E,'recovered-inventory.json')),completed:receipt.completed,failed:['J'],notRun:receipt.unexecuted,
 firstMandatoryFailure:{stage:'J',case:'cleanup-topology: exact cleanup allowance subtraction assertion',source:'repositories/cca-conformance/tools/mo1307-phase3a-c3rb-cert/cleanup-topology.mjs:27',expected:2000,actual:t.cleanupDeadlineAtMs-t.terminalAtMs,operator:'strictEqual',checkerExit:failure.exit,productOperationalExit:null,explanation:'Recorded mandatory checker failure. No arithmetic correction, deadline change, retry or diagnostic campaign was performed.',originControl:'H/helper-timeout',helperRequest:HE.timeoutCleanup,clocks:{terminalAtMs:t.terminalAtMs,cleanupDeadlineAtMs:t.cleanupDeadlineAtMs,transportClosedAtMs:t.transportClosedAtMs,transportCleanupMarginMs:t.transportCleanupMarginMs,clockBridge:t.clockBridge},evidence:record(path.join(E,'steps/J.stderr.data'))},
 nativeCli:{invocations:native.length,helpers:requests.length,workers:native.reduce((n,r)=>n+r.supervisors.reduce((x,s)=>x+s.snapshot.workers,0),0),exitCounts:outcomes,maxObservedHelperExchangeMs:Math.max(...requests.map(r=>r.durationMs)),maxChargedHelperLifecycleMs:Math.max(...charged),maxAggregateHelperActiveMs:Math.max(...native.flatMap(r=>r.supervisors.map(s=>s.snapshot.helperUsedMs))),maxCliLifecycleMs:Math.max(...lifecycles),allRecordedInvocationsMatchedExpected:true},
 controls:{H:{result:H.result,cases:H.cases.map(c=>({name:c.name,result:c.result,expectedError:c.expectedError,actualError:c.error?.code??null,elapsedMs:c.elapsedMs,helpers:c.snapshot.helpers,workers:c.snapshot.workers,terminalAt:c.snapshot.terminalAt,cleanupDeadline:c.snapshot.cleanupDeadline,activeRole:c.snapshot.activeRole,cleanupConfirmed:c.snapshot.cleanupConfirmed})),externalProof:HE.result,helperCount:HE.helperCount},I:{result:I.result,cases:I.cases.map(c=>({name:c.name,result:c.result,expectedError:c.expectedError,actualError:c.error?.code??null,elapsedMs:c.elapsedMs,helpers:c.snapshot.helpers,workers:c.snapshot.workers,terminalAt:c.snapshot.terminalAt,cleanupDeadline:c.snapshot.cleanupDeadline,activeRole:c.snapshot.activeRole,cleanupConfirmed:c.snapshot.cleanupConfirmed}))}},
 cleanupAndProcess:{mandatoryStageJ:'FAIL',helperTimeoutProductCleanupConfirmed:caseH.snapshot.cleanupConfirmed,priorExternalHelperTimeoutProof:t.result,externalKnownHelperObjectsSignaled:HE.allKnownObjectsSignaled,allThreeStreamsClosedBeforeCleanupDeadline:t.allThreeStreamsClosedBeforeCleanupDeadline,timeoutTransportClosedBeforeCleanupDeadline:t.transportClosedBeforeCleanupDeadline,workerControls:I.cases.map(c=>({name:c.name,cleanupConfirmed:c.snapshot.cleanupConfirmed,activeRole:c.snapshot.activeRole})),readySampledTopology:B.result,readyAllKnownObjectsSignaled:B.allKnownObjectsSignaled,maximumProductRoles:B.maximumProductRoles,maximumRawProcesses:B.maximumRawProcesses,engineeringBootstrapConsoles:B.engineeringBootstrapConsoles,peakSampledProductWorkingSetBytes:B.peakSampledProductWorkingSetBytes,unknownShortLivedDescendants:'NOT_EXCLUDED_BY_SAMPLING',noNewProcessSamplingAfterFailure:true},
 cliApiParity:{AthroughG:'PASS',formalDeterminismStageN:'NOT_RUN',finalMO1306StageO:'NOT_RUN'},limits:seal.limits,replacementHelperBoundH:'NOT_ESTABLISHED',historicalPreservation:{files:integrity.historicalFiles,changed:integrity.historicalChanged.length,promoted:false},installedAndSourceIntegrity:integrity.result,phase3DHandoff:'NONE: Phase 3A failed/incomplete; other streams unaffected',retryCount:0,replacementCount:0};
write('result-summary.json',summary);
const node=receipt.runtime.node,ps=receipt.runtime.powershell,archive=receipt.package.archive;
const lines=['# MO-1307 Phase 3A C3RB certification result','', '**Phase 3A FAILED/INCOMPLETE.** The sealed campaign ran once and stopped at J. No retry, replacement execution, diagnostic campaign, or correction followed.','',
`Candidate: C3RB \`${receipt.candidate}\`. Integration/evidence authority: \`${receipt.integrationAuthority}\`. Worktree: \`C:\\m7a\`; branch: \`${receipt.branch}\`.`,
`Platform: ${ps.osCaption} x64, build ${ps.build}. Node ${node.version} win-x64, SHA-256 \`${node.sha256}\`. Native helper host: Windows PowerShell ${ps.powerShellVersion}. npm 11.19.0 was used only for offline packaging/install.`,
'',`Package: memoryos-readiness@0.1.0, ${archive.byteLength} bytes, SHA-256 \`${archive.sha256}\`. It was freshly packed from C3RB and installed offline at \`${receipt.package.packageRoot}\`. All 89 members exactly matched C3RB before execution and remained unchanged after it.`,
'',`Inventory: [recovered-inventory.json](../${rel}/recovered-inventory.json), SHA-256 \`${summary.inventory.sha256}\`. Seal: \`${summary.seal.sha256}\`. The finite A-O inventory includes seven human-decision cases, the complete seven-tag inventory, seven helper controls and four worker/cancellation controls. Thirty-nine authenticated authority snapshots are retained.`,
'','| Coverage | Result |','|---|---|','| A MO-1306 evaluate/verify/API | PASS |','| B READY evaluate/verify/API | PASS |','| C NOT_READY evaluate/verify/API | PASS |','| D COULD_NOT_EVALUATE evaluate/verify/API | PASS |','| E REST evaluate/verify/API | PASS |','| F Seven human decisions | PASS |','| G Complete supplied-tag inventory | PASS |','| H Helper deadline/cancellation controls | PASS |','| I Worker deadline/cancellation controls | PASS |','| J Cleanup/process topology | FAIL |','| K Finalization | NOT_RUN |','| L Filesystem/native controls | NOT_RUN |','| M Environment isolation | NOT_RUN |','| N Byte determinism | NOT_RUN |','| O Final MO-1306 confirmation | NOT_RUN |',
'',`The first mandatory failure was J's strict allowance-subtraction assertion at cleanup-topology.mjs:27: expected \`2000\`, actual \`${summary.firstMandatoryFailure.actual}\`; checker exit 1. This is the recorded checker outcome, not a product TIMEOUT/exit 29. The underlying retained H helper-timeout record has terminalAt=${t.terminalAtMs} ms and cleanupDeadline=${t.cleanupDeadlineAtMs} ms. Its helper invocation ordinal is ${HE.timeoutCleanup.ordinal}, protocol request sequence ${HE.timeoutCleanup.protocolSequence}, operation ${HE.timeoutCleanup.operation}, PID ${HE.timeoutCleanup.pid}. No correction or diagnostic campaign was performed.`,
'',`Completed native CLI observations: ${native.length}, ${requests.length} helpers, ${summary.nativeCli.workers} workers. Expected semantic nonzero exits passed when matched. Maximum observed charged helper lifecycle: ${summary.nativeCli.maxChargedHelperLifecycleMs.toFixed(4)} ms; aggregate helper-active: ${summary.nativeCli.maxAggregateHelperActiveMs.toFixed(4)} ms; CLI lifecycle: ${summary.nativeCli.maxCliLifecycleMs.toFixed(4)} ms. H/I separately retained expected timeout/cancellation and late-result rejection controls.`,
`Frozen limits remain 5000 ms per helper lifecycle, 20000 ms aggregate helper-active, 30000 ms CLI/rename admission, 10000 ms API/worker and 2000 ms failure cleanup. Replacement helper bound H remains NOT_ESTABLISHED; no admitted-rename settlement bound was invented.`,
'',`The prior H external cleanup proof recorded PASS: identified helper/console objects signaled and all three streams closed before the unchanged deadline. Transport cleanup margin was ${t.transportCleanupMarginMs.toFixed(4)} ms. Product cleanupConfirmed remains ${caseH.snapshot.cleanupConfirmed} for the killed helper and is not relabeled. Worker controls recorded cleanupConfirmed true and no active role. READY's scheduled observer recorded at most ${B.maximumProductRoles} product roles (${B.maximumRawProcesses} raw including separately disclosed engineering bootstrap), ${B.peakSampledProductWorkingSetBytes} bytes peak sampled aggregate product working set, and all identified objects signaled. Sampling does not exclude unknown short-lived descendants. These retained observations do not override J's mandatory failure.`,
'',`CLI/API canonical-byte parity completed for A-G. Formal byte-determinism stage N and final MO-1306 confirmation O were not run; no acceptance is inferred from partial coverage.`,
`Historical preservation checked ${integrity.historicalFiles} files from original Phase 3A and r3a: zero changes and no result promotion. Historical 3A-R remains A-F PASS, G FAIL, H-O NOT_RUN. Production and installed members remained unchanged. Main's preexisting dirty files were not used as production authority or modified by this stream.`,
'',`Failed/incomplete receipt: [certification-receipt.json](../${rel}/certification-receipt.json), SHA-256 \`${summary.receipt.sha256}\`. Detailed retained observations: [result-summary.json](../${rel}/result-summary.json). The original automatic closure report and its bindings remain preserved.`,
'','The next local operation is an evidence-only commit rooted at C3RB, followed by read-only committed-byte verification. No push or tag is authorized. There is **no accepted Phase 3A handoff to Phase 3D**. This failed/incomplete stream must be handled separately; it makes no claim about the independent Phase 3B/3C results. Phase 3D was not performed.',''];
