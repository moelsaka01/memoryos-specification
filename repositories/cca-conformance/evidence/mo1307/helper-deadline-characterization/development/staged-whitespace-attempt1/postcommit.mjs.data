// Postcommit verification writes only ignored cache receipts; no new commit/binding file.
import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import {spawnSync} from 'node:child_process';
import {performance} from 'node:perf_hooks';
import {root,evidence,baseline,commitSubject,str,record,check,write,json,blobs,hash} from './common.mjs';
assert.equal(process.argv.length,4);assert.equal(process.argv[2],'--output');
const output=process.argv[3].replaceAll('\\','/'),prefix='.cache/mo1307/helper-deadline-characterization/postcommit/';assert.ok(output.startsWith(prefix));assert.ok(path.resolve(root,output).startsWith(path.resolve(root,prefix)+path.sep));assert.equal(fs.existsSync(path.resolve(root,output)),false);
assert.equal(process.version,'v24.21.0');assert.equal(hash(fs.readFileSync(process.execPath)),'sha256:ba4e6d110e8c1592a1ecd390f6b05f3da124b13871a5be62b341a07a853c6c32');
assert.equal(str('status','--porcelain=v1','--untracked-files=all'),'');assert.equal(str('branch','--show-current'),'main');const commit=str('rev-parse','HEAD');assert.deepEqual(str('show','-s','--format=%P',commit).split(' '),[baseline]);assert.equal(str('show','-s','--format=%s',commit),commitSubject);
const inventoryPath=evidence+'/changed-file-inventory.json';const members=[...json(inventoryPath).members,record(inventoryPath)].sort((a,b)=>a.path<b.path?-1:1);const names=str('diff-tree','--no-commit-id','--name-only','-r',commit).split('\n').filter(Boolean).sort();assert.deepEqual(names,members.map(m=>m.path));const committed=blobs(commit,names);members.forEach((m,i)=>{check(m,committed[i]);check(m);});
const validation=json(evidence+'/final-validation/receipt.json');assert.equal(validation.result,'PASS');for(const source of validation.sourceBindings)check(source);for(const command of validation.commands){assert.equal(command.result,'PASS');check(command.stdout);check(command.stderr);}
fs.mkdirSync(path.resolve(root,output),{recursive:true});const rows=[];let result='PASS',failure=null;
function run(id,exe,args){const started=performance.now(),r=spawnSync(exe,args,{cwd:root,windowsHide:true,encoding:null,timeout:60000,maxBuffer:32*1024*1024});for(const [n,b] of [['stdout.txt',r.stdout??Buffer.alloc(0)],['stderr.txt',r.stderr??Buffer.alloc(0)]])fs.writeFileSync(path.resolve(root,output,id+'.'+n),b,{flag:'wx'});rows.push({id,exe,args,exit:r.status,error:r.error?.code??null,elapsedMs:performance.now()-started,stdout:record(output+'/'+id+'.stdout.txt'),stderr:record(output+'/'+id+'.stderr.txt'),result:r.status===0&&!r.error?'PASS':'FAIL'});assert.ifError(r.error);assert.equal(r.status,0);}
try{run('evidence',process.execPath,['repositories/cca-conformance/tools/mo1307-helper-deadline-characterization/check-evidence.mjs']);run('package',process.execPath,['repositories/cca-conformance/tools/mo1307-phase1/package.mjs','check']);run('workspace','C:/Users/melsa/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/python.exe',['-B','tools/verify_workspace.py','--root','.']);run('diff','git',['diff','--check','HEAD^','HEAD']);assert.equal(str('status','--porcelain=v1','--untracked-files=all'),'');assert.equal(str('rev-parse','HEAD'),commit);}catch(error){result='FAIL';failure={message:error.message,stack:error.stack};}
write(output+'/receipt.json',{kind:'MO1307HelperDeadlinePostcommit',result,failure,commit,parent:baseline,subject:commitSubject,committedMembers:members.length,commands:rows,cleanMain:result==='PASS',productionHelperExecutions:0,packageBuildPerformed:false,push:false,tag:false,certification:false});console.log(JSON.stringify({result,commit,parent:baseline,commands:rows.length,failure}));process.exitCode=result==='PASS'?0:1;
