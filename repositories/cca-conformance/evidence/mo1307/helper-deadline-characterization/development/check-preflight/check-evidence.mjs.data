// Read-only evidence closure. No observation or helper execution is performed here.
import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import {fileURLToPath} from 'node:url';
import {root,evidence,baseline,read,json,record,hash,check,blobs} from './common.mjs';
import {checkIntegrity} from './check-integrity.mjs';
import {decodeHelperRequest,decodeHelperResponse} from '../../../memoryos-readiness/src/helper-protocol.mjs';
const bindings=[];
const bound=p=>{bindings.push(record(p));return json(p);};
function objects(x){return !x||typeof x!=='object'?[]:[x,...Object.values(x).flatMap(objects)];}
function checkAnalyses(){
 const names=['contract-intent.json','deadline-source-analysis.json','security-analysis.json'];
 const values=names.map(n=>bound(evidence+'/'+n));
 const pinned=new Map();for(const value of values){assert.equal(value.result,'PASS');assert.equal(value.baseline,baseline);assert.equal(value.productionChanges,false);assert.equal(value.freezeChanges,false);assert.equal(value.nativeExecutionsByThisAnalysis,0);assert.equal(value.certification,false);assert.equal(value.phase3AR,'BLOCKED');for(const o of objects(value)){if(o.gitCommit&&o.path&&o.sha256){assert.equal(o.gitCommit,baseline);assert.equal(o.gitBlobBytesVerified,true);check(o);pinned.set(o.path,o);if(o.excerpt!==undefined){assert.equal(hash(Buffer.from(o.excerpt)),o.excerptSha256);const actual=read(o.path).toString().split(/\r?\n/).slice(o.startLine-1,o.endLine).join('\n');assert.equal(actual,o.excerpt);}}}}
 const descriptors=[...pinned.values()],gitBytes=blobs(baseline,descriptors.map(r=>r.path));descriptors.forEach((r,i)=>check(r,gitBytes[i]));const [contract,implementation,security]=values;assert.equal(contract.classification,'WHOLE_HELPER_LIFECYCLE');assert.equal(contract.deadlineMs,5000);assert.equal(contract.aggregateHelperActiveMs,20000);assert.equal(contract.cliAdmissionMs,30000);assert.equal(implementation.contractIntent,contract.classification);assert.equal(implementation.implementationScope,'WHOLE_HELPER_LIFECYCLE_WITH_ADDITIONAL_SEQUENCE_FRAMING_CHECKS');assert.equal(security.analysisScope,'PRE_MEASUREMENT_CONDITIONAL_MODEL_COMPARISON');return{result:'PASS',contractIntent:contract.classification,sourceFiles:descriptors.length,preMeasurementModelSelection:false};
}
function checkAuthority(){
 const value=bound(evidence+'/authority-binding.json');assert.equal(value.result,'BOUND_AND_RECONCILED');assert.equal(value.baseline,baseline);assert.equal(value.nativeLaunches,0);assert.equal(value.productionEdits,false);assert.equal(value.sourceWorktreeWrites,false);
 for(const o of objects(value))if(o.path&&Number.isSafeInteger(o.byteLength)&&typeof o.sha256==='string'){const inherited=objects(value).find(p=>p.sourceRoot&&p.path===o.path&&p.byteLength===o.byteLength&&p.sha256===o.sha256);check(o,fs.readFileSync(path.resolve(o.sourceRoot??inherited?.sourceRoot??root,o.path)));}
 return{result:'PASS',binding:record(evidence+'/authority-binding.json'),historicalDispositionPreserved:true};
}
function checkCampaign(){
 const plan=bound(evidence+'/sample-plan.json'),start=bound(evidence+'/campaign-start.json'),campaign=bound(evidence+'/campaign.json');assert.equal(plan.baseline,baseline);assert.equal(plan.maximumProductionHelperExecutions,25);assert.equal(plan.plannedProductionHelperExecutions,25);assert.equal(plan.observationsPerCase,5);assert.equal(plan.retries,0);assert.equal(plan.helperCopy,false);assert.equal(plan.helperSourceModified,false);assert.equal(plan.clockOverrides,false);assert.equal(plan.deadlineChanges,false);assert.deepEqual(plan.limits,{helperMs:5000,aggregateHelperMs:20000,cliMs:30000,cleanupMs:2000});
 const expected=[];for(let round=0;round<5;round++)for(let offset=0;offset<5;offset++){const id='ABCDE'[(round+offset)%5];expected.push({sampleId:String(expected.length+1).padStart(2,'0')+'-'+id,case:id,round:round+1});}assert.deepEqual(plan.order,expected);assert.deepEqual(plan.cases.map(c=>c.id),['A','B','C','D','E']);for(const pin of plan.sourceBindings)check(pin);assert.deepEqual(plan.sourceBindings.filter(p=>p.path.startsWith('repositories/memoryos-readiness/')),json(evidence+'/integrity-before.json').members);assert.equal(Date.parse(plan.createdAtUtc)<=Date.parse(start.startedAtUtc),true);check(start.plan);check(campaign.plan);assert.deepEqual(start.sourceBindings,plan.sourceBindings);assert.equal(campaign.result,'COMPLETE');assert.equal(campaign.stopReason,null);assert.equal(campaign.actualHelperExecutions,25);assert.equal(campaign.completedSampleReceipts,25);assert.equal(campaign.retries,0);assert.equal(campaign.maximum,25);assert.equal(campaign.sourceIntegrityUnchanged,true);assert.equal(campaign.observerClosed,true);assert.deepEqual(campaign.observerExit,{code:0,signal:null});check(campaign.observerStdout);check(campaign.observerStderr);assert.equal(campaign.observerStderr.byteLength,0);assert.deepEqual(campaign.samples.map(r=>r.sampleId),expected.map(r=>r.sampleId));assert.deepEqual(campaign.launches.map(r=>r.sampleId),expected.map(r=>r.sampleId));
 for(const c of plan.cases){check(c.request);for(const pin of c.members)check(pin);if(c.manifest)check(c.manifest);const request=decodeHelperRequest(read(c.request.path));assert.equal(request.operation,c.operation);assert.equal(request.sequence,c.sequence);assert.equal(request.session,c.session);assert.equal(request.roots[0].path,c.root);assert.equal(request.files.length,c.fileCount);assert.equal(c.members.reduce((sum,r)=>sum+r.byteLength,0),c.aggregateBytes);assert.equal(c.requestFrameBytes,c.request.byteLength);assert.equal(c.historicalFrameReplay,false);}
 assert.deepEqual(plan.cases.map(c=>c.fileCount),[1,19,65,19,0]);assert.equal(plan.cases[1].aggregateBytes,19711);assert.equal(plan.cases[2].aggregateBytes,2004208);assert.equal(plan.cases[3].aggregateBytes,19711);assert.equal(plan.cases[3].rootPathParts,plan.cases[1].rootPathParts+1);assert.deepEqual(plan.cases[1].members.map(({id,byteLength,sha256})=>({id,byteLength,sha256})),plan.cases[3].members.map(({id,byteLength,sha256})=>({id,byteLength,sha256})));
 const samples=[];for(const [i,pin] of campaign.samples.entries()){
  check(pin.receipt);const r=bound(pin.receipt.path),c=plan.cases.find(c=>c.id===r.case);assert.equal(r.sampleId,expected[i].sampleId);assert.equal(r.case,expected[i].case);assert.equal(r.round,expected[i].round);assert.equal(r.result,pin.result);assert.ok(['SUCCESS','TIMEOUT'].includes(r.result));assert.equal(r.spawnCount,1);assert.equal(r.pid,campaign.launches[i].pid);check(r.request);check(r.response);assert.deepEqual(read(r.request.path),read(c.request.path));assert.equal(r.operation,c.operation);assert.equal(r.fileCount,c.fileCount);assert.equal(r.aggregateBytes,c.aggregateBytes);assert.equal(r.responseFrameBytes,r.response.byteLength);assert.equal(r.stderrBytes,0);assert.equal(r.certification,false);assert.equal(r.privateSequenceExecuted,false);assert.equal(r.observationError,null);assert.equal(r.processAck.requiredCleanupViolation,false);check(r.productSource);assert.deepEqual(r.productSource,plan.sourceBindings.find(p=>p.path.endsWith('/helpers/windows-inspect.ps1')));assert.ok(r.processObservation);check(r.processObservation);const observation=bound(r.processObservation.path);assert.equal(observation.sampleId,r.sampleId);assert.ok(['OBSERVED','PARTIAL'].includes(observation.result));assert.equal(observation.requestedHelperPid,r.pid);assert.equal(observation.processTerminationPerformed,false);assert.equal(observation.productCleanupFlagModified,false);assert.equal(observation.completeDescendantCoverageEstablished,false);assert.equal(observation.requiredCleanupViolation,false);assert.ok(observation.qpcFrequency>0);assert.ok(r.processObservation.byteLength<=524288);check(r.processAck.observation);assert.equal(r.processAck.observation.sha256,r.processObservation.sha256);assert.equal(observation.sampleCount,observation.events.filter(e=>e.event==='sample').length);const helperLives=observation.lifetimes.filter(l=>l.role==='helper'),consoleLives=observation.lifetimes.filter(l=>l.role==='console_host');assert.equal(observation.observedHelperCount,helperLives.length);assert.equal(observation.observedConsoleHostCount,consoleLives.length);assert.equal(observation.consoleAttributionEstablished,consoleLives.length>0);for(const life of observation.lifetimes){assert.ok(['helper','console_host'].includes(life.role));if(life.role==='helper')assert.equal(life.identity.pid,r.pid);else assert.equal(life.parentIdentity.pid,r.pid);for(const key of ['creationTime100ns','exitTime100ns','kernelTime100ns','userTime100ns'])assert.match(life.nativeTimes[key],/^\d+$/);const cpu=Number(BigInt(life.nativeTimes.kernelTime100ns)+BigInt(life.nativeTimes.userTime100ns))/10000;assert.equal(life.cpuMs,cpu);}assert.equal(observation.helperCpuMs,helperLives.length?helperLives.reduce((n,l)=>n+l.cpuMs,0):null);
  const begin=r.snapshot.events.find(e=>e.type==='start'&&e.role==='helper');assert.ok(begin);assert.equal(r.snapshot.helpers,1);assert.equal(r.snapshot.workers,0);assert.equal(r.times.T0.status,'DERIVED');assert.equal(r.times.T0.at,begin.deadline-5000);assert.equal(r.times.T3.status,'NOT_OBSERVABLE');assert.equal(r.durations.bootstrapMs,null);const d=r.durations,t=r.times;assert.equal(d.launchToTransportSettlementMs,t.transportSettled-t.T0.at);assert.equal(d.deadlineMarginMs,5000-d.launchToTransportSettlementMs);assert.equal(d.processCreationReturnMs,t.T1-t.spawnCallEntered);assert.equal(d.clockOriginToSpawnReturnMs,t.T1-t.T0.at);assert.equal(d.requestToFirstByteMs,t.T5!==null&&t.T4!==null?t.T5-t.T4:null);assert.equal(d.requestToCompleteFrameMs,t.T6!==null&&t.T4!==null?t.T6-t.T4:null);assert.equal(d.responseToExitMs,t.T6!==null&&t.T7?t.T7.at-t.T6:null);assert.equal(d.launchToProcessExitMs,t.T7?t.T7.at-t.T0.at:null);assert.equal(d.terminalOverrunMs,r.snapshot.terminalAt===null?null:r.snapshot.terminalAt-begin.deadline);if(r.snapshot.terminalAt!==null)assert.ok(r.snapshot.terminalAt>=begin.deadline);
  if(r.result==='SUCCESS'){assert.equal(r.error,null);assert.equal(r.validation,'EXACT_PROTOCOL_AND_INPUT_BYTES');assert.equal(r.cleanupConfirmed,true);assert.equal(r.snapshot.cleanupConfirmed,true);assert.equal(r.snapshot.activeRole,null);assert.deepEqual(r.pipes,{stdin:true,stdout:true,stderr:true});assert.equal(r.snapshot.terminalCode,null);assert.equal(r.snapshot.terminalAt,null);assert.equal(t.T7.code,0);assert.equal(t.T7.signal,null);const request=decodeHelperRequest(read(r.request.path)),response=decodeHelperResponse(read(r.response.path),request);assert.equal(response.status,c.operation==='READ_SET'?'OK':'ABSENT');assert.equal(r.responseStatus,response.status);for(const file of response.files){const input=request.files.find(f=>f.id===file.id);assert.deepEqual(Buffer.from(file.bytes.join(''),'base64'),fs.readFileSync(path.join(request.roots[0].path,...input.path.split('/'))));}}
  else {assert.equal(r.error.code,'MO1307_TIMEOUT');assert.equal(r.error.stage,'ACQUISITION');assert.equal(r.validation,'NO_SUCCESS_CLAIM');assert.ok(r.snapshot.terminalAt>=begin.deadline);}
  samples.push(r);
 }
 const observer=bound(evidence+'/observer/receipt.json'),ready=bound(evidence+'/observer/ready.json'),provenance=bound(evidence+'/observer-source-provenance.json');assert.equal(observer.result,'PASS');assert.equal(observer.failure,null);assert.equal(observer.productProcessesLaunched,0);assert.equal(observer.productProcessesTerminated,0);assert.equal(observer.productionModified,false);assert.deepEqual(observer.completedSamples.map(s=>s.sampleId),expected.map(s=>s.sampleId));for(const done of observer.completedSamples){check(done.observation);assert.equal(done.requiredCleanupViolation,false);}assert.equal(ready.productProcessesLaunched,0);assert.equal(ready.guardSeconds,300);assert.equal(ready.intervalMs,50);assert.equal(ready.settlementMs,2000);for(const source of ready.sourceBindings)check(source);assert.equal(provenance.result,'PASS');for(const key of ['original','retained','observer'])check(provenance[key]);assert.equal(provenance.original.sha256,provenance.retained.sha256);assert.equal(provenance.sourceWorktreeModified,false);assert.equal(provenance.originalMainInvoked,false);assert.equal(provenance.nativeExecutionsForValidation,0);
 const byCase=plan.cases.map(c=>{const rows=samples.filter(s=>s.case===c.id),values=rows.map(r=>r.durations.launchToTransportSettlementMs),sorted=[...values].sort((a,b)=>a-b);assert.equal(values.length,5);const max=Math.max(...values),margin=5000-max;return{case:c.id,rawWholeMs:values,minMs:sorted[0],maxMs:max,medianMs:sorted[2],minimumMarginMs:margin,marginClassification:margin>=1500?'large':margin>=750?'moderate':margin>0?'thin':'violation',samplesBelow5000:values.filter(v=>v<5000).length,samplesAtOrAbove5000:values.filter(v=>v>=5000).length,timeouts:rows.filter(r=>r.result==='TIMEOUT').length};});
 return{result:'PASS',sampleCount:samples.length,byCase,model:'Pending independent final statistics/decision binding',historicalFrameReplay:false};
}
export function checkEvidence(){bindings.length=0;const checks=[];try{assert.equal(process.version,'v24.21.0');assert.equal(process.platform,'win32');assert.equal(process.arch,'x64');assert.equal(hash(fs.readFileSync(process.execPath)),'sha256:ba4e6d110e8c1592a1ecd390f6b05f3da124b13871a5be62b341a07a853c6c32');checks.push({id:'integrity',...checkIntegrity()});checks.push({id:'source-and-contract',...checkAnalyses()});checks.push({id:'historical-authority',...checkAuthority()});checks.push({id:'fixed-plan-measurement',...checkCampaign()});return{kind:'MO1307HelperDeadlineEvidenceCheck',version:'1.0.0',result:'PASS',checks,bindings:[...bindings],readOnly:true,productionHelperExecutions:0,certification:false};}catch(error){return{kind:'MO1307HelperDeadlineEvidenceCheck',version:'1.0.0',result:'FAIL',checks,failure:{message:error.message,stack:error.stack},readOnly:true,productionHelperExecutions:0,certification:false};}}
if(process.argv[1]&&path.resolve(process.argv[1])===fileURLToPath(import.meta.url)){assert.equal(process.argv.length,2);const result=checkEvidence();console.log(JSON.stringify(result));process.exitCode=result.result==='PASS'?0:1;}
