import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import {spawnSync} from 'node:child_process';
import {root,E,cache,packageRoot,C3RB,C3R,startedAt,env,hash,read,json,record,check,walk,inventory,write,put,git,str,identity} from './common.mjs';
import {checkPackage,packageFiles} from '../mo1307-phase1/package.mjs';
identity();assert.equal(str('branch','--show-current'),'codex/mo1307-phase3a-refresh');assert.equal(str('show','-s','--format=%P',C3RB),C3R);
assert.equal(str('show','-s','--format=%s',C3RB),'conformance(memoryos-1.3): bind MO-1307 READ_SET optimization');
assert.equal(fs.existsSync(E),false);assert.equal(fs.existsSync(cache),false);fs.mkdirSync(E,{recursive:true});fs.mkdirSync(cache,{recursive:true});
write('baseline.json',{result:'PASS',startedAt,capturedAt:new Date().toISOString(),root,branch:str('branch','--show-current'),HEAD:C3RB,parent:C3R,subject:str('show','-s','--format=%s',C3RB),tree:str('rev-parse',C3RB+'^{tree}'),initialStatus:'CLEAN',basis:'Direct git status --porcelain=v1 at 2026-09-29T13:16:35Z before any refresh files existed.'});
const production=packageFiles.map(p=>record('repositories/memoryos-readiness/'+p));for(const r of production)assert.equal(hash(git('show',C3RB+':'+r.path)),r.sha256,r.path);
assert.equal(git('diff',C3R,C3RB,'--','repositories/memoryos-readiness').length,0);
const binding=json('repositories/cca-conformance/evidence/mo1307/phase3a-readset-correction/binding.json');assert.equal(binding.implementation.commit,C3R);assert.equal(str('show','-s','--format=%P',C3R),binding.implementation.parent);for(const r of binding.members){check(r);assert.equal(hash(git('show',C3R+':'+r.path)),r.sha256,r.path);}
const historicalRoot=path.join(root,'repositories/cca-conformance/evidence/mo1307');const historical=fs.readdirSync(historicalRoot).filter(n=>n!=='phase3a-refresh').sort().flatMap(n=>walk(path.join(historicalRoot,n))).map(p=>record(p));
const old='C:/Users/melsa/Documents/Codex/cca-mo1307-3a';const oldFiles=['docs/mo1307-phase3a-runtime-certification.md','docs/mo1307-phase3a-readset-diagnostic.md',...walk(path.join(old,'repositories/cca-conformance/evidence/mo1307/phase3a')),...walk(path.join(old,'repositories/cca-conformance/evidence/mo1307/phase3a-readset-diagnostic'))].map(p=>record(path.resolve(old,p)));
write('historical-before.json',{current:historical,original3A:oldFiles,originalRoot:old,readOnly:true,status:git('-C',old,'status','--porcelain=v1','--untracked-files=all').toString(),head:str('-C',old,'rev-parse','HEAD')});
write('candidate-before.json',{result:'PASS',C3RB,C3R,B2:binding.implementation.parent,packageCheck:checkPackage(),members:production,binding:record('repositories/cca-conformance/evidence/mo1307/phase3a-readset-correction/binding.json'),contract:record('repositories/memoryos-readiness/contracts/contract.json'),helper:record('repositories/memoryos-readiness/helpers/windows-inspect.ps1'),distribution:record('repositories/memoryos-readiness/distribution-manifest.json'),sbom:record('repositories/memoryos-readiness/sbom.spdx.json'),productionChangesInC3RB:false});
function command(id,exe,args,cwd=root,extraEnv={}){const start=performance.now();const r=spawnSync(exe,args,{cwd,env:{...env,...extraEnv},windowsHide:true,encoding:null,timeout:120000,maxBuffer:16*1024*1024});const receipt={executable:exe,args,cwd,exit:r.status,error:r.error?.code??null,elapsedMs:performance.now()-start,stdout:put(id+'.stdout.txt',r.stdout??Buffer.alloc(0)),stderr:put(id+'.stderr.txt',r.stderr??Buffer.alloc(0))};write(id+'.json',receipt);assert.ifError(r.error);assert.equal(r.status,0,r.stderr?.toString());return r.stdout;}
const ps='C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe';
const psScript="$os=Get-CimInstance Win32_OperatingSystem; $cs=Get-CimInstance Win32_ComputerSystem; [ordered]@{osCaption=$os.Caption;version=$os.Version;build=$os.BuildNumber;architecture=$os.OSArchitecture;manufacturer=$cs.Manufacturer;model=$cs.Model;powerShellPath=(Get-Process -Id $PID).Path;powerShellVersion=$PSVersionTable.PSVersion.ToString();policy=@(Get-ExecutionPolicy -List | ForEach-Object {[ordered]@{scope=$_.Scope.ToString();policy=$_.ExecutionPolicy.ToString()}})} | ConvertTo-Json -Depth 5 -Compress";
const system=JSON.parse(command('environment-capture',ps,['-NoLogo','-NoProfile','-NonInteractive','-Command',psScript]));assert.match(system.powerShellVersion,/^5\.1\./);
const npm=path.join(path.dirname(process.execPath),'node_modules/npm/bin/npm-cli.js');assert.equal(command('npm-version',process.execPath,[npm,'--version']).toString().trim(),'11.19.0');
write('runtime.json',{result:'PASS',node:{executable:process.execPath,version:process.version,arch:process.arch,platform:process.platform,...record(process.execPath)},powershell:{...system,identity:record(ps)},npm:{executable:npm,version:'11.19.0',engineeringOnly:true},launchEnvironment:env,persistentPolicyMutation:false});
for(const n of ['npm-cache','install','cwd'])fs.mkdirSync(path.join(cache,n));for(const n of ['user.npmrc','global.npmrc'])fs.writeFileSync(path.join(cache,n),'',{flag:'wx'});
const npmArgs=['--offline','--ignore-scripts','--no-audit','--no-fund','--cache',path.join(cache,'npm-cache'),'--userconfig',path.join(cache,'user.npmrc'),'--globalconfig',path.join(cache,'global.npmrc')];
const packed=JSON.parse(command('package-pack',process.execPath,[npm,'pack','--json','--pack-destination',cache,...npmArgs],path.join(root,'repositories/memoryos-readiness'),{PATH:path.dirname(process.execPath),TEMP:cache,TMP:cache}));assert.equal(packed.length,1);assert.deepEqual(packed[0].files.map(r=>r.path).sort(),[...packageFiles]);
const archive=path.join(cache,packed[0].filename);put('package/memoryos-readiness-0.1.0.tgz',fs.readFileSync(archive));
fs.writeFileSync(path.join(cache,'install/package.json'),JSON.stringify({name:'mo1307-phase3a-refresh-offline',version:'1.0.0',private:true})+'\n',{flag:'wx'});
command('offline-install',process.execPath,[npm,'install',archive,...npmArgs],path.join(cache,'install'),{PATH:path.dirname(process.execPath),TEMP:cache,TMP:cache});
const installed=inventory(packageRoot);assert.deepEqual(installed,inventory(path.join(root,'repositories/memoryos-readiness')));assert.equal(installed.length,89);checkPackage(packageRoot);for(const r of production)check(r);
write('installed-before.json',{result:'PASS',members:installed,packageRoot,sourceAndC3RBEqual:true,noScripts:true,offline:true});
write('candidate-identity.json',{result:'PASS',C3RB,C3R,packageRoot,packageName:'memoryos-readiness',version:'0.1.0',members:89,archive:record('repositories/cca-conformance/evidence/mo1307/phase3a-refresh/package/memoryos-readiness-0.1.0.tgz'),runtime:record(process.execPath),npmPack:packed[0],repositoryAuthority:record('repositories/cca-conformance/tools/mo1307-phase1/package.mjs'),duplicate3BR:false});
