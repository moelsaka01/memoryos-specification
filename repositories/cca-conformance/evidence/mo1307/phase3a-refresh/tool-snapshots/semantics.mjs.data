// Finite installed C3RB campaign. Standalone CLI acceptance and separately scoped
// real-orchestrator lifecycle observation. No helper frames or workers replaced.
import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import {spawnSync} from 'node:child_process';
import {Writable} from 'node:stream';
import {pathToFileURL} from 'node:url';
import {root,E,cache,packageRoot,env,hash,read,json,record,check,inventory,write,put,identity,canonical} from './common.mjs';
identity();const phase=process.argv[2];assert.ok(['core','observed','additional'].includes(phase));
const names=['mo1306-qualified','ready','qualified','not-ready','could-not-evaluate','rest-qualified','post-tag-ready','pre-tag-present','post-tag-absent','post-tag-lightweight','post-tag-wrong-target'];
const exitFor={READY:0,READY_WITH_QUALIFICATIONS:2,NOT_READY:3,COULD_NOT_EVALUATE:4};
const scratch=path.join(cache,'vectors');
const out='semantics/'+phase;assert.equal(fs.existsSync(path.join(E,out)),false);
const before=inventory(packageRoot);const bindings=[];
const prepared=new Map();
const nativeArgs=(c,operation,destination,decision=null)=>[operation,'--input-root',c.inputRoot,'--config','configuration.json','--authority','authority.json','--authority-sha256',c.pins.trustedAuthorityDigest,'--candidate-sha256',c.pins.expectedCandidateDigest,operation==='evaluate'?'--output-root':'--result-root',destination,...(decision?['--decision',decision]:[])];
function prepare(name,index){const dir=path.join(root,'repositories/cca-conformance/fixtures/mo1307/bundles',name),r=n=>fs.readFileSync(path.join(dir,n));const pins=JSON.parse(r('pins.json')),manifest=JSON.parse(r('manifest.json')),bytes=r('expected-result.json'),value=JSON.parse(bytes);const caseRoot=path.join(scratch,'v'+index);const c={name,pins,manifest,bytes,value,caseRoot,inputRoot:path.join(caseRoot,'i'),parent:path.join(caseRoot,'p')};c.destination=path.join(c.parent,'r');c.observedDestination=path.join(c.parent,'o');c.repeatDestination=path.join(c.parent,'s');c.input={configurationBytes:r('configuration.json'),candidateBytes:r('candidate.json'),authorityBytes:r('authority.json'),manifestBytes:r('manifest.json'),files:manifest.entries.map(x=>({id:x.id,bytes:r(x.path)})),expectedCandidateDigest:pins.expectedCandidateDigest,trustedAuthorityDigest:pins.trustedAuthorityDigest};assert.deepEqual(bytes,canonical(value));
 if(phase==='core'){fs.mkdirSync(caseRoot,{recursive:true});fs.cpSync(dir,c.inputRoot,{recursive:true});fs.mkdirSync(c.parent);fs.writeFileSync(path.join(c.parent,'owned-parent.txt'),'Private stable publication parent for Phase3A refresh.\n',{flag:'wx'});}
 bindings.push({name,members:inventory(dir),inputMembers:inventory(c.inputRoot)});prepared.set(name,c);return c;}
if(phase==='core'){assert.equal(fs.existsSync(scratch),false);fs.mkdirSync(scratch);}
names.forEach(prepare);
const load=n=>import(pathToFileURL(path.join(packageRoot,'src',n+'.mjs')).href);
const api=await load('index');assert.deepEqual(Object.keys(api).sort(),['evaluateReadiness','verifyReadiness']);
const rows=[];let failure=null;
const error=e=>({code:e?.code??null,stage:e?.stage??null,message:String(e?.message??e),stack:e?.stack??null});
function compare(a,b){assert.deepEqual(Buffer.from(a),Buffer.from(b));const x=JSON.parse(Buffer.from(a)),y=JSON.parse(Buffer.from(b));assert.deepEqual(Buffer.from(a),canonical(x));assert.equal(x.assessment.gates.length,22);const fields=['candidate','candidateDigest','profile','stage','gates','blockers','cneReasons','qualifications','history','providers','readiness'];for(const key of fields)assert.deepEqual(x.assessment[key],y.assessment[key],key);assert.equal(x.readinessDigest,y.readinessDigest);assert.equal(x.proofBindingDigest,y.proofBindingDigest);return {fields:[...fields,'readinessDigest','proofBindingDigest','canonicalResultBytes'],readiness:x.assessment.readiness,readinessDigest:x.readinessDigest,proofBindingDigest:x.proofBindingDigest,sha256:hash(a),byteLength:a.length,gates:22,qualifications:x.assessment.qualifications.length};}
const summary=(c,operation,decision=null)=>canonical({kind:'MemoryOSReadinessSummary',version:'1.0.0',operation,readiness:c.value.assessment.readiness,readinessDigest:c.value.readinessDigest,proofBindingDigest:c.value.proofBindingDigest,blockerCount:c.value.assessment.blockers.length,qualificationCount:c.value.assessment.qualifications.length,cneCount:c.value.assessment.cneReasons.length,decision});
write(out+'/campaign.json',{phase,startedAt:new Date().toISOString(),standalone:true,installedPackage:packageRoot,source:record('repositories/cca-conformance/tools/mo1307-phase3a-refresh/semantics.mjs'),before,fixtures:bindings,plan:phase==='core'?{native:['mo1306-qualified','ready','qualified','not-ready','could-not-evaluate','rest-qualified'],operations:['evaluate','verify'],api:['evaluate','verify'],repeat:['ready evaluate new process/session/output'],noRetry:true}:phase==='observed'?{nativeObserved:['mo1306-qualified evaluate','mo1306-qualified verify'],actualProductionOrchestrator:true,realTransport:true,realWorker:true,syntheticFrames:false,limitOverrides:false,scope:'Separate real lifecycle observation following standalone acceptance; not a standalone-bin launch.'}:{native:['post-tag-ready','pre-tag-present','post-tag-absent','post-tag-lightweight','post-tag-wrong-target'],operations:['evaluate','verify'],decisions:8},qualifiedChoice:'Canonical integrated qualified is distinct and required by Phase2D methodology; both execute.',guardMs:45000,guardIsNotProductSettlementLimit:true});
function bin(c,operation,destination,folder,decision=null,expectedDecision=null,expectedExit=null){const args=[path.join(packageRoot,'bin/memoryos-readiness.mjs'),...nativeArgs(c,operation,destination,decision)],at=performance.now();const r=spawnSync(process.execPath,args,{cwd:path.join(cache,'cwd'),env,windowsHide:true,shell:false,encoding:null,timeout:45000,maxBuffer:1024*1024});const row={kind:'standalone-installed-cli',name:c.name,operation,decision,args,cwd:path.join(cache,'cwd'),environment:env,elapsedMs:performance.now()-at,exit:r.status,signal:r.signal,error:r.error?.code??null,expectedExit:expectedExit??(operation==='verify'?0:exitFor[c.value.assessment.readiness]),stdout:put(folder+'/stdout.data',r.stdout??Buffer.alloc(0)),stderr:put(folder+'/stderr.data',r.stderr??Buffer.alloc(0)),result:'FAIL'};try{assert.ifError(r.error);assert.equal(r.signal,null);assert.equal(r.status,row.expectedExit,r.stderr?.toString());if(row.expectedExit===25){assert.equal(r.stdout.length,0);assert.match(r.stderr.toString(),/MO1307_DECISION_MISMATCH/);}else{assert.equal(r.stderr.length,0);assert.deepEqual(r.stdout,summary(c,operation,expectedDecision));row.parity=compare(fs.readFileSync(path.join(destination,'memoryos-readiness-result.json')),c.bytes);assert.deepEqual(fs.readdirSync(destination),['memoryos-readiness-result.json']);}row.result='PASS';return row;}catch(e){row.failure=error(e);throw e;}finally{rows.push(row);write(folder+'/receipt.json',row);}}
async function publicApi(c){const at=performance.now(),row={kind:'public-byte-api',name:c.name,result:'FAIL'};try{const evaluated=await api.evaluateReadiness(c.input);row.evaluateParity=compare(evaluated.resultBytes,c.bytes);const verified=await api.verifyReadiness({...c.input,resultBytes:Buffer.from(evaluated.resultBytes),decisionBytes:null});row.verifyParity=compare(verified.resultBytes,c.bytes);assert.equal(verified.decision,null);row.result='PASS';}catch(e){row.failure=error(e);throw e;}finally{row.elapsedMs=performance.now()-at;rows.push(row);write(out+'/'+c.name+'/api.json',row);}}
try{
 if(phase==='core'){
  for(const name of names.slice(0,6)){const c=prepared.get(name);await publicApi(c);bin(c,'evaluate',c.destination,out+'/'+name+'/evaluate');bin(c,'verify',c.destination,out+'/'+name+'/verify');if(name==='mo1306-qualified'){assert.equal(c.value.assessment.readiness,'READY_WITH_QUALIFICATIONS');assert.equal(c.value.assessment.qualifications.length,10);}}
  const c=prepared.get('ready');bin(c,'evaluate',c.repeatDestination,out+'/ready/repeat');assert.deepEqual(fs.readFileSync(path.join(c.destination,'memoryos-readiness-result.json')),fs.readFileSync(path.join(c.repeatDestination,'memoryos-readiness-result.json')));
 }
 if(phase==='observed'){
  const [{createSupervisor},{createHelperTransport,helperLaunchSpecification},{decodeHelperRequest,decodeHelperResponse},{orchestrateCli},{parseCliArgs,validateLaunch}]=await Promise.all(['runtime','helper-transport','helper-protocol','cli','cli-args'].map(load));
  validateLaunch({platform:process.platform,arch:process.arch,version:process.version,execArgv:process.execArgv,environment:process.env});
  const c=prepared.get('mo1306-qualified');
  for(const operation of ['evaluate','verify']){const supervisor=createSupervisor({kind:'cli'}),transport=createHelperTransport(supervisor),requests=[],frames=[],stdout=[];const launch=parseCliArgs(nativeArgs(c,operation,c.observedDestination));const at=performance.now();const row={kind:'installed-production-orchestrator-observation',name:c.name,operation,result:'FAIL',launch:helperLaunchSpecification(),requests};
   try{const outcome=await orchestrateCli(launch,{supervisor,exchange:async frame=>{const request=decodeHelperRequest(frame);const q={sequence:request.sequence,operation:request.operation,session:request.session,files:request.files.length,startedAt:performance.now()};requests.push(q);try{const a=await transport.exchange(frame);q.finishedAt=performance.now();q.durationMs=q.finishedAt-q.startedAt;q.marginMs=5000-q.durationMs;q.status=decodeHelperResponse(a.responseBytes,request).status;q.exitConfirmed=a.exitConfirmed;frames.push({sequence:q.sequence,request:Buffer.from(frame),response:Buffer.from(a.responseBytes)});return a;}catch(e){q.finishedAt=performance.now();q.durationMs=q.finishedAt-q.startedAt;q.failure=error(e);throw e;}},stdout:new Writable({write(b,_e,cb){stdout.push(Buffer.from(b));cb();}})});row.outcome=outcome;assert.equal(outcome.exitCode,operation==='evaluate'?2:0);assert.deepEqual(Buffer.concat(stdout),summary(c,operation));row.parity=compare(fs.readFileSync(path.join(c.observedDestination,'memoryos-readiness-result.json')),c.bytes);assert.ok(requests.find(q=>q.sequence===3).durationMs<5000);row.result='PASS';}catch(e){row.failure=error(e);throw e;}finally{await supervisor.dispose();row.elapsedMs=performance.now()-at;row.snapshot=supervisor.snapshot();row.frames=frames.map(f=>({sequence:f.sequence,request:put(out+'/'+operation+'/'+f.sequence+'.request.bin',f.request),response:put(out+'/'+operation+'/'+f.sequence+'.response.bin',f.response)}));row.stdout=put(out+'/'+operation+'/stdout.data',Buffer.concat(stdout));rows.push(row);write(out+'/'+operation+'/receipt.json',row);}
   assert.equal(row.snapshot.helpers,operation==='evaluate'?9:4);assert.equal(row.snapshot.workers,1);assert.equal(row.snapshot.cleanupConfirmed,true);
  }
 }
 if(phase==='additional'){
  for(const name of names.slice(6)){const c=prepared.get(name);await publicApi(c);bin(c,'evaluate',c.destination,out+'/'+name+'/evaluate');bin(c,'verify',c.destination,out+'/'+name+'/verify');}
  const decisions=[['ready','APPROVE'],['ready','REJECT'],['qualified','APPROVE'],['mo1306-qualified','APPROVE'],['not-ready','APPROVE'],...['candidateDigest','readinessDigest','proofBindingDigest'].map(k=>['ready','APPROVE',k])];
  for(const [i,[name,decision,mismatch]] of decisions.entries()){const c=prepared.get(name);const value={kind:'MemoryOSReadinessHumanDecision',version:'1.0.0',candidateDigest:c.value.assessment.candidateDigest,readinessDigest:c.value.readinessDigest,proofBindingDigest:c.value.proofBindingDigest,decision,actor:null,timestamp:null,reason:'Certification vector; no human release authorization.',attestation:null,authenticity:'NOT_VERIFIED_BY_MEMORYOS'};if(mismatch)value[mismatch]='sha256:'+'f'.repeat(64);const bytes=canonical(value),file='decision-'+i+'.json';fs.writeFileSync(path.join(c.inputRoot,file),bytes,{flag:'wx'});const projection=mismatch?null:{decision,consistency:name==='not-ready'?'CONTRARY_TO_READINESS':'CONSISTENT',authenticity:'NOT_VERIFIED_BY_MEMORYOS'};let apiError=null,v=null;try{v=await api.verifyReadiness({...c.input,resultBytes:c.bytes,decisionBytes:bytes});}catch(e){apiError=e;}if(mismatch){assert.equal(apiError?.code,'MO1307_DECISION_MISMATCH');}else{assert.equal(apiError,null);assert.deepEqual(v.decision,projection);compare(v.resultBytes,c.bytes);}const row=bin(c,'verify',c.destination,out+'/decisions/'+i,file,projection,mismatch?25:0);row.apiDecisionParity=true;write(out+'/decisions/'+i+'/decision-binding.json',{name,decision,mismatch:mismatch??null,input:put(out+'/decisions/'+i+'/input.json',bytes),projection,computedReadinessUnaffected:true,authenticity:'NOT_VERIFIED_BY_MEMORYOS',apiDecisionParity:true});}
 }
}catch(e){failure=error(e);}
finally{const after=inventory(packageRoot);let integrity='PASS';try{assert.deepEqual(after,before);}catch(e){integrity='FAIL';failure??=error(e);}write(out+'/installed-after.json',{result:integrity,members:after});const receipt={phase,result:failure?'FAIL':'PASS',failure,rows,installedIntegrity:integrity,finishedAt:new Date().toISOString(),noRetries:true,noProductionChanges:true};write(out+'/receipt.json',receipt);console.log(JSON.stringify({phase,result:receipt.result,failure,cases:rows.map(r=>({name:r.name,operation:r.operation,kind:r.kind,result:r.result,exit:r.exit,elapsedMs:r.elapsedMs}))}));process.exitCode=failure?1:0;}
