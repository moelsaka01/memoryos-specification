{
  "conclusion": "NO_BLOCKING_FINDINGS",
  "findings": [
    {
      "id": "R1-H-01",
      "severity": "BLOCKING",
      "summary": "First review: swapper absorbStray raced live appenders (ENOENT/ENOTEMPTY not tolerated) and could burn a certifying generation.",
      "disposition": "FIXED",
      "note": "swapper.mjs: ENOENT skipped per entry, ENOTEMPTY/EEXIST retried from a fresh listing, 60 s bound; 3A-G6 15 of 15 dev runs PASS after the fix; confirmed correct and complete by the second review (R2-H-05)."
    },
    {
      "id": "R1-H-02",
      "severity": "NON_BLOCKING",
      "summary": "Appenders in 3A-G6 are capped at 10 runs each, so the racing window is thinner than the 200-swap count suggests.",
      "disposition": "ACCEPTED_WITH_DISCLOSURE",
      "note": "Assertions are not vacuous; tightening adds timeout failure modes (second review R2-H-09 agrees). Disclosed in docs/mo1308-phase3a-g6-swapper-finding.md."
    },
    {
      "id": "R1-H-03",
      "severity": "NON_BLOCKING",
      "summary": "3A-F1 does not assert barrier.allArrived (F7 does).",
      "disposition": "ACCEPTED_WITH_DISCLOSURE",
      "note": "Tightening adds a harness-timeout failure mode (R2-H-09 agrees); disclosed."
    },
    {
      "id": "R1-H-04",
      "severity": "NOTE",
      "summary": "swapper drops a stray name that already exists in the saved directory without reporting it.",
      "disposition": "FIXED",
      "note": "droppedStrayNames is now reported by the swapper."
    },
    {
      "id": "R1-H-05",
      "severity": "NOTE",
      "summary": "win.mjs:200 diagnostic regex /s+/ instead of /s+/.",
      "disposition": "FIXED",
      "note": "Fixed (diagnostic text only)."
    },
    {
      "id": "R1-H-06",
      "severity": "NOTE",
      "summary": "A8.12 clean-tree check reviewed: no way for a stray path to hide.",
      "disposition": "ACCEPTED_WITH_DISCLOSURE",
      "note": "No change needed (env.mjs worktreePorcelain, -z, --untracked-files=all, exact path or path plus slash, rename needs both sides inside); confirmed again by the second review."
    },
    {
      "id": "R2-H-04",
      "severity": "NON_BLOCKING",
      "summary": "win.mjs reachedInfo reads <id>.reached right after it appears; the preload writes it non-atomically, so an empty read is possible with low probability (under 1% per use).",
      "disposition": "ACCEPTED_WITH_DISCLOSURE",
      "note": "Not fixed to keep the reviewed bytes stable; ten rehearsals did not hit it. If it occurs in a certifying run it is a HARNESS defect with a preserved generation, to be fixed (atomic write or retrying read) before the next generation."
    },
    {
      "id": "R2-H-05",
      "severity": "NON_BLOCKING",
      "summary": "Swapper fixes are correct and complete; residual: a stray directory with the same name as one in the saved directory is dropped even if the saved one is partial.",
      "disposition": "ACCEPTED_WITH_DISCLOSURE",
      "note": "G6 accepts typed LEDGER_CORRUPT / RECORD_BYTES_MISMATCH at the final verify; droppedStrayNames is reported (0 in all 15 dev runs)."
    },
    {
      "id": "R2-H-06",
      "severity": "NON_BLOCKING",
      "summary": "hostcapture.py (3A-A1) creates and removes an empty uniquely named directory in the worktree root for the 8.3 probe.",
      "disposition": "ACCEPTED_WITH_DISCLOSURE",
      "note": "Benign: empty, removed at once, ignored by git; 3A-A3 is unaffected (a rehearsal and a gate run showed it)."
    },
    {
      "id": "R2-H-07",
      "severity": "NON_BLOCKING",
      "summary": "M1 skips registered ledgers that no longer exist without asserting a count; M4 does not compare the scratch listing.",
      "disposition": "ACCEPTED_WITH_DISCLOSURE",
      "note": "Weak spots, not wrong results; neither can currently fail for the reasons the protocol states; disclosed."
    },
    {
      "id": "R2-H-08",
      "severity": "NOTE",
      "summary": "Five small observations (E1(b) via openSync events only, J12 wall-clock gate, L3 pipe timing, F5/F6 accept MO1308_IO losers, step guard vs swapper deadline).",
      "disposition": "ACCEPTED_WITH_DISCLOSURE",
      "note": "No action required; kept as disclosures."
    }
