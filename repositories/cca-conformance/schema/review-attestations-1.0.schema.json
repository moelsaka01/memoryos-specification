{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cca://schemas/memoryos/review-attestations/1.0",
  "title": "MemoryOS Requirement Review Attestations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "implementation", "implementationRevisionDigest", "reviewRecordId",
    "reviewer", "assessmentDate", "attestations"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "implementation": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "implementationRevisionDigest": {
      "type": "string", "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reviewRecordId": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "assessmentDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "attestations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "requirementId", "implementation", "artifacts", "criterion", "observedOutcome",
          "reviewer", "date", "reviewRecordId", "implementationRevisionDigest", "result", "durableEvidence"
        ],
        "properties": {
          "requirementId": { "type": "string", "minLength": 1 },
          "implementation": { "$ref": "#/properties/implementation" },
          "artifacts": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "criterion": { "type": "string", "minLength": 1 },
          "observedOutcome": { "type": "string", "minLength": 1 },
          "reviewer": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "reviewRecordId": { "type": "string", "minLength": 1 },
          "implementationRevisionDigest": {
            "type": "string", "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "result": { "enum": ["PASS", "FAIL"] },
          "durableEvidence": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": {
              "properties": { "result": { "const": "FAIL" } },
              "required": ["result"]
            },
            "then": { "required": ["reason"] },
            "else": { "not": { "required": ["reason"] } }
          }
        ]
      }
    }
  }
}
