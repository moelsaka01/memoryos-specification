{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cca://schemas/memoryos/conformance-evidence/1.0",
  "title": "MemoryOS Conformance Evidence Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "implementation", "sourceInventory",
    "reviewEvidence", "assessor", "assessmentDate",
    "executions", "evidence", "reviews", "requirementEvidence"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "implementation": { "$ref": "#/$defs/implementation" },
    "nativeProjectionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "version"],
      "properties": {
        "identifier": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "sourceInventory": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/inputInventoryRecord" }
    },
    "reviewEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "reviewRecordId", "implementationRevisionDigest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "reviewRecordId": { "type": "string", "minLength": 1 },
        "implementationRevisionDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "assessor": { "type": "string", "minLength": 1 },
    "assessmentDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "executionEnvironment": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 },
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 },
        "python": { "type": "string", "minLength": 1 },
        "nativeBuild": { "type": "string", "minLength": 1 }
      }
    },
    "nativeBuildAttestation": { "$ref": "#/$defs/nativeBuildAttestation" },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variantEnvironment", "executions"],
      "properties": {
        "variantEnvironment": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": {
            "anyOf": [
              { "type": "string" },
              { "type": "null" }
            ]
          }
        },
        "executions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/properties/executions/items" }
        }
      }
    },
    "executions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "command", "executablePath", "executableDigest", "argv", "cwd", "environment",
          "inputInventory", "inputDigest", "stdoutDigest", "stderrDigest",
          "expectedTests", "allowedSkips", "rawChecks", "tests", "pass", "skipped",
          "fail", "checks", "diagnostics", "status", "exitCode"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "executablePath": { "type": "string", "minLength": 1 },
          "executableDigest": { "$ref": "#/$defs/sha256" },
          "argv": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "cwd": { "type": "string", "minLength": 1 },
          "environment": {
            "type": "object",
            "propertyNames": { "type": "string", "minLength": 1 },
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "inputInventory": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/inputInventoryRecord" }
          },
          "inputDigest": { "$ref": "#/$defs/sha256" },
          "stdoutDigest": { "$ref": "#/$defs/sha256" },
          "stderrDigest": { "$ref": "#/$defs/sha256" },
          "expectedTests": { "type": "integer", "minimum": 0 },
          "allowedSkips": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "rawChecks": {
            "type": "array",
            "items": { "$ref": "#/$defs/rawCheck" }
          },
          "tests": { "type": "integer", "minimum": 0 },
          "pass": { "type": "integer", "minimum": 0 },
          "skipped": { "type": "integer", "minimum": 0 },
          "fail": { "type": "integer", "minimum": 0 },
          "checks": {
            "type": "array",
            "items": { "$ref": "#/$defs/check" }
          },
          "diagnostics": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "status": { "enum": ["PASS", "FAIL"] },
          "exitCode": { "type": "integer" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": { "$ref": "cca://schemas/memoryos/conformance-report/1.0#/properties/evidence/items" }
    },
    "reviews": {
      "type": "array",
      "items": { "$ref": "#/$defs/review" }
    },
    "requirementEvidence": {
      "type": "array",
      "minItems": 218,
      "maxItems": 218,
      "items": { "$ref": "#/$defs/requirementEvidence" }
    }
  },
  "$defs": {
    "nativeBuildAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRevision", "buildInputInventory", "buildInputDigest", "tools", "dependencies", "resources",
        "buildDirectory", "configures", "builds", "configurationArtifacts", "targets", "artifacts"
      ],
      "properties": {
        "sourceRevision": { "type": "string", "minLength": 1 },
        "buildInputInventory": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/inputInventoryRecord" }
        },
        "buildInputDigest": { "$ref": "#/$defs/sha256" },
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "path", "sha256", "version"],
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "version": { "type": "string", "minLength": 1 }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["identifier", "version", "role", "root", "inventory", "sha256"],
            "properties": {
              "identifier": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 },
              "root": { "type": "string", "minLength": 1 },
              "inventory": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/resourceInventoryRecord" }
              },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "root", "inventory", "sha256"],
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "root": { "type": "string", "minLength": 1 },
              "inventory": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/resourceInventoryRecord" }
              },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "buildDirectory": { "type": "string", "minLength": 1 },
        "configures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nativeBuildStep" }
        },
        "builds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nativeBuildStep" }
        },
        "configurationArtifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nativeArtifact" }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nativeArtifact" }
        }
      }
    },
    "nativeBuildStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "argv", "cwd", "stdoutDigest", "stderrDigest", "exitCode"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "cwd": { "type": "string", "minLength": 1 },
        "stdoutDigest": { "$ref": "#/$defs/sha256" },
        "stderrDigest": { "$ref": "#/$defs/sha256" },
        "exitCode": { "type": "integer" }
      }
    },
    "nativeArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "resourceInventoryRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "inputInventoryRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["file", "directory"] },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "selector", "status"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "selector": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASS", "SKIP", "FAIL"] }
      }
    },
    "rawCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "status"],
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASS", "SKIP", "FAIL"] }
      }
    },
    "coverageSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executionReference", "source", "selector"],
      "properties": {
        "executionReference": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "selector": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementId", "implementation", "artifacts", "criterion", "observedOutcome",
        "reviewer", "date", "reviewRecordId", "implementationRevisionDigest", "result", "durableEvidence"
      ],
      "properties": {
        "requirementId": { "type": "string", "minLength": 1 },
        "implementation": { "$ref": "#/$defs/implementation" },
        "artifacts": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "criterion": { "type": "string", "minLength": 1 },
        "observedOutcome": { "type": "string", "minLength": 1 },
        "reviewer": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "reviewRecordId": { "type": "string", "minLength": 1 },
        "implementationRevisionDigest": { "$ref": "#/$defs/sha256" },
        "result": { "enum": ["PASS", "FAIL"] },
        "durableEvidence": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "result": { "const": "FAIL" } },
            "required": ["result"]
          },
          "then": { "required": ["reason"] },
          "else": { "not": { "required": ["reason"] } }
        }
      ]
    },
    "requirementEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementId", "status", "verification", "verificationMethods", "verificationCriteria",
        "evidenceGroups", "executionReferences", "coverageSelectors", "inputs",
        "expectedOutcome", "evidenceReferences", "durableEvidence"
      ],
      "properties": {
        "requirementId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASS", "FAIL", "NOT APPLICABLE"] },
        "verification": { "enum": ["automated", "review", "external"] },
        "verificationMethods": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "verificationCriteria": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidenceGroups": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "executionReferences": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "coverageSelectors": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "#/$defs/coverageSelector" }
        },
        "inputs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "expectedOutcome": { "type": "string", "minLength": 1 },
        "observedOutcome": { "type": "string", "minLength": 1 },
        "evidenceReferences": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "durableEvidence": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "enum": ["FAIL", "NOT APPLICABLE"] } },
            "required": ["status"]
          },
          "then": { "required": ["reason"] },
          "else": { "not": { "required": ["reason"] } }
        },
        {
          "if": {
            "properties": { "status": { "const": "NOT APPLICABLE" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "evidenceReferences": { "maxItems": 0 } },
            "not": { "required": ["observedOutcome"] }
          },
          "else": {
            "required": ["observedOutcome"],
            "properties": { "evidenceReferences": { "minItems": 1 } }
          }
        }
      ]
    }
  }
}
