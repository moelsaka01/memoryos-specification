{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cca://schemas/memoryos/independent-assessment/1.0",
  "title": "MemoryOS Independent Assessment Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "standard", "conformance", "implementation", "scope",
    "sourceEvidence", "sourceAssessment", "assessmentDate", "assessor", "method", "outcome",
    "requirementResultsDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "version", "publicationDate", "publicationDigest"],
      "properties": {
        "identifier": { "const": "CCA-MEMORYOS-1.0" },
        "version": { "const": "1.0" },
        "publicationDate": { "const": "2026-09-05" },
        "publicationDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specificationVersion", "suiteIdentifier", "suiteVersion", "manifestDigest"],
      "properties": {
        "specificationVersion": { "const": "1.0.0" },
        "suiteIdentifier": { "const": "memoryos-conformance" },
        "suiteVersion": { "const": "1.0.0" },
        "manifestDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "implementation": { "$ref": "#/$defs/implementation" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "profiles"],
      "properties": {
        "kind": { "enum": ["complete", "profile"] },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/profile" }
        }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessmentLevel", "assessor", "assessmentDate"],
      "properties": {
        "assessmentLevel": { "const": "C2" },
        "assessor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "independent"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "independent": { "const": false }
          }
        },
        "assessmentDate": { "$ref": "#/$defs/date" }
      }
    },
    "assessmentDate": { "$ref": "#/$defs/date" },
    "assessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "independent"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "independent": { "const": true }
      }
    },
    "method": { "enum": ["reviewed", "reproduced"] },
    "outcome": { "const": "PASS" },
    "requirementResultsDigest": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "properties": { "kind": { "const": "complete" } },
            "required": ["kind"]
          }
        },
        "required": ["scope"]
      },
      "then": {
        "properties": {
          "scope": {
            "properties": {
              "profiles": {
                "prefixItems": [
                  { "const": "AI Runtime Adapter" },
                  { "const": "CLI" },
                  { "const": "Cognitive Investigation Explorer" },
                  { "const": "Cognitive Regression" },
                  { "const": "Investigation Core" },
                  { "const": "MIP Integration" },
                  { "const": "Native Investigation Artifacts" },
                  { "const": "Runtime Observation Boundary" },
                  { "const": "SDK" }
                ],
                "minItems": 9,
                "maxItems": 9
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "standardVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "profile": {
      "enum": [
        "AI Runtime Adapter",
        "CLI",
        "Cognitive Investigation Explorer",
        "Cognitive Regression",
        "Investigation Core",
        "MIP Integration",
        "Native Investigation Artifacts",
        "Runtime Observation Boundary",
        "SDK"
      ]
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" },
        "revision": { "type": "string", "minLength": 1 }
      }
    }
  }
}
