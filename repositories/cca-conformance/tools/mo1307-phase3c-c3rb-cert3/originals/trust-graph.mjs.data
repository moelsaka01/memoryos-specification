import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {fileURLToPath} from 'node:url';
import {assessInWorker} from '../../../memoryos-readiness/src/integration.mjs';
import {verifyEvidence} from '../../../memoryos-readiness/src/evidence-verifier.mjs';
import {deriveEvidenceGraph,validateEvidenceGraph} from '../../../memoryos-readiness/src/evidence-graph.mjs';
import {evaluateReadiness,verifyReadiness} from '../../../memoryos-readiness/src/index.mjs';
import {errorExit,serializeError} from '../../../memoryos-readiness/src/errors.mjs';
const root=fileURLToPath(new URL('../../../../',import.meta.url));
const out=path.join(root,'repositories/cca-conformance/evidence/mo1307/phase3c-c3rb-cert2/trust-graph');
fs.mkdirSync(out,{recursive:true});
const stringify=x=>Array.isArray(x)?'['+x.map(stringify).join(',')+']':x&&typeof x==='object'?'{'+Object.keys(x).sort().map(k=>JSON.stringify(k)+':'+stringify(x[k])).join(',')+'}':JSON.stringify(x);
const bytes=x=>Buffer.from(stringify(x)+'\n');
const hash=x=>'sha256:'+createHash('sha256').update(x).digest('hex');
const dh=x=>hash(bytes(x));
const cp=x=>structuredClone(x);
const read=p=>fs.readFileSync(path.join(root,p));
const dec=b=>JSON.parse(Buffer.from(b).toString('utf8'));
const rows=[];
let caseNo=0;
const started=new Date().toISOString();
const identity=p=>({path:p,byteLength:read(p).length,sha256:hash(read(p))});
function load(name='ready'){
 const p='repositories/cca-conformance/fixtures/mo1307/bundles/'+name+'/';
 const m=dec(read(p+'manifest.json')),pins=dec(read(p+'pins.json'));
 return {configurationBytes:read(p+'configuration.json'),candidateBytes:read(p+'candidate.json'),manifestBytes:read(p+'manifest.json'),authorityBytes:read(p+'authority.json'),files:m.entries.map(e=>({id:e.id,bytes:read(p+e.path)})),expectedCandidateDigest:pins.expectedCandidateDigest,trustedAuthorityDigest:pins.trustedAuthorityDigest};
}
function editControl(x,key,fn,repin=true){const v=dec(x[key+'Bytes']);fn(v);x[key+'Bytes']=bytes(v);if(key==='authority'&&repin)x.trustedAuthorityDigest=hash(x.authorityBytes);if(key==='candidate'&&repin)x.expectedCandidateDigest=hash(x.candidateBytes);return v;}
function rebindManifest(x){editControl(x,'authority',a=>a.manifestSha256=hash(x.manifestBytes));}
function fileChange(x,id,fn,{manifest=true,grant=false}={}){
 const f=x.files.find(f=>f.id===id);assert.ok(f,id);f.bytes=Buffer.from(fn(Buffer.from(f.bytes)));
 if(manifest){editControl(x,'manifest',m=>{const e=m.entries.find(e=>e.id===id);e.sha256=hash(f.bytes);e.byteLength=f.bytes.length;if(e.type==='ENVELOPE'){const v=dec(f.bytes);e.candidateBinding=v.claim.originCandidate;e.dependencyIds=v.claim.dependencies.map(d=>d.componentId);}});rebindManifest(x);}
 if(grant){const e=dec(f.bytes);editControl(x,'authority',a=>{const g=a.assessment.grants.find(g=>g.envelopeId===id);g.claimDigest=dh(e.claim);g.envelopeSha256=hash(f.bytes);g.sourceIds=e.sources;g.dependencyIds=e.claim.dependencies.map(d=>d.componentId);});}
}
function envelope(x,id,fn,options={grant:true}){fileChange(x,'envelope.'+id,b=>{const e=dec(b);fn(e);return bytes(e);},options);}
const tuple=(code,stage)=>({accepted:false,code:'MO1307_'+code,stage,exit:({USAGE:10,CONFIGURATION:11,INPUT:12,INTEGRITY:13,CANDIDATE_MISMATCH:14,EVIDENCE_VERSION:15,EVIDENCE_AUTHORITY:16,GRAPH_CYCLE:17,GRAPH_LIMIT:18,STALE_EVIDENCE:19,FILESYSTEM_BOUNDARY:20,OUTPUT:21,INTERNAL:22,QUALIFICATION_MISMATCH:23,HISTORY_MISMATCH:24,PROFILE_MISMATCH:25,RESULT_MISMATCH:26,DECISION_MISMATCH:27,RESOURCE_LIMIT:28,TIMEOUT:29,CANCELLED:30})[code]});
function save(){fs.writeFileSync(path.join(out,'receipt.json'),JSON.stringify({kind:'MO1307Phase3CTrustGraphAudit',version:'1.0.0',started,finished:new Date().toISOString(),baseline:'defe93989efc6501b1a730b82e79e705884b269b',runtime:{path:process.execPath,version:process.version,platform:process.platform,arch:process.arch,sha256:hash(fs.readFileSync(process.execPath))},counts:{cases:rows.length,pass:rows.filter(r=>r.pass).length,fail:rows.filter(r=>!r.pass).length,negative:rows.filter(r=>!r.expected.accepted).length},publicationScope:'All cases use byte API/pure internal validators, which possess no filesystem publication interface; no product publication is possible. Internal graph negatives are defensive seam tests, not public graph inputs.',cases:rows},null,2)+'\n');}
async function test(name,layer,expected,fn,detail={}){
 const start=performance.now();let actual,extra;
 try{extra=await fn();actual={accepted:true,code:null,stage:null,exit:0};}catch(e){actual={accepted:false,code:e.code??e.name,stage:e.stage??null,exit:e.code?errorExit(e):null,reference:e.reference??null};if(!e.code)actual.diagnostic=String(e.message).slice(0,300);}
 const pass=Object.entries(expected).every(([k,v])=>actual[k]===v);
 rows.push({id:'TG-'+String(++caseNo).padStart(3,'0'),name,layer,expected:{...expected,noPublication:true},actual:{...actual,noPublication:true},pass,durationMs:performance.now()-start,...detail,...(extra?{evidence:extra}:{})});save();
 if(!pass){console.log(JSON.stringify(rows.at(-1)));throw new Error('STOP: unexpected case result '+name);}
}
const accept={accepted:true,code:null,stage:null,exit:0};
async function negative(name,mutate,code,stage,layer='semantic-authority',bundle='ready',publicApi=false){await test(name,layer,tuple(code,stage),async()=>{const x=load(bundle);mutate(x);return publicApi?await evaluateReadiness(x):assessInWorker(x,false);},{surface:publicApi?'public-byte-api':'fixed-integrated-worker'});}
function graphOracle(x){
 const c=dec(x.candidateBytes),a=dec(x.authorityBytes),env=new Map(x.files.filter(f=>f.id.startsWith('envelope.')).map(f=>[f.id,dec(f.bytes)]));
 const nodes=new Map(),edges=new Map();const node=(type,value)=>{const d=type==='ASSESSMENT'?null:dh(value),id=type==='ASSESSMENT'?'assessment':type+':'+d;nodes.set(id,{id,type,digest:d});return id;};const edge=(from,type,to)=>{const e={from,type,to};edges.set([from,type,to].join('\0'),e);};
 const root=node('ASSESSMENT'),candidate=node('CANDIDATE',c);edge(root,'ASSESSES',candidate);const normalized=new Map();
 for(const g of a.assessment.grants){const claim=env.get(g.envelopeId).claim;const authorityClasses=[...new Set(g.authoritySourceIds.map(id=>a.provenance.find(p=>p.id===id).classification))].sort();const ng={claimDigest:dh(claim),dependencyIds:g.dependencyIds,scopeId:g.scopeId,assumptions:g.assumptions,applicability:g.applicability,authorityClasses};normalized.set(g.id,dh(ng));const gn=node('GRANT',ng),cn=node('CLAIM',claim);edge(root,'ACCEPTS',gn);edge(gn,'AUTHORIZES',cn);for(const classification of authorityClasses)edge(gn,'ROOTED_IN',node('AUTHORITY',{classification,scopeId:g.scopeId,assumptions:g.assumptions}));if(claim.binding==='WHOLE_CANDIDATE')edge(cn,'DEPENDS_ON',candidate);else for(const d of claim.dependencies)edge(cn,'DEPENDS_ON',node('DEPENDENCY',{id:d.componentId,role:d.role,byteLength:d.byteLength,sha256:d.sha256}));}
 const graph={kind:'MemoryOSReadinessGraph',version:'1.0.0',nodes:[...nodes.values()].sort((a,b)=>a.id<b.id?-1:1),edges:[...edges].sort(([a],[b])=>a<b?-1:1).map(([,e])=>e)};
 const assessment=a.assessment;const normalizedAuthority={candidateDigest:dh(c),profile:assessment.profile,stage:assessment.stage,scopeId:assessment.scopeId,assumptions:assessment.assumptions,requiredComponents:assessment.requiredComponents,semanticContracts:assessment.semanticContracts,normalizedGrants:[...normalized.values()].sort(),slots:assessment.slots.map(s=>({gateId:s.gateId,grantDigests:s.grantIds.map(id=>normalized.get(id)).sort(),availability:s.availability,reason:s.reason}))};
 return {graph,graphDigest:dh(graph),authorityIdentityDigest:dh(normalizedAuthority)};
}
await test('independent graph reconstruction ready and released MO-1306','independent-oracle',accept,()=>{const evidence=[];for(const name of ['ready','mo1306-qualified','selective-reuse']){const x=load(name),a=graphOracle(x),b=verifyEvidence(x).projection;assert.deepEqual(a.graph,b.graph);assert.equal(a.graphDigest,b.graphDigest);assert.equal(a.authorityIdentityDigest,b.authorityIdentityDigest);assert.deepEqual([...new Set(b.graph.nodes.map(n=>n.type))].sort(),['ASSESSMENT','AUTHORITY','CANDIDATE','CLAIM','DEPENDENCY','GRANT']);evidence.push({bundle:name,nodes:b.graph.nodes.length,edges:b.graph.edges.length,graphDigest:b.graphDigest,authorityIdentityDigest:b.authorityIdentityDigest});}return evidence;});
await negative('authority digest substitution',x=>x.trustedAuthorityDigest='sha256:'+'0'.repeat(64),'EVIDENCE_AUTHORITY','CONFIGURATION','trust-bootstrap','ready',true);
await negative('self-authorized complete rewritten root retains operator pin',x=>editControl(x,'authority',a=>a.assessment.scopeId='attacker.scope',false),'EVIDENCE_AUTHORITY','CONFIGURATION','trust-bootstrap');
await negative('configuration attempts to choose trust root',x=>editControl(x,'configuration',c=>c.trustedAuthorityDigest=x.trustedAuthorityDigest),'CONFIGURATION','CONFIGURATION','schema');
await negative('manifest attempts to choose trust root',x=>{editControl(x,'manifest',m=>m.trustedAuthorityDigest=x.trustedAuthorityDigest);rebindManifest(x);},'INPUT','CONFIGURATION','schema');
await negative('claim attempts to choose trust root',x=>envelope(x,'security',e=>e.claim.trustedAuthorityDigest=x.trustedAuthorityDigest),'INPUT','INTEGRITY','schema');
await negative('authority source byte substitution under frozen root',x=>fileChange(x,'authority.fixture',b=>{b[0]^=1;return b;},{manifest:false}),'INTEGRITY','INTEGRITY','raw-byte-integrity');
await negative('authority source digest substitution with manifest rebind',x=>fileChange(x,'authority.fixture',b=>{b[0]^=1;return b;}),'EVIDENCE_AUTHORITY','AUTHORITY');
await negative('wrong evidence type selected by gate',x=>editControl(x,'authority',a=>a.assessment.slots.find(s=>s.gateId==='security').grantIds=['grant.artifact']),'EVIDENCE_AUTHORITY','AUTHORITY');
await negative('wrong provider claim selected by grant',x=>editControl(x,'authority',a=>{for(const s of a.assessment.slots.filter(s=>s.gateId.startsWith('provider.github')))s.grantIds=['grant.provider.gitlab'];}),'EVIDENCE_AUTHORITY','AUTHORITY');
await negative('grant claim digest substitution',x=>editControl(x,'authority',a=>a.assessment.grants.find(g=>g.id==='grant.security').claimDigest='sha256:'+'0'.repeat(64)),'EVIDENCE_AUTHORITY','AUTHORITY');
await negative('grant envelope source substitution',x=>envelope(x,'security',e=>e.sources=['authority.fixture']),'EVIDENCE_AUTHORITY','AUTHORITY');
await negative('grant source set omission versus envelope',x=>editControl(x,'authority',a=>a.assessment.grants.find(g=>g.id==='grant.security').sourceIds=['source.missing']),'INPUT','AUTHORITY');
await negative('grant authority source set omitted',x=>editControl(x,'authority',a=>a.assessment.grants.find(g=>g.id==='grant.security').authoritySourceIds=[]),'INPUT','CONFIGURATION','schema');
await negative('grant dependency set substitution',x=>editControl(x,'authority',a=>a.assessment.grants.find(g=>g.id==='grant.security').dependencyIds=['runtime']),'EVIDENCE_AUTHORITY','AUTHORITY');
await negative('grant scope escalation',x=>editControl(x,'authority',a=>a.assessment.grants.find(g=>g.id==='grant.security').scopeId='all.scope'),'STALE_EVIDENCE','AUTHORITY');
await negative('grant wildcard-like scope',x=>editControl(x,'authority',a=>a.assessment.grants.find(g=>g.id==='grant.security').scopeId='*'),'INPUT','CONFIGURATION','schema');
await negative('grant omitted while slot references it',x=>editControl(x,'authority',a=>a.assessment.grants=a.assessment.grants.filter(g=>g.id!=='grant.security')),'INPUT','AUTHORITY');
await negative('duplicate grant ID',x=>editControl(x,'authority',a=>a.assessment.grants.splice(1,0,cp(a.assessment.grants[0]))),'INPUT','CONFIGURATION','schema');
await negative('same normalized grant under new ID',x=>editControl(x,'authority',a=>{a.assessment.grants.push({...cp(a.assessment.grants[0]),id:'grant.zcopy'});a.assessment.grants.sort((a,b)=>a.id.localeCompare(b.id));}),'INPUT','AUTHORITY');
await negative('claim scope independently escalated',x=>envelope(x,'security',e=>e.claim.scopeId='another.scope'),'STALE_EVIDENCE','AUTHORITY');
await negative('claim assumption added without grant approval',x=>envelope(x,'security',e=>e.claim.assumptions=[{id:'qualification.assumption',sha256:'sha256:'+'9'.repeat(64)}]),'STALE_EVIDENCE','AUTHORITY');
await negative('manifest arrays reversed are rejected, not treated nonsemantic',x=>{editControl(x,'manifest',m=>m.entries.reverse());rebindManifest(x);},'INPUT','CONFIGURATION','schema');
for(const [name,fn] of [['source commit',c=>c.source.commit='9'.repeat(40)],['source tree',c=>c.source.tree='9'.repeat(40)],['archive digest',c=>c.components.find(c=>c.id==='archive').sha256='sha256:'+'9'.repeat(64)],['distribution length',c=>c.components.find(c=>c.id==='distribution').byteLength++],['component identity',c=>c.components.find(c=>c.id==='source-member').id='source-other']])await negative('candidate '+name+' substitution',x=>editControl(x,'candidate',fn,false),'CANDIDATE_MISMATCH','CONFIGURATION','candidate-pin');
await negative('candidate component changed with new candidate pin but old authority',x=>editControl(x,'candidate',c=>c.components.find(c=>c.id==='archive').sha256='sha256:'+'9'.repeat(64)),'CANDIDATE_MISMATCH','AUTHORITY');
await negative('candidate profile substitution',x=>editControl(x,'candidate',c=>c.profile.id='rest'),'PROFILE_MISMATCH','CONFIGURATION','schema');
await negative('configuration stage substitution',x=>editControl(x,'configuration',c=>c.stage='POST_TAG_VERIFICATION'),'CONFIGURATION','CONFIGURATION');
await negative('whole-candidate claim origin substitution',x=>envelope(x,'binding',e=>e.claim.originCandidate='sha256:'+'9'.repeat(64)),'CANDIDATE_MISMATCH','AUTHORITY');
await negative('dependency digest changed under reviewed grant',x=>envelope(x,'security',e=>e.claim.dependencies[0].sha256='sha256:'+'9'.repeat(64)),'STALE_EVIDENCE','AUTHORITY');
await negative('required dependency omitted consistently from envelope manifest grant',x=>envelope(x,'security',e=>e.claim.dependencies=e.claim.dependencies.filter(d=>d.componentId!=='runtime')),'EVIDENCE_AUTHORITY','AUTHORITY');
await negative('dependency unknown ID',x=>envelope(x,'security',e=>{e.claim.dependencies[0].componentId='absent';e.claim.dependencies.sort((a,b)=>a.componentId.localeCompare(b.componentId));}),'INPUT','AUTHORITY');
await negative('duplicate dependency ID',x=>envelope(x,'security',e=>e.claim.dependencies.splice(1,0,cp(e.claim.dependencies[0]))),'INPUT','CONFIGURATION','schema');
await negative('conflicting duplicate dependency ID',x=>envelope(x,'security',e=>e.claim.dependencies.splice(1,0,{...e.claim.dependencies[0],byteLength:99})),'INPUT','CONFIGURATION','schema');
await negative('current-origin claim falsely marked reused',x=>editControl(x,'authority',a=>a.assessment.grants.find(g=>g.id==='grant.security').applicability='REUSED'),'STALE_EVIDENCE','AUTHORITY');
await negative('whole candidate reuse refused',x=>editControl(x,'authority',a=>a.assessment.grants.find(g=>g.id==='grant.binding').applicability='REUSED'),'CANDIDATE_MISMATCH','AUTHORITY');
await negative('old-origin evidence marked current',x=>envelope(x,'security',e=>e.claim.originCandidate='sha256:'+'9'.repeat(64)),'CANDIDATE_MISMATCH','AUTHORITY');
await negative('same filename changed raw bytes',x=>fileChange(x,'fixture.source',b=>{b[0]^=1;return b;},{manifest:false}),'INTEGRITY','INTEGRITY','raw-byte-integrity');
for(let i=0;i<8;i++)await negative('corrected MO-1306 raw configuration source '+i+' tamper with claim and normalized authority unchanged',x=>fileChange(x,'configuration-source.'+i,b=>{b[0]^=1;return b;},{manifest:false}),'INTEGRITY','INTEGRITY','raw-byte-integrity','mo1306-qualified');
await negative('raw source change plus self-consistent manifest/envelopes/root rejected by original operator pin',x=>{const pin=x.trustedAuthorityDigest;fileChange(x,'configuration-source.0',b=>{b[0]^=1;return b;});x.trustedAuthorityDigest=pin;},'EVIDENCE_AUTHORITY','CONFIGURATION','trust-bootstrap','mo1306-qualified',true);
await negative('manifest source digest rebind cannot avoid raw bytes',x=>{editControl(x,'manifest',m=>m.entries.find(e=>e.id==='configuration-source.0').sha256='sha256:'+'9'.repeat(64));rebindManifest(x);},'INTEGRITY','INTEGRITY','raw-byte-integrity','mo1306-qualified');
await negative('raw source omitted despite exact normalized metadata',x=>x.files=x.files.filter(f=>f.id!=='configuration-source.0'),'INPUT','ACQUISITION','source-admission','mo1306-qualified');
await negative('lineage removed from all corrected claims leaves unused raw source',x=>{const a=dec(x.authorityBytes);for(const g of a.assessment.grants.filter(g=>g.sourceIds.includes('configuration-source.0')))envelope(x,g.envelopeId.slice(9),e=>e.sources=e.sources.filter(s=>s!=='configuration-source.0'));},'EVIDENCE_AUTHORITY','AUTHORITY','raw-source-consumption','mo1306-qualified');
await test('metadata-only old/future dates preserve readiness and graph but rebind proof','freshness-proof',accept,()=>{const base=load(),before=assessInWorker(base,false);const details=[];for(const date of ['0001-01-01T00:00:00Z','9999-12-31T23:59:59Z','opaque-not-a-clock']){const x=load();envelope(x,'security',e=>e.metadata.observedAt=date);const after=assessInWorker(x,false);assert.equal(before.readinessDigest,after.readinessDigest);assert.notEqual(before.proofBindingDigest,after.proofBindingDigest);assert.deepEqual(dec(before.resultBytes).assessment.graph,dec(after.resultBytes).assessment.graph);details.push({date,proofBindingDigest:after.proofBindingDigest});}return details;});
await test('new independent reviewed source bytes may preserve readiness but must change raw proof','trusted-re-review-not-authentication',accept,()=>{const x=load(),before=assessInWorker(x,false);fileChange(x,'fixture.source',b=>Buffer.concat([b,Buffer.from('explicit independently reviewed metadata\n')]));const after=assessInWorker(x,false);assert.equal(before.readinessDigest,after.readinessDigest);assert.notEqual(before.proofBindingDigest,after.proofBindingDigest);return {qualification:'New operator root pin represents explicit trusted review. Runtime cannot authenticate reviewer or infer legacy truth.',proofBefore:before.proofBindingDigest,proofAfter:after.proofBindingDigest};});
function rebaseCandidate(x,component){const old=x.expectedCandidateDigest;editControl(x,'candidate',c=>c.components.find(c=>c.id===component).sha256='sha256:'+'8'.repeat(64));const now=x.expectedCandidateDigest,c=dec(x.candidateBytes);editControl(x,'manifest',m=>m.candidateDigest=now);rebindManifest(x);editControl(x,'authority',a=>{a.assessment.candidateDigest=now;a.assessment.requiredComponents=c.components;});const a=dec(x.authorityBytes);for(const g of a.assessment.grants){const e=dec(x.files.find(f=>f.id===g.envelopeId).bytes);if(e.claim.binding==='WHOLE_CANDIDATE'){envelope(x,g.envelopeId.slice(9),e=>e.claim.originCandidate=now);}else if(e.claim.dependencies.some(d=>d.componentId===component)){envelope(x,g.envelopeId.slice(9),e=>{e.claim.originCandidate=now;e.claim.dependencies.find(d=>d.componentId===component).sha256='sha256:'+'8'.repeat(64);});}else editControl(x,'authority',a=>a.assessment.grants.find(row=>row.id===g.id).applicability='REUSED');}return {old,now};}
await test('selective reuse after documentation change preserves unaffected security claim','dependency-reuse',accept,()=>{const x=load(),before=verifyEvidence(x).projection,ids=rebaseCandidate(x,'documentation'),after=verifyEvidence(x).projection;assert.notEqual(ids.old,ids.now);const security=p=>p.claims.find(s=>s.claim.type==='SECURITY_AUDIT');assert.equal(security(before).claimDigest,security(after).claimDigest);assert.equal(after.reuse.find(r=>r.claimDigest===security(after).claimDigest).disposition,'REUSED');const artifact=p=>p.claims.find(s=>s.claim.type==='ARTIFACT_CERTIFICATION');assert.notEqual(artifact(before).claimDigest,artifact(after).claimDigest);assert.equal(dec(assessInWorker(x,false).resultBytes).assessment.readiness,'READY');return {unaffected:security(after).claimDigest,changed:artifact(after).claimDigest,reused:after.reuse.filter(r=>r.disposition==='REUSED').length};});
await negative('relevant dependency changed then old security evidence reused',x=>{const old=dec(x.files.find(f=>f.id==='envelope.security').bytes);rebaseCandidate(x,'runtime');fileChange(x,'envelope.security',()=>bytes(old),{grant:true});editControl(x,'authority',a=>a.assessment.grants.find(g=>g.id==='grant.security').applicability='REUSED');},'STALE_EVIDENCE','AUTHORITY');
await test('unrelated root assumption addition does not invalidate current claims','dependency-reuse',accept,()=>{const x=load();editControl(x,'authority',a=>a.assessment.assumptions=[{id:'unrelated',sha256:'sha256:'+'9'.repeat(64)}]);assert.equal(dec(assessInWorker(x,false).resultBytes).assessment.readiness,'READY');});
const baselineGraph=graphOracle(load()).graph;
function orderGraph(g){g.nodes.sort((a,b)=>a.id<b.id?-1:1);g.edges.sort((a,b)=>[a.from,a.type,a.to].join('\0')<[b.from,b.type,b.to].join('\0')?-1:1);return g;}
for(const [name,fn,code] of [
 ['self cycle',g=>g.edges.push({from:'assessment',type:'ACCEPTS',to:'assessment'}),'GRAPH_CYCLE'],
 ['two-node cycle',g=>g.edges.push({from:g.nodes.find(n=>n.type==='CANDIDATE').id,type:'ASSESSES',to:'assessment'}),'GRAPH_CYCLE'],
 ['long cycle',g=>{const dep=g.nodes.find(n=>n.type==='DEPENDENCY').id;g.edges.push({from:dep,type:'DEPENDS_ON',to:'assessment'});},'GRAPH_CYCLE'],
 ['dangling edge',g=>g.edges.push({from:'assessment',type:'ACCEPTS',to:'GRANT:sha256:'+'0'.repeat(64)}),'INPUT'],
 ['dangling node removed',g=>g.nodes=g.nodes.filter(n=>n.type!=='AUTHORITY'),'INPUT'],
 ['wrong node type SOURCE',g=>g.nodes.find(n=>n.type==='DEPENDENCY').type='SOURCE','INPUT'],
 ['wrong edge type',g=>g.edges[0].type='TRUSTS','INPUT'],
 ['duplicate ID',g=>g.nodes.push(cp(g.nodes[0])),'INPUT'],
 ['conflicting ID',g=>g.nodes.push({...g.nodes[0],digest:'sha256:'+'0'.repeat(64)}),'INPUT'],
 ['unreachable normative claim',g=>{const d='sha256:'+'0'.repeat(64);g.nodes.push({id:'CLAIM:'+d,type:'CLAIM',digest:d});},'INPUT'],
 ['wrong root',g=>{g.nodes.find(n=>n.id==='assessment').id='other';for(const e of g.edges)if(e.from==='assessment')e.from='other';},'INPUT'],
 ['wrong authority root endpoint',g=>g.edges.find(e=>e.type==='ROOTED_IN').to=g.nodes.find(n=>n.type==='CANDIDATE').id,'INPUT'],
 ['duplicate edge',g=>g.edges.push(cp(g.edges[0])),'INPUT'],
 ['wrong expected candidate',g=>{},'CANDIDATE_MISMATCH']])await test('graph '+name,'defensive-internal-graph',tuple(code,'GRAPH'),()=>{const g=cp(baselineGraph);fn(g);return validateEvidenceGraph(orderGraph(g),name==='wrong expected candidate'?{candidateDigest:'sha256:'+'0'.repeat(64)}:{});});
function syntheticGraph(claims,dependencies,extra=0){const nodes=[{id:'assessment',type:'ASSESSMENT',digest:null}],edges=[];const n=(type,i)=>{const digest='sha256:'+i.toString(16).padStart(64,'0'),id=type+':'+digest;nodes.push({id,type,digest});return id;};const c=n('CANDIDATE',1),a=n('AUTHORITY',2);edges.push({from:'assessment',type:'ASSESSES',to:c});const deps=Array.from({length:dependencies},(_,i)=>n('DEPENDENCY',100+i));for(let i=0;i<claims;i++){const g=n('GRANT',3+i),cl=n('CLAIM',20+i);edges.push({from:'assessment',type:'ACCEPTS',to:g},{from:g,type:'AUTHORIZES',to:cl},{from:g,type:'ROOTED_IN',to:a});const count=claims===2?(i===0?1020:dependencies-1020):dependencies-(i>=extra?1:0);const selected=claims===2?(i===0?deps.slice(0,1020):deps.slice(1020)):deps.slice(0,count);for(const d of selected)edges.push({from:cl,type:'DEPENDS_ON',to:d});}return orderGraph({kind:'MemoryOSReadinessGraph',version:'1.0.0',nodes,edges});}
await test('graph exact 2048 nodes','internal-boundary',accept,()=>{const g=syntheticGraph(2,2041);assert.equal(g.nodes.length,2048);validateEvidenceGraph(g);return {nodes:g.nodes.length,edges:g.edges.length};});
await test('graph 2049 nodes rejected before expansion','internal-boundary',tuple('GRAPH_LIMIT','GRAPH'),()=>{const g=syntheticGraph(2,2042);validateEvidenceGraph(g);});
await test('graph exact 8192 edges','internal-boundary',accept,()=>{const g=syntheticGraph(8,1021,7);assert.equal(g.edges.length,8192);validateEvidenceGraph(g);return {nodes:g.nodes.length,edges:g.edges.length};});
await test('graph 8193 edges rejected','internal-boundary',tuple('GRAPH_LIMIT','GRAPH'),()=>{const g=syntheticGraph(8,1021,8);assert.equal(g.edges.length,8193);validateEvidenceGraph(g);});
await test('2048-node cyclic chain bounded rejection','internal-cycle-resource',tuple('GRAPH_CYCLE','GRAPH'),()=>{const g=syntheticGraph(2,2041);g.edges=g.nodes.map((n,i)=>({from:n.id,type:'DEPENDS_ON',to:g.nodes[(i+1)%g.nodes.length].id}));validateEvidenceGraph(orderGraph(g));});
await test('internal nonsemantic claim collection permutation graph identity','graph-determinism',accept,()=>{const x=load(),candidate=dec(x.candidateBytes),authority=dec(x.authorityBytes),claims=x.files.filter(f=>f.id.startsWith('envelope.')).map(f=>({envelopeId:f.id,claim:dec(f.bytes).claim}));const forward=deriveEvidenceGraph({candidate,authority,claims}),reverse=deriveEvidenceGraph({candidate,authority,claims:claims.toReversed()});assert.deepEqual(forward,reverse);return {graphDigest:forward.graphDigest};});
const resultBase=load('mixed-precedence'),resultBytes=assessInWorker(resultBase,false).resultBytes;
function selfHashResult(r){r.assessment.graphDigest=dh(r.assessment.graph);r.readinessDigest=dh({kind:'MemoryOSReadinessIdentity',version:'1.0.0',assessment:r.assessment});r.proofBindingDigest=dh({kind:'MemoryOSReadinessProofBinding',version:'1.0.0',readinessDigest:r.readinessDigest,audit:r.audit});return bytes(r);}
for(const [name,fn] of [
 ['gate vector',r=>r.assessment.gates.find(g=>g.id==='security').state='SATISFIED'],
 ['blockers',r=>r.assessment.blockers=[]],['CNE reasons',r=>r.assessment.cneReasons=[]],['qualifications',r=>r.assessment.qualifications=[]],['history',r=>r.assessment.history=[]],
 ['provider state',r=>r.assessment.providers.find(p=>p.provider==='github').execution='HOSTED_EXECUTION_CERTIFIED'],
 ['readiness state',r=>r.assessment.readiness='READY'],['candidate',r=>r.assessment.candidate.source.commit='9'.repeat(40)],['profile',r=>r.assessment.profile.id='rest'],['stage',r=>r.assessment.stage='POST_TAG_VERIFICATION'],
 ['graph',r=>r.assessment.graph.edges.pop()],['authority identity',r=>r.assessment.authorityIdentityDigest='sha256:'+'9'.repeat(64)],['raw audit',r=>r.audit.inputs[0].sha256='sha256:'+'9'.repeat(64)],['required human actions',r=>r.assessment.requiredHumanActions=[]]
])await test('verify rejects independently self-hashed result '+name,'public-result-recomputation',tuple('RESULT_MISMATCH','VERIFICATION'),async()=>{const selected=name==='history'?load('mo1306-qualified'):resultBase;const original=name==='history'?assessInWorker(selected,false).resultBytes:resultBytes;const r=dec(original),before=bytes(r);fn(r);assert.notDeepEqual(bytes(r),before,'test mutation must change result');return verifyReadiness({...selected,resultBytes:selfHashResult(r),decisionBytes:null});});
for(const name of ['readinessDigest','proofBindingDigest'])await test('verify rejects altered '+name,'public-result-identity',tuple('RESULT_MISMATCH','VERIFICATION'),()=>{const r=dec(resultBytes);r[name]='sha256:'+'9'.repeat(64);return verifyReadiness({...resultBase,resultBytes:bytes(r),decisionBytes:null});});
await test('stale proof cannot verify metadata-recomputed result','public-proof-recomputation',tuple('RESULT_MISMATCH','VERIFICATION'),()=>{const x=load(),before=assessInWorker(x,false);envelope(x,'security',e=>e.metadata.runId='new-reviewed-run');const after=dec(assessInWorker(x,false).resultBytes);assert.equal(after.readinessDigest,before.readinessDigest);after.proofBindingDigest=before.proofBindingDigest;return verifyReadiness({...x,resultBytes:bytes(after),decisionBytes:null});});
await test('public independent calls and input object insertion order yield identical bytes','public-determinism',accept,async()=>{const a=await evaluateReadiness(load()),source=load(),reordered=Object.fromEntries(Object.entries(source).reverse()),b=await evaluateReadiness(reordered);assert.deepEqual(a,b);await verifyReadiness({...source,resultBytes:b.resultBytes,decisionBytes:null});return {resultBytes:a.resultBytes.length,resultSha256:hash(a.resultBytes),readinessDigest:a.readinessDigest,proofBindingDigest:a.proofBindingDigest};});
const sourcePaths=['docs/mo1307-contract-freeze-1.md','docs/mo1307-phase1-foundation.md','docs/mo1307-phase2a-readiness-core.md','docs/mo1307-phase2b-evidence-graph.md','docs/mo1307-phase2c-publication-inspection-correction.md','docs/mo1307-phase2c-finalization-boundary-correction.md','docs/mo1307-phase2c-final.md','docs/mo1307-phase2d-integration.md',...fs.readdirSync(path.join(root,'repositories/memoryos-readiness/src')).filter(f=>f.endsWith('.mjs')).map(f=>'repositories/memoryos-readiness/src/'+f),'repositories/memoryos-readiness/schemas/shared-1.0.0.schema.json','repositories/cca-conformance/evidence/mo1307/phase2b/development/mo1306-source-lineage.json'];
fs.writeFileSync(path.join(out,'source-bindings.json'),JSON.stringify(sourcePaths.map(identity),null,2)+'\n');
save();console.log(JSON.stringify({cases:rows.length,passed:rows.filter(r=>r.pass).length,negative:rows.filter(r=>!r.expected.accepted).length,receipt:path.join(out,'receipt.json')}));
