// Independent follow-on checks, after primary corpus/source review; no prior suite imports.
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {Worker} from 'node:worker_threads';
import {createHash} from 'node:crypto';
import {createSupervisor,createSupervisorForTesting} from '../../../memoryos-readiness/src/runtime.mjs';
import {createHelperTransport} from '../../../memoryos-readiness/src/helper-transport.mjs';
import {encodeHelperRequest,decodeHelperRequest,decodeHelperResponse,createHelperSequence} from '../../../memoryos-readiness/src/helper-protocol.mjs';
import {ReadinessError,errorExit} from '../../../memoryos-readiness/src/errors.mjs';
const base=fileURLToPath(new URL('../../evidence/mo1307/phase3c-c3rb-cert2/runtime-boundary/',import.meta.url)),rows=[];
assert.equal(path.resolve(process.cwd()).toLowerCase(),'c:\\m7c2');
assert.equal(process.argv.length,2);
const selectedIds=["helper-request-frame-ceiling-plus-one","helper-response-frame-ceiling-plus-one","helper-session-shape-5","helper-session-shape-63","helper-session-shape-65","actual-worker-policy-node:fs","actual-worker-policy-node:child_process","actual-worker-policy-node:http","actual-worker-policy-node:https","actual-worker-policy-node:net","actual-worker-policy-node:dns","actual-worker-policy-fetch","actual-worker-policy-WebSocket","supervisor-helper-worker-overlap-refusal","worker-result-after-deadline-equality"];
const selectedControlIds=new Set(selectedIds);
const expectedControlOutcomes={"helper-request-frame-ceiling-plus-one":{"accepted":false,"code":"MO1307_RESOURCE_LIMIT","stage":"ACQUISITION","exit":28},"helper-response-frame-ceiling-plus-one":{"accepted":false,"code":"MO1307_RESOURCE_LIMIT","stage":"ACQUISITION","exit":28},"helper-session-shape-5":{"accepted":false,"code":"MO1307_INPUT","stage":"ACQUISITION","exit":12},"helper-session-shape-63":{"accepted":false,"code":"MO1307_INPUT","stage":"ACQUISITION","exit":12},"helper-session-shape-65":{"accepted":false,"code":"MO1307_INPUT","stage":"ACQUISITION","exit":12},"actual-worker-policy-node:fs":{"accepted":true,"denied":true,"exit":0},"actual-worker-policy-node:child_process":{"accepted":true,"denied":true,"exit":0},"actual-worker-policy-node:http":{"accepted":true,"denied":true,"exit":0},"actual-worker-policy-node:https":{"accepted":true,"denied":true,"exit":0},"actual-worker-policy-node:net":{"accepted":true,"denied":true,"exit":0},"actual-worker-policy-node:dns":{"accepted":true,"denied":true,"exit":0},"actual-worker-policy-fetch":{"accepted":true,"denied":true,"exit":0},"actual-worker-policy-WebSocket":{"accepted":true,"denied":true,"exit":0},"supervisor-helper-worker-overlap-refusal":{"accepted":true,"secondError":"MO1307_INTERNAL","firstError":"MO1307_INTERNAL","helpers":1,"workers":0},"worker-result-after-deadline-equality":{"accepted":false,"code":"MO1307_TIMEOUT","stage":"EVALUATION","exit":29}};
await fs.mkdir(base,{recursive:true});
const save=()=>fs.writeFile(path.join(base,'fresh-supplement.json'),JSON.stringify({kind:'MO1307Phase3CRuntimeSupplement',candidate:'defe93989efc6501b1a730b82e79e705884b269b',rows,remaining:selectedIds.filter(id=>!rows.some(r=>r.id===id)),result:rows.some(x=>x.result==='FAIL')?'FAIL':'PASS'},null,2)+'\n');
async function check(id,expected,fn){if(!selectedControlIds.has(id))return;assert.deepEqual(expected,expectedControlOutcomes[id],'Frozen expected outcome changed: '+id);assert.equal(rows.some(r=>r.id===id),false,'Duplicate primary control: '+id);let actual;try{actual=await fn();}catch(e){actual={accepted:false,code:e.code,stage:e.stage,exit:e instanceof ReadinessError?errorExit(e):null};}const pass=Object.entries(expected).every(([k,v])=>JSON.stringify(actual[k])===JSON.stringify(v));rows.push({id,expected,actual,result:pass?'PASS':'FAIL',noPublication:true});await save();if(!pass)throw new Error(id);}
await check('helper-request-frame-ceiling-plus-one',{accepted:false,code:'MO1307_RESOURCE_LIMIT',stage:'ACQUISITION',exit:28},()=>{decodeHelperRequest(new Uint8Array(65537));return {accepted:true};});
await check('helper-response-frame-ceiling-plus-one',{accepted:false,code:'MO1307_RESOURCE_LIMIT',stage:'ACQUISITION',exit:28},()=>{decodeHelperResponse(new Uint8Array(16777217),{});return {accepted:true};});
for(const value of ['wrong','1'.repeat(63),'1'.repeat(65)])await check('helper-session-shape-'+value.length,{accepted:false,code:'MO1307_INPUT',stage:'ACQUISITION',exit:12},()=>{createHelperSequence('evaluate',{session:value});return {accepted:true};});
await check('actual-fixed-transport-poisoned-parent',{accepted:true,exitConfirmed:true,helpers:1,workers:0,quiescent:true},async()=>{const s=createSupervisor({kind:'cli'}),prior=process.env.HTTPS_PROXY;process.env.HTTPS_PROXY='MO1307_3C_SENTINEL_NOT_A_REAL_SECRET';try{const root=path.join(base,'run-2','native');const req={kind:'MemoryOSReadinessHelperRequest',version:'2.0.0',session:'b'.repeat(64),sequence:3,operation:'READ_SET',roots:[{id:'input',path:root}],files:[{id:'evidence',path:'isolated.data',maxBytes:128,root:'input'}]};const reply=await createHelperTransport(s).exchange(encodeHelperRequest(req));const r=decodeHelperResponse(reply.responseBytes,req);assert.equal(r.status,'OK');const snap=s.snapshot();return {accepted:true,exitConfirmed:reply.exitConfirmed,helpers:snap.helpers,workers:snap.workers,quiescent:snap.cleanupConfirmed,events:snap.events};}finally{if(prior===undefined)delete process.env.HTTPS_PROXY;else process.env.HTTPS_PROXY=prior;await s.dispose();}});
const policy=new URL('../../../memoryos-readiness/src/worker-policy.mjs',import.meta.url).href;
async function forbidden(kind){const code=`const {parentPort}=require('node:worker_threads'); (async()=>{const {installWorkerPolicy}=await import(${JSON.stringify(policy)});installWorkerPolicy();try{${kind.startsWith('node:')?`await import(${JSON.stringify(kind)})`:`globalThis[${JSON.stringify(kind)}]('https://invalid.example')`};parentPort.postMessage({denied:false});}catch(e){parentPort.postMessage({denied:true,message:e.message});}})();`;return new Promise((resolve,reject)=>{const w=new Worker(code,{eval:true,env:{},execArgv:[],stdout:true,stderr:true});let value;w.on('message',x=>value=x);w.on('error',reject);w.on('exit',exit=>{try{assert.equal(exit,0);assert.equal(value.denied,true);assert.equal(value.message,'MO1307_INTERNAL');resolve({accepted:true,denied:true,exit});}catch(e){reject(e);}});});}
for(const name of ['node:fs','node:child_process','node:http','node:https','node:net','node:dns','fetch','WebSocket'])await check('actual-worker-policy-'+name,{accepted:true,denied:true,exit:0},()=>forbidden(name));
await check('supervisor-helper-worker-overlap-refusal',{accepted:true,secondError:'MO1307_INTERNAL',firstError:'MO1307_INTERNAL',helpers:1,workers:0},async()=>{const s=createSupervisor({kind:'cli'});let closed;const never=new Promise(()=>{}),closedPromise=new Promise(resolve=>closed=resolve);const first=s.runOwned('helper',()=>({completion:never,closed:closedPromise,terminate:closed})).then(()=>null,e=>e.code);let secondError;try{await s.runOwned('worker',()=>{throw new Error('must not launch');});}catch(e){secondError=e.code;}const firstError=await first,snapshot=s.snapshot();await s.dispose();return {accepted:true,secondError,firstError,helpers:snapshot.helpers,workers:snapshot.workers};});
await check('worker-result-after-deadline-equality',{accepted:false,code:'MO1307_TIMEOUT',stage:'EVALUATION',exit:29},async()=>{let now=0;const s=createSupervisorForTesting({kind:'api',now:()=>now});try{await s.runOwned('worker',lease=>{now=10000;lease.checkpoint();return {};});return {accepted:true};}finally{await s.dispose();}});
assert.equal(rows.length,15);assert.deepEqual(rows.map(r=>r.id),selectedIds);console.log(JSON.stringify({count:rows.length,result:'PASS'}));
