// Direct consumer-side protocol controls bound to fresh unmodified native output.
import fs from 'node:fs';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
import {canonicalBytes} from '../../../memoryos-readiness/src/canonical.mjs';
import {decodeHelperRequest,decodeHelperResponse,createHelperSequence} from '../../../memoryos-readiness/src/helper-protocol.mjs';
const ev='repositories/cca-conformance/evidence/mo1307/phase3c-refresh',base=ev+'/equivalence/attempt2/ordinary';
const hash=b=>'sha256:'+createHash('sha256').update(b).digest('hex'),pin=p=>{const b=fs.readFileSync(p);return{path:p,byteLength:b.length,sha256:hash(b)}};
const raw=fs.readFileSync(base+'/candidate.stdout.bin'),q=decodeHelperRequest(fs.readFileSync(base+'/request.bin')),body=JSON.parse(raw.subarray(4));
const frame=v=>{const b=canonicalBytes(v),h=Buffer.alloc(4);h.writeUInt32BE(b.length);return Buffer.concat([h,b])};const rows=[];
function reject(name,fn){let caught;try{fn()}catch(e){caught=e}assert.ok(caught,name+' must reject');assert.equal(caught.code,'MO1307_INPUT',name);rows.push({id:name,scope:'CURRENT_JS_CONSUMER_OF_FRESH_NATIVE_FRAME',negative:true,code:caught.code,result:'PASS'});}
for(const [name,mutate] of [
 ['response-wrong-version',b=>b.version='1.0.0'],['response-wrong-session',b=>b.session='c'.repeat(64)],['response-wrong-sequence',b=>b.sequence=2],['response-wrong-operation',b=>b.operation='CHECK_OUTPUT'],['response-unknown-field',b=>b.script='C3R_SECRET_SENTINEL'],['response-malformed-base64',b=>b.files[0].bytes=['%%%']],['response-noncanonical-base64',b=>b.files[0].bytes=[b.files[0].bytes.join('').replace(/=$/,'')]]]){const b=structuredClone(body);mutate(b);reject(name,()=>decodeHelperResponse(frame(b),q));}
for(const [name,b] of [['response-truncated-frame',raw.subarray(0,raw.length-1)],['response-extra-frame',Buffer.concat([raw,raw])],['response-trailing-bytes',Buffer.concat([raw,Buffer.from('x')])]])reject(name,()=>decodeHelperResponse(b,q));
const other=JSON.parse(JSON.stringify(q));other.session='d'.repeat(64);reject('cross-session-response-replay',()=>decodeHelperResponse(raw,other));
reject('sequence-entry-bypass',()=>createHelperSequence('evaluate',{session:q.session}).begin(q));
const original=decodeHelperResponse(raw,q);assert.equal(original.status,'OK');rows.push({id:'native-frame-control',scope:'CURRENT_JS_CONSUMER_OF_FRESH_NATIVE_FRAME',negative:false,result:'PASS'});
fs.writeFileSync(ev+'/protocol-subset.json',JSON.stringify({kind:'MO1307Phase3CRefreshConsumerProtocol',result:'PASS',sources:[pin('repositories/cca-conformance/tools/mo1307-phase3c-refresh/protocol.mjs'),pin('repositories/memoryos-readiness/src/helper-protocol.mjs'),pin('repositories/memoryos-readiness/src/canonical.mjs'),pin(base+'/request.bin'),pin(base+'/candidate.stdout.bin')],rows,count:rows.length,negativeCount:rows.filter(r=>r.negative).length,scope:'Native malformed requests are separately exercised in the equivalence campaign. Cross-session ownership is enforced by the JS consumer/sequence; each one-shot helper echoes a syntactically valid session and does not own cross-process session history.'},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({result:'PASS',count:rows.length}));
